<Project Sdk="Microsoft.NET.Sdk">
  <!-- V3 part 2 Vita pack baker (vita/notes/v3b-pack.md). Compiles the engine's Shepherd.Assets SOURCES into this assembly
       (own obj/bin, no ProjectReference), so baking never writes into the engine's build outputs and never races a concurrent
       engine build; the pack reader/format code is the same source the engine uses. Output = derived game data: it is
       written only under runtime/vitapack/ (gitignored). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>Shepherd.VitaPack</RootNamespace>
    <NoWarn>$(NoWarn);CS8632</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../engine/Shepherd.Assets/Shepherd.Assets/**/*.cs" Exclude="../../engine/Shepherd.Assets/Shepherd.Assets/obj/**;../../engine/Shepherd.Assets/Shepherd.Assets/bin/**" LinkBase="Assets" />
    <!-- the FMOD bank key reader (in memory only): the baker blanks the key in FMODUnity.Settings and KeyScan proves no output holds it -->
    <Compile Include="../FmodBake/GameKey.cs" Link="FmodBake/GameKey.cs" />
  </ItemGroup>
</Project>
