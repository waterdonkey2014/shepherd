<Project Sdk="Microsoft.NET.Sdk">
  <!-- Read-only content inventory / Vita "diet" sizing over the CotL data.
       References a COPY of Shepherd.Assets.dll in ./lib (not a ProjectReference: the engine may be rebuilt concurrently). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Shepherd.Assets">
      <HintPath>lib/Shepherd.Assets.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
