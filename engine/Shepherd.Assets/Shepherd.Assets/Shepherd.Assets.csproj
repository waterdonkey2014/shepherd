<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Shepherd.Assets</RootNamespace>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <!-- kit #7 tests track: the eboot build (vita/shepherd/build.sh -p:ShepherdEboot=1, a global property that reaches this project too)
       leaves out the Mac-only test hooks (Sched.cs; VitaPack's read-ahead uses the plain primitives) as Shepherd.Engine does. -->
  <PropertyGroup Condition="'$(ShepherdEboot)' == '1'">
    <DefineConstants>$(DefineConstants);SHEPHERD_EBOOT</DefineConstants>
  </PropertyGroup>
  <!-- device kit #8 boot track: -p:ShepherdK8=0 (a global property, as ShepherdEboot) leaves out VitaPack's preload hooks (Shepherd.Engine's
       Runtime/K8Preload.cs) as Shepherd.Engine does. -->
  <PropertyGroup Condition="'$(ShepherdK8)' == '0'">
    <DefineConstants>$(DefineConstants);SHEPHERD_NO_K8</DefineConstants>
  </PropertyGroup>
  <!-- device kit #11 walk track: -p:ShepherdK11Records=0 (a global property, as ShepherdEboot) = kit #10's ObjectInfo layout (SHEPHERD_K10_RECORDS)
       as Shepherd.Engine's records. -->
  <PropertyGroup Condition="'$(ShepherdK11Records)' == '0'">
    <DefineConstants>$(DefineConstants);SHEPHERD_K10_RECORDS</DefineConstants>
  </PropertyGroup>
  <!-- device kit #12 walkb (review fix): -p:ShepherdK12TocCode=0 (a global property, as ShepherdEboot; vita/shepherd/build.sh
       SHEPHERD_K12_TOC_CODE=0) = kit #11's index entries (compile symbol SHEPHERD_K11_TOC: ObjectInfo a class, one object per entry) as
       Shepherd.Engine's callers: kit #11's eboot span. An eboot switch: the Mac tools and tests compile the view only. -->
  <PropertyGroup Condition="'$(ShepherdK12TocCode)' == '0'">
    <DefineConstants>$(DefineConstants);SHEPHERD_K11_TOC</DefineConstants>
  </PropertyGroup>
</Project>
