<Project Sdk="Microsoft.NET.Sdk">
  <!-- SHEPHERD-VITA V5 hello world. Built as a plain IL assembly; the Vita build AOTs it (static, full+interp)
       with mono-aot-cross and runs it on the forked .NET 8 Mono runtime. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Hello</AssemblyName>
    <RootNamespace>ShepherdVita</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseAppHost>false</UseAppHost>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Hello.cs" />
    <ProjectReference Include="HelloInterp/HelloInterp.csproj" />
  </ItemGroup>
</Project>
