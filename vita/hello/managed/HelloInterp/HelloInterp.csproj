<Project Sdk="Microsoft.NET.Sdk">
  <!-- SHEPHERD-VITA V5: deliberately NOT AOT-compiled. Every method here runs in the Mono interpreter, calling into
       AOT-compiled CoreLib and back (delegates, generics, exceptions), which is the interp+AOT mix Shepherd will use. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>HelloInterp</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
  </PropertyGroup>
</Project>
