{
  "comment": "Synthetic fixture set (vita/audio/build/fixtures/manifest.json, made by sa_test). Exercises loops, a parameter switch, 3D motion, a snapshot, buses, fades and STOPPED.",
  "durationMs": 6000, "updateHz": 60, "block": 256, "seed": 7, "float": false,
  "calls": [
    {"t": 0,    "op": "listener", "pos": [0,0,0], "forward": [0,0,1], "up": [0,1,0]},
    {"t": 0,    "op": "create", "event": "event:/test/aac_music", "id": "music"},
    {"t": 0,    "op": "start", "id": "music"},
    {"t": 0,    "op": "create", "event": "event:/test/param", "id": "pad"},
    {"t": 0,    "op": "set_volume", "id": "pad", "value": 0.5},
    {"t": 0,    "op": "start", "id": "pad"},
    {"t": 20,   "op": "expect_state", "id": "pad", "state": "PLAYING"},
    {"t": 500,  "op": "play", "event": "event:/test/short100", "id": "click1"},
    {"t": 1000, "op": "set_param", "id": "pad", "name": "x", "value": 1},
    {"t": 1200, "op": "create", "event": "event:/test/3d", "id": "src3d"},
    {"t": 1200, "op": "set_3d", "id": "src3d", "pos": [-8,0,2]},
    {"t": 1200, "op": "start", "id": "src3d"},
    {"t": 1600, "op": "set_3d", "id": "src3d", "pos": [0,0,3]},
    {"t": 2000, "op": "set_3d", "id": "src3d", "pos": [8,0,2]},
    {"t": 2500, "op": "snapshot_start", "path": "snapshot:/test/duck", "id": "duck"},
    {"t": 3500, "op": "snapshot_stop", "id": "duck", "fade": true},
    {"t": 3300, "op": "expect_state", "id": "src3d", "state": "STOPPED"},
    {"t": 3600, "op": "bus_volume", "bus": "bus:/Music", "value": 0.5},
    {"t": 4000, "op": "play", "event": "event:/test/variations", "id": "v1"},
    {"t": 4300, "op": "play", "event": "event:/test/variations", "id": "v2"},
    {"t": 4500, "op": "stop", "id": "pad", "fade": true},
    {"t": 4520, "op": "expect_state", "id": "pad", "state": "STOPPING"},
    {"t": 4700, "op": "expect_state", "id": "pad", "state": "STOPPED"},
    {"t": 5000, "op": "stop", "id": "music", "fade": true},
    {"t": 5200, "op": "expect_state", "id": "music", "state": "STOPPED"},
    {"t": 5300, "op": "release", "id": "pad"},
    {"t": 5300, "op": "release", "id": "music"},
    {"t": 5300, "op": "release", "id": "src3d"},
    {"t": 5900, "op": "mark", "label": "end"}
  ]
}
