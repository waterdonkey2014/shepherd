+/* SHEPHERD-VITA DIAG (devfail1, 2026-10-07): diagnostic hooks for the PS Vita runtime. DIAG-ONLY.
+ *
+ * Every hook sits at the START of an existing source line (exception.c, exceptions-arm.c, mono-threads.c), and this header is
+ * pulled in from the end of mono-compiler.h, so no line moves: __LINE__ in every assert message stays what it is upstream.
+ * Without SHEPHERD_VITA_DIAG every hook expands to NOTHING and the objects are byte-for-byte the normal ones (proved by
+ * vita/toolchain/build-runtime-diag.sh --prove). With it, the hooks call vita/... mono/mini/shepherd-vita-diag.c, which logs
+ * through the host's shepherd_vita_native_log ("N> " lines in the app's log):
+ *   EXC ...       every runtime-created exception (from_token / by name), its nesting depth and the managed throw site
+ *   EXC-FAIL ...  a creation step that failed (1 class-get, 2 object-new, 3 object-init), the full MonoError, the inner
+ *                 exception (type, message, its trace) and the managed stack from the throw site -- then the original assert
+ *   SEMCHECK ...  the coop stop-the-world handshake left extra counts in suspend_semaphore (posts vs waits)
+ *   SUSPEND-STATE the "Cannot read suspend state" fatal: the handshake counters and every thread's state, before the g_error
+ */
+#ifndef __SHEPHERD_VITA_DIAG_H__
+#define __SHEPHERD_VITA_DIAG_H__
+
+#ifdef SHEPHERD_VITA_DIAG
+void shepherd_vita_diag_exc_begin (const char *where, void *image, unsigned token, const char *name_space, const char *name);
+void shepherd_vita_diag_exc_fail (const char *where, int step, void *image, unsigned token, void *klass, void *error);
+void shepherd_vita_diag_exc_end (void);
+void shepherd_vita_diag_throw_ctx (unsigned long pc, unsigned long sp, void *int_regs, void *fp_regs);
+void shepherd_vita_diag_sem_check (void *sem, int waited, int suspend_posts, int resume_posts, int abort_posts, int waits_done);
+void shepherd_vita_diag_suspend_state (void *info, int cur_state, void *sem, int suspend_posts, int resume_posts, int abort_posts, int waits_done, int pending);
+#define SHP_DIAG_EXC_BEGIN(w, i, t, ns, n) shepherd_vita_diag_exc_begin ((w), (void *) (i), (unsigned) (t), (ns), (n));
+#define SHP_DIAG_EXC_CHECK(w, s, i, t, k, e) do { if (!is_ok (e)) shepherd_vita_diag_exc_fail ((w), (s), (void *) (i), (unsigned) (t), (void *) (k), (void *) (e)); } while (0);
+#define SHP_DIAG_EXC_END() shepherd_vita_diag_exc_end ();
+#define SHP_DIAG_THROW_CTX(pc, sp, r, f) shepherd_vita_diag_throw_ctx ((unsigned long) (pc), (unsigned long) (sp), (void *) (r), (void *) (f));
+#define SHP_DIAG_SEM_CHECK(sem, n, sp, rp, ap, wd) shepherd_vita_diag_sem_check ((void *) (sem), (int) (n), (sp), (rp), (ap), (wd));
+#define SHP_DIAG_SUSPEND_STATE(info, st, sem, sp, rp, ap, wd, pend) shepherd_vita_diag_suspend_state ((void *) (info), (st), (void *) (sem), (sp), (rp), (ap), (wd), (int) (pend));
+#else
+#define SHP_DIAG_EXC_BEGIN(w, i, t, ns, n)
+#define SHP_DIAG_EXC_CHECK(w, s, i, t, k, e)
+#define SHP_DIAG_EXC_END()
+#define SHP_DIAG_THROW_CTX(pc, sp, r, f)
+#define SHP_DIAG_SEM_CHECK(sem, n, sp, rp, ap, wd)
+#define SHP_DIAG_SUSPEND_STATE(info, st, sem, sp, rp, ap, wd, pend)
+#endif
+
+#endif /* __SHEPHERD_VITA_DIAG_H__ */
