+/*
+ * SHEPHERD-VITA device kit #9, track runtime, row R1 "fast TLS" (vita/patches/k9-fast-tls.patch, vita/notes/kit9-runtime.md).
+ * vitasdk's pthread_getspecific is pthread-embedded's pte_osTlsGetValue: newlib's __getreent_for_thread (8 registers + d8 pushed, a
+ * 136-byte frame, sceKernelGetTLSAddr (0x89)) and then a walk of the thread's key list -- hundreds of instructions for every read of
+ * the runtime's thread-local values (the LMF, the thread info, the domain, the JIT TLS, the interpreter context, the small id ...).
+ * Here every runtime key is ALSO mirrored in one of the Vita's own per-thread TLS slots (sceKernelGetTLSAddr (slot): a word per slot
+ * per thread, zero in a new thread -- newlib's reent slot 0x89 relies on the same), so a read is one import call + one load:
+ *   - a key keeps its pthread key: pthread_setspecific is still done on every set, so the destructors run exactly as before (each
+ *     destructor is entered through a wrapper that clears the slot first, as pthread-embedded clears its own value), and the pthread
+ *     value stays the store of record;
+ *   - a read takes the slot (the same value: every set writes both, and both start NULL in every thread).
+ * SHEPHERD_FAST_TLS (env file, read at the first key): unset / 1 / on = the slots; 0 / off = pthread_getspecific for every read (kit
+ * #8's runtime path); check = the slots AND pthread_getspecific on every read, compared (a mismatch is counted, logged once, and the
+ * pthread value is returned; the slots ARE written, so this checks the runtime's own mirror, not a foreign writer); probe = kit #8's
+ * path (pthread_getspecific for every read) and the claimed slots are NEVER written: every read also loads its slot and counts a
+ * non-NULL value -- someone else's (a system module keeping per-thread state there) -- without disturbing it (the device test for the
+ * slots, review fix). Any other value = off (fail-safe; the host's H8 line says so). The slots are claimed from
+ * MONO_VITA_TLS_SLOT_FIRST on: only slots that read NULL on the claiming thread AND that the host did not find in use on its main thread
+ * (mono_shepherd_fast_tls_avoid, set before the first key); a key with no free slot keeps the pthread path.
+ */
+#include <pthread.h>
+
+typedef struct {
+	pthread_key_t key;   /* pthread-embedded's key */
+	int sidx;            /* 1 + the sceKernelGetTLSAddr slot mirroring this key; 0 = none (pthread_getspecific): also an unallocated key */
+	int check;           /* 0 = the slot is the value; 1 = SHEPHERD_FAST_TLS=check: every read compares the slot with pthread_getspecific;
+	                        2 = probe: the slot is never written, every read counts a non-NULL value in it (someone else's) */
+} MonoVitaNativeTlsKey;
+#define MonoNativeTlsKey MonoVitaNativeTlsKey
+#define MONO_VITA_TLS_SLOT_FIRST 0x8a   /* right after newlib's reent slot 0x89 */
+#define MONO_VITA_TLS_SLOTS 16
+
+void *sceKernelGetTLSAddr (int key);
+int mono_vita_native_tls_alloc (MonoVitaNativeTlsKey *key, void *destructor);
+void mono_vita_native_tls_free (MonoVitaNativeTlsKey *key);
+void *mono_vita_native_tls_get_checked (MonoVitaNativeTlsKey key);
+
+MONO_INLINE void*
+mono_native_tls_get_value (MonoVitaNativeTlsKey key)
+{
+	if (G_LIKELY (key.sidx != 0 && !key.check))
+		return *(void **) sceKernelGetTLSAddr (key.sidx - 1);
+	return mono_vita_native_tls_get_checked (key);
 }
 
+MONO_INLINE int
+mono_native_tls_alloc (MonoNativeTlsKey *key, void *destructor)
+{
+	return mono_vita_native_tls_alloc (key, destructor);
+}
+
+MONO_INLINE void
+mono_native_tls_free (MonoNativeTlsKey key)
+{
+	mono_vita_native_tls_free (&key);
+}
+
+MONO_INLINE int
+mono_native_tls_set_value (MonoNativeTlsKey key, gpointer value)
+{
+	int res = !pthread_setspecific (key.key, value);
+	if (key.sidx != 0 && key.check != 2)   /* (probe: never written) */
+		*(void **) sceKernelGetTLSAddr (key.sidx - 1) = value;
+	return res;
+}
+
 #else
 
 #include <pthread.h>
