+/* SHEPHERD kit #9 (vita/notes/kit9-jit.md, JIT helper 4: calls from a trace into AOT code): MINT_JIT_CALL's body, for the baseline JIT
+ * tier -- a trace (and the recording walker) calls this instead of leaving at the call. It is the interpreter's own handler line for line
+ * (the same frame->state.ip, the same do_jit_call, the same error conversion and throw); only the jump to `resume` cannot happen here:
+ * it returns 1 when the interpreter must CHECK_RESUME_STATE (an exception / resume state after the call), and the trace then leaves with
+ * an odd result at the next instruction, where MINT_SJ_ENTER does exactly that. 0 = the call returned normally: the trace goes on. */
+int
+mono_shepjit_interp_jit_call (InterpFrame *frame, ThreadContext *context, const guint16 *ip, guchar *locals);
+int
+mono_shepjit_interp_jit_call (InterpFrame *frame, ThreadContext *context, const guint16 *ip, guchar *locals)
+{
+	ERROR_DECL (error);
+	InterpMethod *rmethod = (InterpMethod*)frame->imethod->data_items [ip [3]];
+	/* for calls, have ip pointing at the start of next instruction */
+	frame->state.ip = ip + 4;
+	do_jit_call (context, (stackval*)(locals + ip [1]), (stackval*)(locals + ip [2]), frame, rmethod, error);
+	if (!is_ok (error)) {
+		MonoException *call_ex = interp_error_convert_to_exception (frame, error, ip);
+		interp_throw_ex_general (call_ex, context, frame, ip, FALSE);   /* = THROW_EX (call_ex, ip) without its goto resume */
+		return 1;
+	}
+	return context->has_resume_state ? 1 : 0;
+}
