+/* ------------------------------------------------------------------ kit #9's compiler
+ * The PLAN: every instruction from the entry point on, in layout order, gets what the trace does there --
+ *   CODE  a stencil (as kit #8);  CALL  MINT_JIT_CALL through the interpreter's handler body (the call sequence below);
+ *   INTR  MINT_JIT_CALL as its callee's trivial getter (a stencil with the call's slots);
+ *   EXIT  an instruction the trace does not compile that the recorded runs DID reach: the trace leaves there (an exit stub; with a record
+ *         the trace goes on compiling the reached instructions after it -- they are reached by branches around it);
+ *   TRAP  an instruction the recorded runs never reached: a trap stub (the same exit, with an odd result: counted by the slow exit);
+ *   MARK  another entry point: transparent (the disposition of the next instruction).
+ * Without a record (SHEPHERD_JIT_RECORD=0) the plan ends at the first EXIT, like kit #8's trace. The EMISSION lays the CODE / CALL / INTR
+ * instructions out in order (a stencil that falls through to an instruction that is not laid out next gets a B.W), the stubs after them.
+ * A trace with a CALL is FRAMED: its prologue pushes frame, locals and context (and lr), every exit pops them; the call sequence reloads
+ * them from the stack:  ldr r0,[sp] / ldr r1,[sp,#8] / movw+movt r2,=ip / ldr r3,[sp,#4] / bl <veneer: the helper> / cmp r0,#0 /
+ * bne.w <odd exit at the next instruction> / ldr r0,[sp,#4]  (26 bytes). */
+#define SJ_C_RECORD 1      /* compiled from a record (traps possible) */
+#define SJ_C_FRAMED 2      /* has calls: the framed prologue / exits */
+#define SJ_C_K9 4          /* kit #9's compiler */
+#define SJ_C_INTR_EVER 8   /* (review 2) some compile of this trace held a getter intrinsic -- sticky (never cleared: a recompile staged or
+                            * discarded cannot hide it): lockstep then registers its frame copy as a GC root (sj_lockstep) */
+
+static int
+sj_emit_exit9 (guint8 *buf, int off, ptrdiff_t disp, gboolean framed)
+{
+	guint32 d = (guint32) disp;
+	wr16 (buf + off, 0xf240); wr16 (buf + off + 2, 0x0000); sj_put_imm16 (buf + off, d & 0xffff); off += 4;          /* movw r0, #lo */
+	if (d >> 16) { wr16 (buf + off, 0xf2c0); wr16 (buf + off + 2, 0x0000); sj_put_imm16 (buf + off, d >> 16); off += 4; }   /* movt r0, #hi */
+	wr16 (buf + off, framed ? 0xbd0e : 0x4770); off += 2;                                                               /* pop {r1, r2, r3, pc} / bx lr */
+	return off;
+}
+
+static inline gboolean
+sj_seen_bit (const SjTrace *t, guint32 s)
+{
+	return s < t->x->seen_span && (t->x->seen [s >> 3] >> (s & 7)) & 1;
+}
+
+static int
+sj_plan_find (SjPlan *plan, int n, const guint16 *ip)
+{
+	int lo = 0, hi = n - 1;
+	while (lo <= hi) {
+		int mid = (lo + hi) / 2;
+		if (plan [mid].ip == ip) return mid;
+		if (plan [mid].ip < ip) lo = mid + 1; else hi = mid - 1;
+	}
+	return -1;
+}
+
+/* the holes of one stencil copied to buf + off, for the instruction v (an IR instruction, or a synthesized one for an intrinsic: its
+ * data-item slots then index items); its continuations go to succ, its exits to own */
+static gboolean
+sj_patch (guint8 *buf, int off, const SjStencil *st, const guint16 *v, gpointer const *items, int op, const guint16 *own, const guint16 *succ,
+	  SjFix *fix, int *nfix)
+{
+	for (int h = 0; h < st->nholes; h++) {
+		const SjHole *ho = &st->holes [h];
+		guint8 *p = buf + off + ho->off;
+		switch (ho->kind) {
+		case SJH_A16: sj_put_imm16 (p, v [ho->arg]); break;
+		case SJH_W32_LO: sj_put_imm16 (p, (guint32) READ32 (v + ho->arg) & 0xffff); break;
+		case SJH_W32_HI: sj_put_imm16 (p, (guint32) READ32 (v + ho->arg) >> 16); break;
+		case SJH_DATA_LO: sj_put_imm16 (p, (guint32) (gsize) items [v [ho->arg]] & 0xffff); break;
+		case SJH_DATA_HI: sj_put_imm16 (p, (guint32) (gsize) items [v [ho->arg]] >> 16); break;
+		case SJH_HELPER_LO: sj_put_imm16 (p, (guint32) (gsize) sj_helper_addr [ho->arg] & 0xffff); break;
+		case SJH_HELPER_HI: sj_put_imm16 (p, (guint32) (gsize) sj_helper_addr [ho->arg] >> 16); break;
+		case SJH_CONT: case SJH_TAKEN: case SJH_EXIT: {
+			if (*nfix >= SJ_W_FIX)
+				return FALSE;
+			SjFix *f = &fix [(*nfix)++];
+			f->off = (guint32) (off + ho->off); f->kind = ho->kind; f->cond = ho->arg; f->op = 0;
+			if (ho->kind == SJH_EXIT)
+				f->target = own;
+			else if (ho->kind == SJH_CONT)
+				f->target = succ;
+			else {
+				int len = mono_interp_oplen [op];
+				MintOpArgType at = mono_interp_opargtype [op];
+				f->target = (at == MintOpShortBranch || at == MintOpShortAndShortBranch) ? own + (gint16) v [len - 1] : own + (gint32) READ32 (v + len - 2);
+			}
+			break;
+		}
+		}
+	}
+	return TRUE;
+}
+
+static int
+sj_compile9 (SjTrace *t, guint8 *buf, int cap, gsize addr)
+{
+	SjPlan *plan = sj_w_plan;
+	SjIntrinsic *intr = sj_w_intr;
+	SjFix *fix = sj_w_fix;
+	SjMap *stubs = sj_w_stubs;
+	InterpMethod *im = t->imethod;
+	const guint16 *code_end = (const guint16 *) ((guint8 *) im->jinfo->code_start + im->jinfo->code_size);
+	gboolean rec = t->x->seen != NULL;
+	guint32 max_seen = 0;
+	if (rec)
+		for (guint32 s = 0; s < t->x->seen_span; s++)
+			if (sj_seen_bit (t, s))
+				max_seen = s;
+	/* ---- the plan */
+	int np = 0, nemit = 0, ncall = 0, nintr = 0;
+	const guint16 *ip = t->ip + 3;
+	int first_exit_op = -1;
+	const guint16 *first_exit_ip = NULL;
+	while (ip < code_end && np < SJ_W_MAP - 4) {
+		guint32 s = (guint32) (ip - t->ip);
+		if (rec && s > max_seen)
+			break;
+		int op = *ip;
+		if (op < 0 || op >= MINT_LASTOP)
+			break;
+		SjPlan *p = &plan [np];
+		p->ip = ip; p->op = (guint16) op; p->off = 0; p->odd = 0;
+		gboolean reached = !rec || sj_seen_bit (t, s);
+		if (sj_marker (op)) {
+			p->disp = SJD_MARK;
+		} else if (!reached) {
+			p->disp = SJD_TRAP;
+		} else if (nemit >= sj_max_ops) {
+			break;   /* (the rest is outside the trace: exits) */
+		} else if (sj_compiles (op)) {
+			p->disp = SJD_CODE; nemit++;
+		} else if (op == MINT_JIT_CALL && sj_k9 && sj_call_helper && (sj_calls || sj_intrinsics)) {
+			if (sj_getter_of (im, ip, &intr [np]) && sj_compiles (intr [np].op)) {
+				p->disp = SJD_INTR; nemit++; nintr++;
+			} else if (sj_calls && mono_shepjit_mode == 1) {
+				p->disp = SJD_CALL; nemit++; ncall++;
+			} else
+				p->disp = SJD_EXIT;
+		} else {
+			p->disp = SJD_EXIT;
+		}
+		if (p->disp == SJD_EXIT) {
+			if (first_exit_op < 0)
+				first_exit_op = op, first_exit_ip = ip;
+			if (!rec)
+				break;   /* a linear trace ends here (kit #8) */
+		}
+		int len = sj_oplen (ip);   /* (review fix: a switch's real length -- the plan went on past it, as past any other exit) */
+		if (len <= 0)
+			break;
+		np++;
+		ip += len;
+	}
+	const guint16 *end_ip = ip;   /* the first instruction not in the plan: outside the trace */
+	/* markers take the disposition of the next instruction (MARK as the last ones: they lead outside -> EXIT) */
+	for (int i = np - 1, next = -1; i >= 0; i--) {
+		if (plan [i].disp != SJD_MARK) { next = i; continue; }
+		plan [i].disp = next < 0 ? SJD_EXIT : (plan [next].disp == SJD_CALL || plan [next].disp == SJD_INTR || plan [next].disp == SJD_CODE) ? SJD_MARK : plan [next].disp;
+	}
+	t->abort_op = (guint16) (first_exit_op >= 0 ? first_exit_op : (end_ip < code_end ? *end_ip : MINT_LASTOP));
+	t->x->abort_slot = (guint16) MIN ((first_exit_op >= 0 ? first_exit_ip : end_ip) - t->ip, 0xffff);
+	if (t->abort_op < MINT_LASTOP)
+		sj_st.abort_hist [t->abort_op]++;
+	if (nemit < sj_min_ops) {
+		t->state = SJ_S_OFF_SHORT;
+		return 0;
+	}
+	gboolean framed = ncall > 0;
+	if (framed && sj_veneer_off == 0xffffffffu)
+		return t->state = SJ_S_OFF_SHORT, 0;   /* (no veneer island: cannot happen once the compiler thread runs) */
+	/* ---- the emission */
+	int nfix = 0, nstub = 0, off = 0, ntrap = 0;
+	if (framed) { wr16 (buf + off, 0xb50b); off += 2; }   /* push {r0, r1, r3, lr}: frame, locals, context, the return address */
+	wr16 (buf + off, 0x4608); off += 2;                   /* mov r0, r1: the stencils take the locals in r0 */
+	guint32 loop_off = (guint32) off;                     /* a back branch to the entry opcode lands here */
+	/* the prologue falls through to the first instruction after the entry opcode (a B.W when that one is not laid out: a trap / an exit) */
+	gboolean fall_pending = TRUE;                         /* the last laid-out code falls through to its successor */
+	const guint16 *fall_succ = t->ip + 3;
+	guint32 stencil_bytes = 0;
+	for (int i = 0; i < np; i++) {
+		SjPlan *p = &plan [i];
+		gboolean laid = p->disp == SJD_CODE || p->disp == SJD_CALL || p->disp == SJD_INTR;
+		if (p->disp == SJD_MARK) {
+			if (fall_pending && fall_succ == p->ip)
+				fall_succ = p->ip + 3;   /* (a marker before a laid-out instruction is nothing to run: fall on past it) */
+			continue;   /* (its offset: the next laid-out instruction's, below) */
+		}
+		if (fall_pending && (!laid || p->ip != fall_succ)) {
+			/* the previous instruction falls through to an instruction that is not laid out next: a B.W to wherever that leads */
+			if (nfix >= SJ_W_FIX || off + 4 > cap) return t->state = SJ_S_OFF_SHORT, 0;
+			wr16 (buf + off, 0xf000); wr16 (buf + off + 2, 0x9000);
+			SjFix *f = &fix [nfix++];
+			f->off = (guint32) off; f->kind = SJH_CONT; f->cond = 0; f->op = 0; f->target = fall_succ;
+			off += 4;
+		}
+		fall_pending = FALSE;
+		if (!laid)
+			continue;
+		const guint16 *succ = p->ip + mono_interp_oplen [p->op];
+		if (p->disp == SJD_CODE || p->disp == SJD_INTR) {
+			int op = p->disp == SJD_CODE ? p->op : intr [i].op;
+			const SjStencil *st = &sj_stencils [sj_stencil_of [op]];
+			if (off + st->len + 8 + 16 > cap) return t->state = SJ_S_OFF_SHORT, 0;
+			if (st->align4 && (off & 2)) { wr16 (buf + off, 0xbf00); off += 2; }   /* nop: its literal pool stays 4-aligned */
+			p->off = (guint32) off;
+			memcpy (buf + off, st->code, st->len);
+			gboolean ok;
+			if (p->disp == SJD_CODE)
+				ok = sj_patch (buf, off, st, p->ip, (gpointer const *) im->data_items, op, p->ip, succ, fix, &nfix);
+			else {
+				/* the getter as an instruction of its own: the call's return slot, its first argument ('this'), the field */
+				guint16 v [8] = { 0 };
+				gpointer items [2] = { intr [i].vtable, intr [i].addr };
+				v [0] = (guint16) op; v [1] = p->ip [1];
+				if (intr [i].kind == SJI_LDFLD) { v [2] = p->ip [2]; v [3] = intr [i].offset; }
+				else if (intr [i].kind == SJI_LDSFLD) { v [2] = 0; v [3] = 1; }
+				else { v [2] = (guint16) (guint32) intr [i].k; v [3] = (guint16) ((guint32) intr [i].k >> 16); }
+				ok = sj_patch (buf, off, st, v, items, op, p->ip, succ, fix, &nfix);
+			}
+			if (!ok) return t->state = SJ_S_OFF_SHORT, 0;
+			off += st->len;
+			stencil_bytes += st->len;
+			if (st->falls) { fall_pending = TRUE; fall_succ = succ; }
+		} else {
+			/* SJD_CALL: the call sequence (r0 = locals at every stencil boundary; [sp] frame, [sp+4] locals, [sp+8] context) */
+			if (off + 26 + 16 > cap || nfix + 2 > SJ_W_FIX) return t->state = SJ_S_OFF_SHORT, 0;
+			p->off = (guint32) off;
+			guint32 ipv = (guint32) (gsize) p->ip;
+			wr16 (buf + off, 0x9800); off += 2;                                                                     /* ldr r0, [sp] */
+			wr16 (buf + off, 0x9902); off += 2;                                                                     /* ldr r1, [sp, #8] */
+			wr16 (buf + off, 0xf240); wr16 (buf + off + 2, 0x0200); sj_put_imm16 (buf + off, ipv & 0xffff); off += 4;  /* movw r2, #lo(ip) */
+			wr16 (buf + off, 0xf2c0); wr16 (buf + off + 2, 0x0200); sj_put_imm16 (buf + off, ipv >> 16); off += 4;     /* movt r2, #hi(ip) */
+			wr16 (buf + off, 0x9b01); off += 2;                                                                     /* ldr r3, [sp, #4] */
+			if (!sj_put_bl (buf + off, addr + off, (gsize) sj_block + sj_veneer_off)) return t->state = SJ_S_OFF_SHORT, 0;   /* bl <helper veneer> */
+			off += 4;
+			wr16 (buf + off, 0x2800); off += 2;                                                                     /* cmp r0, #0 */
+			wr16 (buf + off, 0xf040); wr16 (buf + off + 2, 0x8000);                                                 /* bne.w <odd exit at succ> */
+			SjFix *f = &fix [nfix++];
+			f->off = (guint32) off; f->kind = SJH_EXIT; f->cond = 1; f->op = 1; f->target = succ;   /* (op 1: the odd exit of a call) */
+			off += 4;
+			wr16 (buf + off, 0x9801); off += 2;                                                                     /* ldr r0, [sp, #4] */
+			stencil_bytes += 26;
+			fall_pending = TRUE; fall_succ = succ;
+		}
+	}
+	/* markers: the offset of the next laid-out instruction */
+	for (int i = np - 1; i >= 0; i--)
+		if (plan [i].disp == SJD_MARK)
+			plan [i].off = i + 1 < np ? plan [i + 1].off : 0;
+	if (fall_pending) {
+		/* the last laid-out instruction falls through: the exit at its successor goes right here (as kit #8's abort exit) */
+		gboolean odd = FALSE;
+		int k = sj_plan_find (plan, np, fall_succ);
+		if (k >= 0 && plan [k].disp == SJD_TRAP)
+			odd = TRUE;
+		if (nstub >= SJ_W_MAP || off + 12 > cap) return t->state = SJ_S_OFF_SHORT, 0;
+		stubs [nstub].ip = (const guint16 *) ((gsize) fall_succ | (odd ? 1 : 0)); stubs [nstub++].off = (guint32) off;
+		off = sj_emit_exit9 (buf, off, (fall_succ - t->ip) * (ptrdiff_t) sizeof (guint16) | (odd ? 1 : 0), framed);
+		if (odd) ntrap++;
+	}
+	/* ---- the branches: in the trace, or to a stub (even = an exit, odd = a trap or a call's slow exit) */
+	SjTrap *traps = NULL;
+	for (int i = 0; i < nfix; i++) {
+		SjFix *f = &fix [i];
+		const guint16 *tip = f->target;
+		guint32 target_off = 0;
+		gboolean odd = FALSE, found = FALSE;
+		if (f->kind == SJH_EXIT) {
+			odd = f->op == 1;   /* a call's slow exit; else the instruction's own check: leave AT it (even) */
+		} else if (tip == t->ip) {
+			target_off = loop_off; found = TRUE;
+		} else {
+			int k = (tip >= t->ip && tip < end_ip) ? sj_plan_find (plan, np, tip) : -1;
+			if (k >= 0) {
+				int d = plan [k].disp;
+				if (d == SJD_CODE || d == SJD_CALL || d == SJD_INTR || d == SJD_MARK) { target_off = plan [k].off; found = TRUE; }
+				else odd = d == SJD_TRAP;
+			}
+		}
+		if (!found) {
+			const guint16 *key = (const guint16 *) ((gsize) tip | (odd ? 1 : 0));
+			int s;
+			for (s = 0; s < nstub; s++)
+				if (stubs [s].ip == key) break;
+			if (s == nstub) {
+				if (nstub >= SJ_W_MAP || off + 14 > cap) return t->state = SJ_S_OFF_SHORT, 0;
+				if (off & 2) { wr16 (buf + off, 0xbf00); off += 2; }
+				stubs [nstub].ip = key; stubs [nstub++].off = (guint32) off;
+				off = sj_emit_exit9 (buf, off, (tip - t->ip) * (ptrdiff_t) sizeof (guint16) | (odd ? 1 : 0), framed);
+				if (odd && f->op != 1)
+					ntrap++;
+			}
+			target_off = stubs [s].off;
+		}
+		if (!sj_put_branch (buf + f->off, addr + f->off, addr + target_off, f->cond))
+			return t->state = SJ_S_OFF_SHORT, 0;
+	}
+	if (off & 2) { wr16 (buf + off, 0xbf00); off += 2; }
+	/* the trap sites: the odd stubs at instructions the record never reached (traps [0].slot = how many) */
+	int nt = 0;
+	(void) ntrap;
+	for (int pass = 0; pass < 2; pass++) {
+		nt = 0;
+		for (int s = 0; s < nstub; s++)
+			if ((gsize) stubs [s].ip & 1) {
+				const guint16 *sip = (const guint16 *) ((gsize) stubs [s].ip & ~(gsize) 1);
+				int k = sj_plan_find (plan, np, sip);
+				if (k >= 0 && plan [k].disp == SJD_TRAP) {
+					nt++;
+					if (pass)
+						traps [nt].slot = (guint16) (sip - t->ip);
+				}
+			}
+		if (!nt)
+			break;
+		if (!pass) {
+			traps = g_new0 (SjTrap, nt + 1);
+			traps [0].slot = (guint16) nt;
+		}
+	}
+	/* lockstep: which instructions the trace runs itself (the walker stops at every other one) */
+	if (mono_shepjit_mode == 2 || sj_want_cmap) {
+		guint32 span = (guint32) (end_ip - t->ip);
+		guint8 *cm = (guint8 *) g_malloc0 ((span + 8) / 8);
+		cm [0] |= 1;   /* the entry opcode */
+		for (int i = 0; i < np; i++) {
+			int d = plan [i].disp;
+			if (d == SJD_CODE || d == SJD_INTR || d == SJD_CALL || d == SJD_MARK) {
+				guint32 s = (guint32) (plan [i].ip - t->ip);
+				cm [s >> 3] |= (guint8) (1 << (s & 7));
+			}
+		}
+		t->x->pending_cmap = cm;   /* (published with the code; the old one is never freed: a racing lockstep run may read it) */
+	}
+	t->nops = (guint16) nemit;
+	t->x->pending_full_slots = (guint32) (end_ip - t->ip);
+	t->x->ncalls = (guint16) ncall;
+	t->x->nintrins = (guint16) nintr;
+	t->x->cflags = (guint8) ((t->x->cflags & SJ_C_INTR_EVER) | SJ_C_K9 | (rec ? SJ_C_RECORD : 0) | (framed ? SJ_C_FRAMED : 0) | (nintr ? SJ_C_INTR_EVER : 0));
+	t->x->pending_traps = traps;
+	t->x->ntraps = (guint16) nt;
+	sj_st.ops += (guint64) nemit;
+	sj_st.stencil_bytes += stencil_bytes;
+	sj_st.stub_bytes += (guint64) (off - stencil_bytes);
+	sj_st.calls += (guint32) ncall;
+	sj_st.intrins += (guint32) nintr;
+	sj_st.traps += (guint32) nt;
+	if (framed)
+		sj_st.traces_framed++;
+	t->code_bytes = (guint16) MIN (off, 65535);
+	return off;
+}
+
 static gint64
 sj_now_us (void)
 {
 	return mono_100ns_ticks () / 10;
 }
 
+/* (review 2) J2's "live": each trace once (kit #8's traces go live once; a kit #9 trace goes live again after each recompile) */
+static inline void
+sj_count_live (SjTrace *t)
+{
+	if (!t->x || !t->x->live_counted) {
+		sj_st.live++;
+		if (t->x)
+			t->x->live_counted = 1;
+	}
+}
+
+/* (review 2) a RECOMPILE that will not be published (the block is full, its window failed): the trace keeps its old code -- published by
+ * an earlier window, valid, running all along -- in the state that goes with its fn (the monitor still measuring it, or running at full
+ * speed: the code, the count wrapper, lockstep). Kit #8's tier has no recompiles. */
+static void
+sj_keep_old (SjTrace *t)
+{
+	mono_memory_barrier ();
+	t->state = t->fn == sj_monitor ? SJ_S_MONITOR : SJ_S_LIVE;
+}
+
+/* (review 2) a staged recompile that will not be published: its tables were never seen by anyone (the slow exit, the wrappers and lockstep
+ * read only the published ones), so they are freed and the pending fields go back to the published code's */
+static void
+sj_drop_pending (SjTrace *t)
+{
+	SjTraceK9 *x = t->x;
+	if (x->pending_traps != x->traps)
+		g_free (x->pending_traps);
+	if (x->pending_cmap != x->cmap)
+		g_free (x->pending_cmap);
+	x->pending_traps = x->traps;
+	x->pending_cmap = x->cmap;
+	x->pending_code = t->code;
+	x->pending_full_slots = t->full_slots;
+}
+
