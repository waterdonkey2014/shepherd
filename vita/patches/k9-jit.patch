+static int
+sj_ldfld_op (MonoType *t)
+{
+	if (m_type_is_byref (t))
+		return -1;
+	switch (t->type) {
+	case MONO_TYPE_I1: return MINT_LDFLD_I1;
+	case MONO_TYPE_U1: case MONO_TYPE_BOOLEAN: return MINT_LDFLD_U1;
+	case MONO_TYPE_I2: return MINT_LDFLD_I2;
+	case MONO_TYPE_U2: case MONO_TYPE_CHAR: return MINT_LDFLD_U2;
+	case MONO_TYPE_I4: case MONO_TYPE_U4: case MONO_TYPE_I: case MONO_TYPE_U: case MONO_TYPE_PTR: case MONO_TYPE_FNPTR: return MINT_LDFLD_I4;
+	case MONO_TYPE_I8: case MONO_TYPE_U8: return MINT_LDFLD_I8;
+	case MONO_TYPE_R4: return MINT_LDFLD_R4;
+	case MONO_TYPE_R8: return MINT_LDFLD_R8;
+	case MONO_TYPE_STRING: case MONO_TYPE_CLASS: case MONO_TYPE_OBJECT: case MONO_TYPE_SZARRAY: case MONO_TYPE_ARRAY: return MINT_LDFLD_O;
+	case MONO_TYPE_GENERICINST: return mono_type_is_reference (t) ? MINT_LDFLD_O : -1;
+	default: return -1;
+	}
+}
+static int
+sj_ldsfld_op (int ldfld_op)
+{
+	switch (ldfld_op) {
+	case MINT_LDFLD_I1: return MINT_LDSFLD_I1;
+	case MINT_LDFLD_U1: return MINT_LDSFLD_U1;
+	case MINT_LDFLD_I2: return MINT_LDSFLD_I2;
+	case MINT_LDFLD_U2: return MINT_LDSFLD_U2;
+	case MINT_LDFLD_I4: return MINT_LDSFLD_I4;
+	case MINT_LDFLD_I8: return MINT_LDSFLD_I8;
+	case MINT_LDFLD_R4: return MINT_LDSFLD_R4;
+	case MINT_LDFLD_R8: return MINT_LDSFLD_R8;
+	case MINT_LDFLD_O: return MINT_LDSFLD_O;
+	}
+	return -1;
+}
+/* the field load a return type needs and the field holds must be the same storage (the getter returns the field as it is) */
+static gboolean
+sj_same_storage (MonoType *ret, MonoType *ft)
+{
+	int a = sj_ldfld_op (ret), b = sj_ldfld_op (ft);
+	return a >= 0 && a == b && (a != MINT_LDFLD_O || mono_type_is_reference (ret));
