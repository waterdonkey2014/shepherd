+/* (the compiler thread) the verdict for a MINT_JIT_CALL, copied out; FALSE = a real call */
+static gboolean
+sj_getter_of (InterpMethod *im, const guint16 *ip, SjIntrinsic *out)
+{
+	if (!sj_intrinsics || !sj_getters)
+		return FALSE;
+	InterpMethod *callee = (InterpMethod *) im->data_items [ip [3]];
+	if (!callee || !callee->method)
+		return FALSE;
+	mono_os_mutex_lock (&sj_lock);
+	SjIntrinsic *g = (SjIntrinsic *) g_hash_table_lookup (sj_getters, callee->method);
+	if (g)
+		*out = *g;
+	mono_os_mutex_unlock (&sj_lock);
+	return g && out->kind != SJI_NONE;
