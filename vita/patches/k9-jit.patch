+{
+	if (!sj_intrinsics || *ip != MINT_JIT_CALL)
+		return;
+	InterpMethod *callee = (InterpMethod *) im->data_items [ip [3]];
+	if (!callee || !callee->method)
+		return;
+	mono_os_mutex_lock (&sj_lock);
+	if (!sj_getters)
+		sj_getters = g_hash_table_new (NULL, NULL);
+	gboolean known = g_hash_table_lookup (sj_getters, callee->method) != NULL;
+	mono_os_mutex_unlock (&sj_lock);
