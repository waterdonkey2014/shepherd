+/*
+ * SHEPHERD-VITA device kit #9, track runtime (vita/patches/k9-divfast-flag.patch, vita/notes/kit9-runtime.md "E2 divfast"): the RUN-TIME
+ * switch of E2 divfast (vita/patches/k9-divfast-compiler.patch, an AOT compiler option). An image compiled with SHEPHERD_AOT_DIVFAST=1 loads
+ * this word in front of every emulated division / remainder -- through a JIT_ICALL_ADDR_NOCALL GOT slot: the JIT icall of the same name is
+ * registered with the word's ADDRESS as its "function" (it is never called) -- and takes a no-wrapper fast path only when the word allows:
+ *   2 = every fast path (the default);
+ *   1 = SHEPHERD_K9_DIVMOD=0 (E2 off): the 32-bit and constant-divisor fast paths only; a 64-bit division takes the wrapper call (on to
+ *       mono_lldiv & co., where E2 is off too: libgcc's 64-bit routine, as kit #8);
+ *   0 = SHEPHERD_K9_DIVFAST=0: no fast path -- every division is the wrapper call emitted before divfast, kit #8's code path.
+ * Read once from the environment (mini_init: before any managed code runs). The host's H8 line reads the word weakly. An image compiled
+ * without divfast never reads it; with the variables unset the compiler's output does not change (no other JIT icall id moves).
+ */
+gint32 mono_shepherd_k9_divfast_flags = 2;
 
 static void
+k9_divfast_flags_init (void)
+{
+	const char *f = getenv ("SHEPHERD_K9_DIVFAST"), *d = getenv ("SHEPHERD_K9_DIVMOD");
+	if (f && (!strcmp (f, "0") || !strcmp (f, "off")))
+		mono_shepherd_k9_divfast_flags = 0;
+	else if (d && (!strcmp (d, "0") || !strcmp (d, "off")))
+		mono_shepherd_k9_divfast_flags = 1;
+	else
+		mono_shepherd_k9_divfast_flags = 2;
+	register_dyn_icall ((gpointer) &mono_shepherd_k9_divfast_flags, mono_shepherd_k9_divfast_flags, NULL, TRUE);
+}
