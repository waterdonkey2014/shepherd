+static GHashTable *
+k9_read_lines (const char *files, gboolean ranked)
+{
+	GHashTable *t = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, NULL);
+	char **fs = g_strsplit (files, ":", 0);
+	int n = 0;
+	for (char **f = fs; *f; ++f) {
+		FILE *fp = fopen (*f, "r");
+		if (!fp) {
+			fprintf (stderr, "SHEPHERD kit #9: cannot read %s\n", *f);
+			exit (1);
+		}
+		char line [8192];
+		while (fgets (line, sizeof (line), fp)) {
+			size_t l = strlen (line);
+			while (l && (line [l - 1] == '\n' || line [l - 1] == '\r'))
+				line [--l] = 0;
+			if (!l || line [0] == '#' || g_hash_table_lookup (t, line))
+				continue;
+			g_hash_table_insert (t, g_strdup (line), GINT_TO_POINTER (ranked ? ++n : 1));
+		}
+		fclose (fp);
+	}
+	g_strfreev (fs);
+	return t;
+}
+
+gboolean
+mono_shepherd_aot_order_active (void)
+{
+	if (!k9_order_read) {
+		k9_order_read = 1;
+		const char *f = g_getenv ("SHEPHERD_AOT_ORDER");
+		if (f && *f)
+			k9_order = k9_read_lines (f, TRUE);
+	}
+	return k9_order != NULL;
+}
+
+int
+mono_shepherd_aot_order_rank_cb (const char *name, void *data)
+{
+	gpointer r = k9_order ? g_hash_table_lookup (k9_order, name) : NULL;
+	return r ? GPOINTER_TO_INT (r) - 1 : -1;
+}
