+static int
+k9_rank_cmp (const void *a, const void *b)
+{
+	/* (qsort is not stable: the old position is in the low 32 bits, so no two keys are equal) */
+	gint64 ra = *(gint64 *) a, rb = *(gint64 *) b;
+	return ra < rb ? -1 : ra > rb ? 1 : 0;
+}
+
+/* R5, the Mono-backend methods (the .s): method_order stably sorted by rank of each method's symbol */
 static void
+k9_order_methods (MonoAotCompile *acfg)
+{
+	if (!mono_shepherd_aot_order_active () || !acfg->method_order)
+		return;
+	guint len = acfg->method_order->len;
+	gint64 *keys = g_new0 (gint64, len);
+	int ranked = 0;
+	for (guint i = 0; i < len; ++i) {
+		guint idx = GPOINTER_TO_UINT (g_ptr_array_index (acfg->method_order, i));
+		MonoCompile *cfg = acfg->cfgs [idx];
+		int r = (cfg && cfg->asm_symbol && !cfg->compile_llvm) ? mono_shepherd_aot_order_rank_cb (cfg->asm_symbol, NULL) : -1;
+		if (r >= 0)
+			ranked++;
+		gint64 rk = r >= 0 ? r : 0x3fffffff;
+		keys [i] = (rk << 32) | i;
+	}
+	if (ranked) {
+		gint64 *sorted = g_new (gint64, len);
+		memcpy (sorted, keys, len * sizeof (gint64));
+		qsort (sorted, len, sizeof (gint64), k9_rank_cmp);
+		GPtrArray *old = g_ptr_array_sized_new (len);
+		for (guint i = 0; i < len; ++i)
+			g_ptr_array_add (old, g_ptr_array_index (acfg->method_order, i));
+		for (guint i = 0; i < len; ++i)
+			g_ptr_array_index (acfg->method_order, i) = g_ptr_array_index (old, (guint) (sorted [i] & 0xffffffff));
+		g_ptr_array_free (old, TRUE);
+		g_free (sorted);
+	}
+	g_free (keys);
+	mono_shepherd_aot_order_note ("Mono-backend", ranked);
+}
