+/* R3: only fully concrete instances take part: a generic argument that is (or contains) a type parameter -- a gsharedvt instance's
+ * T_GSHAREDVT, an open instance -- names a parameter of the CALLER's own generic method or type, so the defining image's "same" instance
+ * (its own T) is a different method the runtime will not match (kit #9 trace check: List<T>.Grow / AddWithResize / set_Capacity /
+ * Enumerator.get_Current went from AOT to the interpreter until this rule). Shared instances over System.__Canon are concrete types. */
+static gboolean
+k9_concrete_instance (MonoMethod *method)
+{
+	MonoGenericContext *ctx = mono_method_get_context (method);
+	for (int k = 0; ctx && k < 2; ++k) {
+		MonoGenericInst *gi = k == 0 ? ctx->class_inst : ctx->method_inst;
+		if (!gi)
+			continue;
+		for (guint i = 0; i < gi->type_argc; ++i)
+			if (mono_class_is_open_constructed_type (gi->type_argv [i]))
+				return FALSE;
+	}
+	return TRUE;
+}
+
+/* R3: the key of an inflated method -- the image defining its generic type, its full name, and its type arguments assembly-qualified */
+static char *
+k9_instance_key (MonoMethod *method)
+{
+	MonoClass *klass = method->klass;
+	GString *s = g_string_new (m_class_get_image (klass)->assembly_name);
+	char *fn = mono_method_get_full_name (method);
+	g_string_append_c (s, '\t');
+	g_string_append (s, fn);
+	g_free (fn);
+	MonoGenericContext *ctx = mono_method_get_context (method);
+	for (int k = 0; ctx && k < 2; ++k) {
+		MonoGenericInst *gi = k == 0 ? ctx->class_inst : ctx->method_inst;
+		if (!gi)
+			continue;
+		for (guint i = 0; i < gi->type_argc; ++i) {
+			char *tn = mono_type_get_name_full (gi->type_argv [i], MONO_TYPE_NAME_FORMAT_ASSEMBLY_QUALIFIED);
+			g_string_append_printf (s, "\t%c%s", k == 0 ? 'C' : 'M', tn);
+			g_free (tn);
+		}
+	}
+	return g_string_free (s, FALSE);
+}
+
+static gboolean
+k9_skip_instance (MonoAotCompile *acfg, MonoMethod *method)
+{
+	if (!k9_skip_read) {
+		k9_skip_read = 1;
+		const char *f = g_getenv ("SHEPHERD_AOT_SKIP_INSTANCES");
+		if (f && *f)
+			k9_skip = k9_read_lines (f, FALSE);
+	}
+	if (!k9_skip || !method->is_inflated || method->wrapper_type != MONO_WRAPPER_NONE)
+		return FALSE;
+	if (m_class_get_image (method->klass) == acfg->image || !k9_concrete_instance (method))
+		return FALSE;   /* this image defines it (its copy is the one the runtime finds first) / not a concrete instance */
+	char *key = k9_instance_key (method);
+	gboolean skip = g_hash_table_lookup (k9_skip, key) != NULL;
+	g_free (key);
+	if (skip)
+		k9_skipped++;
+	return skip;
+}
+
+static gboolean
+k9_keep_drop (MonoAotCompile *acfg, MonoMethod *method)
+{
+	if (!k9_keep_read) {
+		k9_keep_read = 1;
+		const char *f = g_getenv ("SHEPHERD_AOT_KEEP");
+		if (f && *f) {
+			k9_keep = k9_read_lines (f, FALSE);
+			char *pre = g_strdup_printf ("%s\t", acfg->image->assembly_name);
+			GHashTableIter it; gpointer k, v;
+			k9_keep_image = -1;
+			g_hash_table_iter_init (&it, k9_keep);
+			while (g_hash_table_iter_next (&it, &k, &v))
+				if (g_str_has_prefix ((const char *) k, pre)) { k9_keep_image = 1; break; }
+			g_free (pre);
+		}
+	}
+	if (!k9_keep || k9_keep_image != 1 || method->is_inflated || method->wrapper_type != MONO_WRAPPER_NONE || m_class_get_image (method->klass) != acfg->image)
+		return FALSE;
+	char key [600];
+	snprintf (key, sizeof (key), "%s\t%08x", acfg->image->assembly_name, mono_method_get_token (method));
+	if (g_hash_table_lookup (k9_keep, key))
+		return FALSE;
+	k9_keep_dropped++;
+	return TRUE;
+}
