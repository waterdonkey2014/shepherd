+/* SHEPHERD-VITA kit #9 R5 (profile-ordered AOT code layout): llc lays functions out in module order, so moving the profile's hot methods
+ * to the front of the method region (between llvm_code_start and llvm_code_end, which the runtime takes as the image's LLVM code range)
+ * packs them into the fewest pages / cache lines. Only the order changes: every function, its body and its name stay as they are. */
+int
+mono_llvm_cpp_reorder_functions (LLVMModuleRef module, LLVMValueRef start, LLVMValueRef end, int (*rank) (const char *name, void *data), void *data)
+{
+	llvm::Module *m = llvm::unwrap (module);
+	llvm::Function *fs = llvm::unwrap<llvm::Function> (start), *fe = llvm::unwrap<llvm::Function> (end);
+	auto &fl = m->getFunctionList ();
+	std::vector<std::pair<int, llvm::Function *>> ranked;
+	bool inside = false;
+	for (auto &f : fl) {
+		if (&f == fs) { inside = true; continue; }
+		if (&f == fe) break;
+		if (!inside) continue;
+		int r = rank (f.getName ().str ().c_str (), data);
+		if (r >= 0)
+			ranked.push_back ({ r, &f });
+	}
+	if (!inside || ranked.empty ())
+		return 0;
+	std::stable_sort (ranked.begin (), ranked.end (), [] (const std::pair<int, llvm::Function *> &a, const std::pair<int, llvm::Function *> &b) { return a.first < b.first; });
+	/* right after llvm_code_start, in rank order; the unranked keep their order behind them */
+	auto pos = std::next (fs->getIterator ());
+	for (auto &e : ranked) {
+		if (e.second->getIterator () == pos) { ++pos; continue; }
+		fl.splice (pos, fl, e.second->getIterator ());
+	}
+	return (int) ranked.size ();
+}
