+ * bigger slot (a 208-byte object in a 256-byte slot); the host may add sizes before mono_jit_init* (the census's most-wasted object sizes).
+ * Only where objects of those sizes are placed changes; none set (default) = sgen's table exactly. */
+#define VITA_MAX_EXTRA_SIZES 32
+static int vita_extra_sizes [VITA_MAX_EXTRA_SIZES];
+static int vita_extra_size_n;
+void mono_vita_gc_set_size_classes (const int *sizes, int n);
+void
+mono_vita_gc_set_size_classes (const int *sizes, int n)
+{
+	vita_extra_size_n = 0;
