+/* t holds the stock table (stock_n sizes, ascending) and room for the extras: merge, sort, drop duplicates; returns the new count */
+static int
+vita_merge_size_classes (int *t, int stock_n)
+{
+	int n = stock_n;
+	for (int i = 0; i < vita_extra_size_n; i++)
+		t [n++] = vita_extra_sizes [i];
+	for (int i = 1; i < n; i++) {   /* (insertion sort: at most 26 + 32 entries, once at start-up) */
+		int v = t [i], j = i - 1;
+		while (j >= 0 && t [j] > v) { t [j + 1] = t [j]; j--; }
+		t [j + 1] = v;
+	}
+	int m = 0;
+	for (int i = 0; i < n; i++)
+		if (!m || t [i] != t [m - 1])
+			t [m++] = t [i];
+	return m;
