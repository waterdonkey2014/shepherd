+/* ---- device kit #10, track memory: the SHARED POOL (vita/notes/kit10-memory.md; mono-vita.h mono_vita_vm_arena_pool_*) ----
+ * One block holds newlib's heap AND the Mono arena: the host hands the whole block to mono_vita_vm_arena_init, sets policy 3, and its
+ * _sbrk_r takes newlib's pages from the arena's LOW end upward (pool_take); every arena request is placed top-down from the HIGH end
+ * and never below the FLOOR (pool_set_floor) -- the pages between newlib's top and the floor are newlib's guaranteed room. newlib's pages
+ * are not counted in used / peak (the host reports them). Policy 0 / 1 / 2 (kit #9) never reach this code. */
+static guint32 pool_taken_pages;   /* newlib's pages: [0, pool_taken_pages) */
+
+/* the extent that holds page 'pg' (free), or -1 */
+static int
+extent_holding (guint32 pg)
+{
+	for (guint32 i = 0; i < n_extents && extents [i].start <= pg; ++i)
+		if (pg < extents [i].start + extents [i].count)
+			return (int)i;
+	return -1;
+}
+
+int
+mono_vita_vm_arena_pool_take (size_t new_top)
+{
+	int res = -1;
+	pthread_mutex_lock (&arena_mutex);
+	guint32 np = (guint32)((new_top + VITA_PAGE - 1) / VITA_PAGE);
+	if (pool_on && arena_base && np <= pool_floor_page) {
+		if (np <= pool_taken_pages) {
+			res = 0;   /* (already newlib's) */
+		} else {
+			int i = extent_holding (pool_taken_pages);
+			/* [taken, floor) is always free (the arena never allocates below the floor): one free extent starts at 'taken' */
+			if (i >= 0 && extents [i].start == pool_taken_pages && extents [i].start + extents [i].count >= np &&
+			    extent_carve ((guint32)i, pool_taken_pages, np - pool_taken_pages)) {
+				pool_taken_pages = np;
+				res = 0;
+			}
+		}
+	}
+	pthread_mutex_unlock (&arena_mutex);
+	return res;
+}
+
+int
+mono_vita_vm_arena_pool_set_floor (size_t floor)
+{
+	int res = -1;
+	pthread_mutex_lock (&arena_mutex);
+	guint32 fp = (guint32)((floor + VITA_PAGE - 1) / VITA_PAGE);
+	if (pool_on && arena_base && fp >= pool_taken_pages && fp <= arena_pages) {
+		if (fp <= pool_floor_page) {
+			pool_floor_page = fp;   /* lowered (or kept): newlib gives room back to the arena */
+			res = 0;
+		} else {
+			/* raised: only over free pages -- [old floor, new floor) inside one free extent (an arena allocation there keeps the floor) */
+			int i = extent_holding (pool_floor_page);
+			if (i >= 0 && extents [i].start + extents [i].count >= fp) {
+				pool_floor_page = fp;
+				res = 0;
+			}
+		}
+	}
+	pthread_mutex_unlock (&arena_mutex);
+	return res;
+}
+
+void
+mono_vita_vm_arena_pool_get (size_t *taken, size_t *floor, size_t *lowest_used)
+{
+	pthread_mutex_lock (&arena_mutex);
+	if (taken)
+		*taken = (size_t)pool_taken_pages * VITA_PAGE;
+	if (floor)
+		*floor = (size_t)pool_floor_page * VITA_PAGE;
+	if (lowest_used) {
+		/* the lowest page the arena uses above the floor: the end of the free extent holding the floor (the arena size when all free) */
+		int i = extent_holding (pool_floor_page);
+		*lowest_used = (size_t)(i >= 0 ? extents [i].start + extents [i].count : pool_floor_page) * VITA_PAGE;
+	}
+	pthread_mutex_unlock (&arena_mutex);
+}
+
+/* the arena's first allocatable page (newlib's region starts here in the shared pool) */
+void *
+mono_vita_vm_arena_pool_base (void)
+{
+	return arena_base;
+}
