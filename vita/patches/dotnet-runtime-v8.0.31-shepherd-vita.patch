diff --git a/src/mono/mono/utils/mono-mmap-vita.c b/src/mono/mono/utils/mono-mmap-vita.c
new file mode 100644
index 000000000..915921b5f
--- /dev/null
+++ b/src/mono/mono/utils/mono-mmap-vita.c
@@ -0,0 +1,477 @@
+/**
+ * \file
+ * SHEPHERD-VITA: mono_valloc/mono_vfree/mono_mprotect for the PS Vita, without mmap.
+ *
+ * The Vita has no mmap and no per-page protection for user memory. Mono's "virtual memory" users
+ * (sgen nursery, major-heap blocks, LOS sections, card tables, hazard pointers, interpreter stacks, ...)
+ * are served from ONE large USER_RW memory block, carved in 4 KiB pages:
+ *   - free space is a sorted array of page extents (first fit, any power-of-two alignment);
+ *   - frees may return any page-aligned subrange of an earlier allocation (sgen frees runs of blocks)
+ *     and coalesce with their neighbours;
+ *   - every allocation is zero-filled (callers rely on anonymous-mmap semantics);
+ *   - DATA ONLY: requests for executable memory are refused and counted. The runtime is interpreter +
+ *     static AOT; nothing may generate code at run time.
+ * The arena is either handed over by the host (mono_vita_vm_arena_init) or allocated here on first use
+ * with sceKernelAllocMemBlock (budget from mono_vita_vm_arena_set_budget, default 64 MiB).
+ *
+ * Fatal errors (double free, a free outside the arena, corrupt bookkeeping) are raised only AFTER
+ * arena_mutex is released: g_error runs the host's fatal log handler, which reads the arena stats.
+ * Nothing in this file calls out (g_error/g_assert/logging) while it holds the lock.
+ */
+
+#include <config.h>
+
+#ifdef HOST_VITA
+
+#include <glib.h>
+#include <string.h>
+#include <errno.h>
+#include <pthread.h>
+
+#include <psp2/kernel/sysmem.h>
+
+#include "mono-mmap.h"
+#include "mono-mmap-internals.h"
+#include "mono-vita.h"
+#include <mono/utils/mono-errno.h>
+
+#define VITA_PAGE 4096u
+#define VITA_DEFAULT_ARENA_BUDGET (64u * 1024 * 1024)
+#define VITA_DEFAULT_LOG_STEP (8u * 1024 * 1024)
+
+typedef struct {
+	guint32 start; /* page index from arena_base */
+	guint32 count; /* pages */
+} VitaExtent;
+
+static pthread_mutex_t arena_mutex = PTHREAD_MUTEX_INITIALIZER;
+static guint8 *arena_base;          /* first allocatable page */
+static guint32 arena_pages;
+static VitaExtent *extents;         /* sorted by start, non-adjacent (always coalesced) */
+static guint32 n_extents, max_extents;
+static size_t arena_budget = VITA_DEFAULT_ARENA_BUDGET;
+static SceUID arena_block = -1;     /* only when the runtime allocated the block itself */
+static gboolean arena_failed_init;
+
+static size_t used_bytes, peak_bytes, next_log_mark;
+static guint32 n_allocs, n_frees, n_failed, n_exec;
+
+static size_t log_step = VITA_DEFAULT_LOG_STEP;
+static void default_log (const char *event, const MonoVitaArenaStats *stats, size_t request);
+static MonoVitaArenaLogFn log_fn = default_log;
+
+static void
+default_log (const char *event, const MonoVitaArenaStats *stats, size_t request)
+{
+	g_message ("vita-arena %s: used %u KiB, peak %u KiB of %u KiB, %u free extents (largest %u KiB), request %u KiB, exec refused %u",
+		event, (unsigned)(stats->used / 1024), (unsigned)(stats->peak / 1024), (unsigned)(stats->arena_size / 1024),
+		stats->free_extents, (unsigned)(stats->largest_free / 1024), (unsigned)(request / 1024), stats->exec_requests);
+}
+
+static void
+fill_stats_locked (MonoVitaArenaStats *s)
+{
+	guint32 largest = 0;
+	for (guint32 i = 0; i < n_extents; ++i)
+		if (extents [i].count > largest)
+			largest = extents [i].count;
+	s->arena_size = (size_t)arena_pages * VITA_PAGE;
+	s->used = used_bytes;
+	s->peak = peak_bytes;
+	s->largest_free = (size_t)largest * VITA_PAGE;
+	s->free_extents = n_extents;
+	s->failed_allocs = n_failed;
+	s->exec_requests = n_exec;
+	s->allocs = n_allocs;
+	s->frees = n_frees;
+}
+
+/* Lays out the bookkeeping at the start of [base, base+size) and makes the rest one free extent. */
+static int
+arena_setup_locked (void *base, size_t size)
+{
+	guint8 *b = (guint8 *)base;
+	if (!b || ((gsize)b & (VITA_PAGE - 1)) || size < 16 * VITA_PAGE)
+		return -1;
+	guint32 total_pages = (guint32)(size / VITA_PAGE);
+	/* free extents are separated by used pages: at most ceil(pages/2) of them */
+	guint32 cap = total_pages / 2 + 2;
+	guint32 meta_pages = (guint32)((cap * sizeof (VitaExtent) + VITA_PAGE - 1) / VITA_PAGE);
+	extents = (VitaExtent *)b;
+	max_extents = cap;
+	arena_base = b + (size_t)meta_pages * VITA_PAGE;
+	arena_pages = total_pages - meta_pages;
+	extents [0].start = 0;
+	extents [0].count = arena_pages;
+	n_extents = 1;
+	next_log_mark = log_step;
+	return 0;
+}
+
+static gboolean
+arena_ensure_locked (void)
+{
+	if (arena_base)
+		return TRUE;
+	if (arena_failed_init)
+		return FALSE;
+	size_t size = (arena_budget + VITA_PAGE - 1) & ~(size_t)(VITA_PAGE - 1);
+	SceUID blk = sceKernelAllocMemBlock ("mono-vm-arena", SCE_KERNEL_MEMBLOCK_TYPE_USER_RW, size, NULL);
+	void *base = NULL;
+	if (blk < 0 || sceKernelGetMemBlockBase (blk, &base) < 0 || arena_setup_locked (base, size) != 0) {
+		if (blk >= 0)
+			sceKernelFreeMemBlock (blk);
+		arena_failed_init = TRUE;
+		return FALSE;
+	}
+	arena_block = blk;
+	return TRUE;
+}
+
+int
+mono_vita_vm_arena_init (void *base, size_t size)
+{
+	int res;
+	pthread_mutex_lock (&arena_mutex);
+	if (arena_base)
+		res = -1; /* already initialized (explicitly or by a first allocation) */
+	else
+		res = arena_setup_locked (base, size);
+	pthread_mutex_unlock (&arena_mutex);
+	return res;
+}
+
+void
+mono_vita_vm_arena_set_budget (size_t size)
+{
+	pthread_mutex_lock (&arena_mutex);
+	if (!arena_base)
+		arena_budget = size;
+	pthread_mutex_unlock (&arena_mutex);
+}
+
+void
+mono_vita_vm_arena_get_stats (MonoVitaArenaStats *stats)
+{
+	pthread_mutex_lock (&arena_mutex);
+	fill_stats_locked (stats);
+	pthread_mutex_unlock (&arena_mutex);
+}
+
+int
+mono_vita_vm_arena_try_get_stats (MonoVitaArenaStats *stats)
+{
+	/* never blocks: for fatal-error paths, which may run on a thread that is inside an arena call */
+	if (pthread_mutex_trylock (&arena_mutex) != 0)
+		return -1;
+	fill_stats_locked (stats);
+	pthread_mutex_unlock (&arena_mutex);
+	return 0;
+}
+
+void
+mono_vita_vm_arena_set_log (MonoVitaArenaLogFn fn, size_t step)
+{
+	pthread_mutex_lock (&arena_mutex);
+	log_fn = fn;
+	log_step = step ? step : VITA_DEFAULT_LOG_STEP;
+	next_log_mark = (used_bytes / log_step + 1) * log_step;
+	pthread_mutex_unlock (&arena_mutex);
+}
+
+static void
+extent_remove (guint32 i)
+{
+	memmove (&extents [i], &extents [i + 1], (n_extents - i - 1) * sizeof (VitaExtent));
+	n_extents--;
+}
+
+/* FALSE (nothing changed) when the extent table is full. That cannot happen while the bookkeeping is intact
+ * (free extents are never adjacent, so there are at most pages/2 + 1 of them); the caller reports it after
+ * releasing the lock. */
+static gboolean
+extent_insert (guint32 i, guint32 start, guint32 count)
+{
+	if (n_extents >= max_extents)
+		return FALSE;
+	memmove (&extents [i + 1], &extents [i], (n_extents - i) * sizeof (VitaExtent));
+	extents [i].start = start;
+	extents [i].count = count;
+	n_extents++;
+	return TRUE;
+}
+
+/* Takes pages [start, start+count) out of extent i, which must contain them. FALSE (nothing changed) when
+ * the split needs an extent slot and none is left. */
+static gboolean
+extent_carve (guint32 i, guint32 start, guint32 count)
+{
+	VitaExtent e = extents [i];
+	guint32 pre = start - e.start;
+	guint32 post = e.start + e.count - (start + count);
+	if (pre && post) {
+		if (!extent_insert (i + 1, start + count, post))
+			return FALSE;
+		extents [i].count = pre;
+	} else if (pre) {
+		extents [i].count = pre;
+	} else if (post) {
+		extents [i].start = start + count;
+		extents [i].count = post;
+	} else {
+		extent_remove (i);
+	}
+	return TRUE;
+}
+
+#define VITA_ALLOC_NO_SPACE (-1)
+#define VITA_ALLOC_TABLE_FULL (-2) /* corrupt bookkeeping: reported by the caller after unlocking */
+
+/* Returns the page index of an allocation of 'pages' pages aligned to 'align' bytes, or VITA_ALLOC_*. */
+static gint64
+arena_alloc_locked (guint32 pages, size_t align, guint8 *hint, gboolean fixed)
+{
+	if (hint && hint >= arena_base && hint < arena_base + (size_t)arena_pages * VITA_PAGE &&
+	    !(((gsize)hint) & (VITA_PAGE - 1)) && !(((gsize)hint) & (align - 1))) {
+		guint32 hp = (guint32)((hint - arena_base) / VITA_PAGE);
+		for (guint32 i = 0; i < n_extents && extents [i].start <= hp; ++i) {
+			if (hp >= extents [i].start && (guint64)hp + pages <= (guint64)extents [i].start + extents [i].count)
+				return extent_carve (i, hp, pages) ? hp : VITA_ALLOC_TABLE_FULL;
+		}
+	}
+	if (fixed)
+		return VITA_ALLOC_NO_SPACE;
+	for (guint32 i = 0; i < n_extents; ++i) {
+		gsize abs = (gsize)(arena_base + (size_t)extents [i].start * VITA_PAGE);
+		gsize aligned = (abs + align - 1) & ~(gsize)(align - 1);
+		guint32 pad = (guint32)((aligned - abs) / VITA_PAGE);
+		if ((guint64)pad + pages <= extents [i].count) {
+			guint32 start = extents [i].start + pad;
+			return extent_carve (i, start, pages) ? start : VITA_ALLOC_TABLE_FULL;
+		}
+	}
+	return VITA_ALLOC_NO_SPACE;
+}
+
+typedef enum {
+	VITA_FREE_OK,
+	VITA_FREE_OVERLAP,     /* double free: the range overlaps the free extent in *conflict */
+	VITA_FREE_TABLE_FULL   /* corrupt bookkeeping */
+} VitaFreeStatus;
+
+/* Returns the range [start, start+pages) to the free list. Changes nothing unless it returns VITA_FREE_OK;
+ * the caller raises the error after releasing arena_mutex. */
+static VitaFreeStatus
+arena_free_locked (guint32 start, guint32 pages, VitaExtent *conflict)
+{
+	guint32 i = 0;
+	/* first extent that starts after the freed range */
+	while (i < n_extents && extents [i].start < start)
+		i++;
+	if (i > 0 && extents [i - 1].start + extents [i - 1].count > start) {
+		*conflict = extents [i - 1];
+		return VITA_FREE_OVERLAP;
+	}
+	if (i < n_extents && start + pages > extents [i].start) {
+		*conflict = extents [i];
+		return VITA_FREE_OVERLAP;
+	}
+
+	gboolean merge_prev = i > 0 && extents [i - 1].start + extents [i - 1].count == start;
+	gboolean merge_next = i < n_extents && start + pages == extents [i].start;
+	if (merge_prev && merge_next) {
+		extents [i - 1].count += pages + extents [i].count;
+		extent_remove (i);
+	} else if (merge_prev) {
+		extents [i - 1].count += pages;
+	} else if (merge_next) {
+		extents [i].start = start;
+		extents [i].count += pages;
+	} else if (!extent_insert (i, start, pages)) {
+		return VITA_FREE_TABLE_FULL;
+	}
+	return VITA_FREE_OK;
+}
+
+static void *
+vita_valloc (void *addr, size_t length, size_t alignment, int flags, MonoMemAccountType type)
+{
+	MonoVitaArenaStats st;
+	const char *event = NULL;
+	void *res = NULL;
+
+	if (flags & MONO_MMAP_EXEC) {
+		/* Data memory only. Something tried to get memory to generate code into: refuse loudly. */
+		pthread_mutex_lock (&arena_mutex);
+		n_exec++;
+		pthread_mutex_unlock (&arena_mutex);
+		g_warning ("vita-arena: refused EXECUTABLE memory request (%u bytes, %s): the Vita runtime never generates code",
+			   (unsigned) length, mono_mem_account_type_name (type));
+		return NULL;
+	}
+	if (length == 0)
+		return NULL;
+	if (alignment < VITA_PAGE)
+		alignment = VITA_PAGE;
+	g_assert (!(alignment & (alignment - 1)));
+
+	size_t bytes = (length + VITA_PAGE - 1) & ~(size_t)(VITA_PAGE - 1);
+	if (!mono_valloc_can_alloc (bytes))
+		return NULL;
+
+	gboolean corrupt = FALSE;
+	pthread_mutex_lock (&arena_mutex);
+	if (arena_ensure_locked ()) {
+		gint64 p = arena_alloc_locked ((guint32)(bytes / VITA_PAGE), alignment, (guint8 *)addr, (flags & MONO_MMAP_FIXED) != 0);
+		if (p == VITA_ALLOC_TABLE_FULL) {
+			corrupt = TRUE;
+			fill_stats_locked (&st);
+		} else if (p >= 0) {
+			res = arena_base + (size_t)p * VITA_PAGE;
+			used_bytes += bytes;
+			n_allocs++;
+			if (used_bytes > peak_bytes)
+				peak_bytes = used_bytes;
+			if (used_bytes >= next_log_mark) {
+				next_log_mark = (used_bytes / log_step + 1) * log_step;
+				event = "grow";
+			}
+		} else {
+			n_failed++;
+			event = "FAIL";
+		}
+	} else {
+		n_failed++;
+		event = "FAIL (no arena)";
+	}
+	if (event)
+		fill_stats_locked (&st);
+	pthread_mutex_unlock (&arena_mutex);
+
+	if (corrupt)
+		g_error ("vita-arena: free-extent table full (%u of %u) allocating %u KiB: arena bookkeeping is corrupt",
+			 st.free_extents, (unsigned) max_extents, (unsigned)(bytes / 1024));
+	if (res) {
+		memset (res, 0, bytes);
+		mono_account_mem (type, (ssize_t)bytes);
+	}
+	if (event && log_fn)
+		log_fn (event, &st, bytes);
+	return res;
+}
