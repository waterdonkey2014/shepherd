+}
+
+int
+mono_vfree (void *addr, size_t length, MonoMemAccountType type)
+{
+	guint8 *a = (guint8 *)addr;
+	if (!a || !length)
+		return 0;
+	size_t bytes = (length + VITA_PAGE - 1) & ~(size_t)(VITA_PAGE - 1);
+	VitaFreeStatus fs = VITA_FREE_OK;
+	VitaExtent conflict = { 0, 0 };
+	pthread_mutex_lock (&arena_mutex);
+	guint8 *base = arena_base;
+	size_t span = (size_t)arena_pages * VITA_PAGE;
+	gboolean outside = !base || a < base || ((gsize)a & (VITA_PAGE - 1)) || a + bytes > base + span;
+	if (!outside) {
+		fs = arena_free_locked ((guint32)((a - base) / VITA_PAGE), (guint32)(bytes / VITA_PAGE), &conflict);
+		if (fs == VITA_FREE_OK) {
+			used_bytes -= bytes;
+			n_frees++;
+		}
+	}
+	pthread_mutex_unlock (&arena_mutex);
+
+	/* only now, with the lock released (the host's fatal log handler reads the arena stats) */
+	if (outside)
+		g_error ("vita-arena: mono_vfree (%p, %u) outside the arena [%p, +%u KiB)",
+			 addr, (unsigned) length, base, (unsigned)(span / 1024));
+	if (fs == VITA_FREE_OVERLAP)
+		g_error ("vita-arena: double free of %p (+%u pages): overlaps free extent %p (+%u pages)",
+			 addr, (unsigned)(bytes / VITA_PAGE), base + (size_t)conflict.start * VITA_PAGE, conflict.count);
+	if (fs == VITA_FREE_TABLE_FULL)
+		g_error ("vita-arena: free-extent table full freeing %p (+%u pages): arena bookkeeping is corrupt",
+			 addr, (unsigned)(bytes / VITA_PAGE));
+	mono_account_mem (type, -(ssize_t)bytes);
+	return 0;
+}
+
+int
+mono_mprotect (void *addr, size_t length, int flags)
+{
+	if (flags & MONO_MMAP_EXEC) {
+		pthread_mutex_lock (&arena_mutex);
+		n_exec++;
+		pthread_mutex_unlock (&arena_mutex);
+		g_warning ("vita-arena: refused mprotect(EXEC) on %p (+%u): data memory only", addr, (unsigned) length);
+		mono_set_errno (EACCES);
+		return -1;
+	}
+	if (flags & MONO_MMAP_DISCARD)
+		memset (addr, 0, length);
+	/* No page protection for user memory on the Vita: PROT_NONE guard pages are not enforced
+	 * (explicit null checks and stack-limit checks are used instead). */
+	return 0;
+}
+
+/* ---- V6: max-heap-size refusals (sgen-memory-governor.c, MONO_VITA_HEAP_LIMIT_HOOK) */
