diff --git a/src/mono/mono/utils/mono-vita-yield.c b/src/mono/mono/utils/mono-vita-yield.c
new file mode 100644
index 000000000..af3eef5c4
--- /dev/null
+++ b/src/mono/mono/utils/mono-vita-yield.c
@@ -0,0 +1,79 @@
+/**
+ * \file
+ * SHEPHERD-VITA: managed Thread.Yield for the PS Vita (icall.c's ves_icall_System_Threading_Thread_YieldInternal under HOST_VITA).
+ *
+ * The game polls with Thread.Yield: DOGames.Threading.DispatchThread's worker loop spins on an empty queue (IsEmpty, then
+ * Thread.Yield) for the whole run, and spine-unity's SkeletonAnimation.BaseLateUpdate / SkeletonRenderer.LateUpdate /
+ * AnimationState.WaitForBGProcessingToComplete wait for that worker the same way. With the runtime's platform yield
+ * (mono_threads_platform_yield: sceKernelDelayThread (100)) the idle worker wakes ~10,000 times a second and keeps most of a
+ * core busy (the Mac sim measured 79 % of one).
+ *
+ * Here a thread that yields back to back (it comes back within VITA_YIELD_GAP_US of its previous yield returning, i.e. it did no
+ * other work in between) backs off: the first 16 yields of a run sleep 100 us (as before: short completion waits stay fast), then
+ * 250, 500 and from the 64th on 1000 us. Any gap longer than VITA_YIELD_GAP_US starts a new run. So the idle worker settles at
+ * ~1,000 wake-ups a second; a wait that is still spinning after ~2 ms (16 short yields + 16 x 250 us) can overshoot its event by
+ * at most 1 ms. Only managed Thread.Yield takes this path: the runtime's own yields (stop-the-world restart, suspend retries,
+ * Thread.Sleep (0)) keep mono_threads_platform_yield.
+ *
+ * Per-thread state lives in a small table keyed by the SceKernel thread id (the toolchain has no __thread); a thread that finds no
+ * free slot yields the old way. The policy (mono-vita-yield.h) is pure and unit-tested on the Mac (vita/runtime/tests/test_yield.c).
+ */
+
+#include <config.h>
+
+#ifdef HOST_VITA
+
+#include <stdint.h>
+#include <psp2/kernel/threadmgr.h>
+#include <psp2/kernel/processmgr.h>
+#include <mono/utils/mono-vita.h>
+#include <mono/utils/mono-vita-yield.h>
+
+#define VY_SLOTS 64
+static struct { volatile SceUID tid; uint64_t last; unsigned run; } vy_slot [VY_SLOTS];
+static volatile uint64_t vy_calls, vy_delay_us, vy_backed_off, vy_no_slot;
+
+static int
+vy_find (SceUID tid)
+{
+	for (int i = 0; i < VY_SLOTS; i++)
+		if (vy_slot [i].tid == tid)
+			return i;
+	for (int i = 0; i < VY_SLOTS; i++)
+		if (vy_slot [i].tid == 0 && __sync_bool_compare_and_swap (&vy_slot [i].tid, 0, tid))
+			return i;
+	return -1;
+}
+
+void
+mono_vita_managed_yield (void)
+{
+	SceUID tid = sceKernelGetThreadId ();
+	int s = vy_find (tid);
+	unsigned run = 0;
+	if (s >= 0) {
+		run = mono_vita_yield_next_run (vy_slot [s].last, sceKernelGetProcessTimeWide (), vy_slot [s].run);
+		vy_slot [s].run = run;
+	} else {
+		__sync_fetch_and_add (&vy_no_slot, 1);
+	}
+	unsigned d = mono_vita_yield_delay_us (run);
+	__sync_fetch_and_add (&vy_calls, 1);
+	__sync_fetch_and_add (&vy_delay_us, d);
+	if (d > MONO_VITA_YIELD_BASE_US)
+		__sync_fetch_and_add (&vy_backed_off, 1);
+	sceKernelDelayThread (d);
+	if (s >= 0)
+		vy_slot [s].last = sceKernelGetProcessTimeWide ();
+}
+
+void
+mono_vita_get_yield_stats (uint64_t *calls, uint64_t *delay_us, uint64_t *backed_off, uint64_t *no_slot)
+{
+	if (calls) *calls = vy_calls;
+	if (delay_us) *delay_us = vy_delay_us;
+	if (backed_off) *backed_off = vy_backed_off;
+	if (no_slot) *no_slot = vy_no_slot;
+}
+
+#endif /* HOST_VITA */
diff --git a/src/mono/mono/utils/mono-vita-yield.h b/src/mono/mono/utils/mono-vita-yield.h
new file mode 100644
index 000000000..0b1525dbf
--- /dev/null
+++ b/src/mono/mono/utils/mono-vita-yield.h
@@ -0,0 +1,33 @@
+/**
+ * \file
+ * SHEPHERD-VITA: the back-off policy of managed Thread.Yield on the PS Vita (mono-vita-yield.c). Pure and header-only so that
+ * the Mac unit test (vita/runtime/tests/test_yield.c) runs the exact code the device runs.
+ */
+#ifndef __MONO_UTILS_MONO_VITA_YIELD_H__
+#define __MONO_UTILS_MONO_VITA_YIELD_H__
+
+#include <stdint.h>
+
+/* a yield that starts less than this many microseconds after the same thread's previous yield returned continues a run */
+#define MONO_VITA_YIELD_GAP_US 200
+/* the platform yield's delay (mono-threads-vita.c), kept for the first yields of a run */
+#define MONO_VITA_YIELD_BASE_US 100
+#define MONO_VITA_YIELD_MAX_US 1000
+
+/* the run length after a yield that starts at 'now' (us); 'last' = when the previous one returned (0 = never), 'run' = its run length */
+static inline unsigned
+mono_vita_yield_next_run (uint64_t last, uint64_t now, unsigned run)
+{
+	if (last != 0 && now >= last && now - last < MONO_VITA_YIELD_GAP_US)
+		return run < 0xffffu ? run + 1 : run;
+	return 0;
+}
+
+/* the delay of a yield that is the run'th back-to-back one (0 = the first) */
+static inline unsigned
+mono_vita_yield_delay_us (unsigned run)
+{
+	return run < 16 ? MONO_VITA_YIELD_BASE_US : run < 32 ? 250 : run < 64 ? 500 : MONO_VITA_YIELD_MAX_US;
+}
+
+#endif
diff --git a/src/mono/mono/utils/mono-vita.h b/src/mono/mono/utils/mono-vita.h
new file mode 100644
index 000000000..f11353357
--- /dev/null
+++ b/src/mono/mono/utils/mono-vita.h
@@ -0,0 +1,100 @@
+/**
+ * \file
+ * SHEPHERD-VITA: embedding API of the PS Vita (vitasdk, HOST_VITA) port of the Mono runtime.
+ *
+ * Self-contained on purpose (no Mono headers): the host includes it directly.
+ * Everything here is data memory only; the Vita runtime never generates or maps executable code.
+ */
+#ifndef __MONO_UTILS_MONO_VITA_H__
+#define __MONO_UTILS_MONO_VITA_H__
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define MONO_VITA_API __attribute__((visibility("default")))
+
+/* ---- static symbol table (replaces dlopen/dlsym; see mono-dl-vita.c) ---- */
+typedef struct {
+	const char *name;
+	void *addr;
+} MonoVitaStaticSymbol;
+
+/* Registers a table of linked symbols. Lookups through mono_dl_open (NULL)/"__Internal" and the
+ * host's P/Invoke override resolve against all registered tables. May be called before mono init. */
+MONO_VITA_API void mono_vita_register_static_symbols (const MonoVitaStaticSymbol *symbols, int count);
+/* Returns NULL when the symbol is not in any registered table. */
+MONO_VITA_API void *mono_vita_lookup_static_symbol (const char *name);
+
+/* ---- VM arena: backs mono_valloc/mono_vfree/mono_mprotect (sgen nursery, major heap, LOS, ...) ---- */
+typedef struct {
+	size_t arena_size;      /* bytes managed by the arena (after the bookkeeping pages) */
+	size_t used;            /* bytes currently handed out */
+	size_t peak;            /* high-water mark of used */
+	size_t largest_free;    /* largest free extent */
+	unsigned int free_extents;
+	unsigned int failed_allocs;
+	unsigned int exec_requests; /* valloc/mprotect calls that asked for EXEC (served as data only / refused) */
+	unsigned int allocs, frees;
+} MonoVitaArenaStats;
+
+/* Give the runtime its arena: a USER_RW block the host allocated (base must be 4 KiB aligned).
+ * Must be called before mono_jit_init*. Returns 0 on success. */
+MONO_VITA_API int mono_vita_vm_arena_init (void *base, size_t size);
+/* Alternative: let the runtime allocate one sceKernelAllocMemBlock USER_RW block of this size on first use
+ * (default 64 MiB when neither this nor mono_vita_vm_arena_init is called). */
+MONO_VITA_API void mono_vita_vm_arena_set_budget (size_t size);
+MONO_VITA_API void mono_vita_vm_arena_get_stats (MonoVitaArenaStats *stats);
+/* Same, but never blocks: returns 0 with *stats filled, or -1 (stats untouched) when the arena lock is held.
+ * For fatal-error and exit paths, which may run on a thread that is inside an arena call. */
+MONO_VITA_API int mono_vita_vm_arena_try_get_stats (MonoVitaArenaStats *stats);
+/* Called (outside the arena lock) every time usage crosses another 'step' bytes and on every failed
+ * allocation; the default prints through g_message. */
+typedef void (*MonoVitaArenaLogFn) (const char *event, const MonoVitaArenaStats *stats, size_t request);
+MONO_VITA_API void mono_vita_vm_arena_set_log (MonoVitaArenaLogFn fn, size_t step);
+
+/* ---- GC heap limit: called by sgen (GC lock held: log only, never call into Mono) whenever an allocation is refused
+ * by max-heap-size. space: 0 = major heap, 1 = LOS (SgenMemgovSpace). count = refusals so far. */
+typedef void (*MonoVitaHeapLimitFn) (size_t request, int space, size_t allocated, size_t max_heap, unsigned count);
+MONO_VITA_API void mono_vita_set_heap_limit_callback (MonoVitaHeapLimitFn fn);
+MONO_VITA_API unsigned mono_vita_heap_limit_count (void);
+
+/* ---- managed Thread.Yield (mono-vita-yield.c): back-to-back yields of a thread back off from 100 us to 1 ms ---- */
+void mono_vita_managed_yield (void);
+/* totals since start: managed yields, microseconds slept in them, yields that slept longer than 100 us, yields with no state slot */
+MONO_VITA_API void mono_vita_get_yield_stats (uint64_t *calls, uint64_t *delay_us, uint64_t *backed_off, uint64_t *no_slot);
+
+/* ---- runtime counters (V6: the device run's checkpoint lines; read without locks, so approximate) ---- */
+typedef struct {
+	int64_t interp_transforms;          /* interpreter transforms done (a method re-transformed by tiering counts twice) */
+	int32_t interp_methods;             /* distinct methods that got interpreter code */
+	int32_t interp_inlined;             /* methods inlined by the interpreter's transform */
+	int32_t interp_emitted_instructions;
+	int32_t aot_methods;                /* AOT method bodies looked up and used */
+	int64_t mempool_bytes;              /* all MonoMemPools: image metadata, class/method data, interpreter code */
+	int32_t methods;                    /* MonoMethods created */
+	int32_t initialized_classes;
+	int32_t used_classes;
+	int32_t generic_classes;            /* MonoGenericClass instances */
+	int32_t inflated_types;
+	int32_t inflated_methods;
+	int32_t vtable_bytes;
+	int32_t static_data_bytes;
+	int32_t imt_bytes;
+	int32_t delegates_created;
+} MonoVitaRuntimeStats;
+MONO_VITA_API void mono_vita_get_runtime_stats (MonoVitaRuntimeStats *stats);
+
+/* ---- threads ---- */
+/* Stack size for threads Mono creates without an explicit size (managed threads, finalizer, sgen workers).
+ * Default 1 MiB. The Vita has no guard pages: a stack overflow corrupts memory instead of faulting. */
+MONO_VITA_API void mono_vita_set_default_thread_stack_size (size_t size);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* __MONO_UTILS_MONO_VITA_H__ */
