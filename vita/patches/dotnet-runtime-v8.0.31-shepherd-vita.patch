diff --git a/src/mono/mono/utils/mono-dl-vita.c b/src/mono/mono/utils/mono-dl-vita.c
new file mode 100644
index 000000000..91f0e2888
--- /dev/null
+++ b/src/mono/mono/utils/mono-dl-vita.c
@@ -0,0 +1,140 @@
+/**
+ * \file
+ * SHEPHERD-VITA: mono_dl backend for the PS Vita. There is no dynamic loader.
+ *
+ * Everything is linked statically into the eboot. mono_dl_open (NULL) ("the executable", also used for
+ * DllImport("__Internal")) returns a pseudo handle whose symbols come from the tables the host registers with
+ * mono_vita_register_static_symbols (normally generated from the AOT modules' direct-pinvoke references plus the
+ * host's own exports). Any other library name fails with an explicit error; the host's PINVOKE_OVERRIDE maps
+ * library names such as libSystem.Native to the same tables before the loader ever gets here.
+ */
+
+#include <config.h>
+
+#ifdef HOST_VITA
+
+#include <glib.h>
+#include <string.h>
+#include <stdio.h>
+#include <pthread.h>
+
+#include "mono/utils/mono-dl.h"
+#include "mono/utils/mono-vita.h"
+
+#define VITA_MAX_TABLES 16
+
+typedef struct {
+	const MonoVitaStaticSymbol *symbols;
+	int count;
+} VitaSymbolTable;
+
+static VitaSymbolTable tables [VITA_MAX_TABLES];
+static int n_tables;
+static pthread_mutex_t tables_mutex = PTHREAD_MUTEX_INITIALIZER;
+static GHashTable *symbol_index; /* name -> addr, built lazily from all tables */
+
+/* the "executable" handle */
+static int vita_self_handle;
+#define VITA_SELF ((void *)&vita_self_handle)
+
+static char last_error [256];
+
+static void
+set_error (const char *fmt, const char *arg)
+{
+	snprintf (last_error, sizeof (last_error), fmt, arg ? arg : "(null)");
+}
+
+void
+mono_vita_register_static_symbols (const MonoVitaStaticSymbol *symbols, int count)
+{
+	pthread_mutex_lock (&tables_mutex);
+	if (n_tables >= VITA_MAX_TABLES)
+		g_error ("%s: too many static symbol tables (max %d)", __func__, VITA_MAX_TABLES);
+	tables [n_tables].symbols = symbols;
+	tables [n_tables].count = count;
+	n_tables++;
+	if (symbol_index) {
+		for (int i = 0; i < count; ++i)
+			g_hash_table_insert (symbol_index, (gpointer)symbols [i].name, symbols [i].addr);
+	}
+	pthread_mutex_unlock (&tables_mutex);
+}
+
+void *
+mono_vita_lookup_static_symbol (const char *name)
+{
+	void *res;
+	if (!name)
+		return NULL;
+	pthread_mutex_lock (&tables_mutex);
+	if (!symbol_index) {
+		symbol_index = g_hash_table_new (g_str_hash, g_str_equal);
+		for (int t = 0; t < n_tables; ++t)
+			for (int i = 0; i < tables [t].count; ++i)
+				g_hash_table_insert (symbol_index, (gpointer)tables [t].symbols [i].name, tables [t].symbols [i].addr);
+	}
+	res = g_hash_table_lookup (symbol_index, name);
+	pthread_mutex_unlock (&tables_mutex);
+	return res;
+}
+
+const char *
+mono_dl_get_so_prefix (void)
+{
+	return "lib";
+}
+
+const char **
+mono_dl_get_so_suffixes (void)
+{
+	static const char *suffixes [] = {
+		".so",
+		"",
+	};
+	return suffixes;
+}
+
+void *
+mono_dl_open_file (const char *file, int flags, MonoError *error)
+{
+	if (!file)
+		return VITA_SELF;
+	set_error ("dlopen is not available on the PS Vita (static build): '%s' must be resolved through the static symbol table / PINVOKE_OVERRIDE", file);
+	return NULL;
+}
+
+void
+mono_dl_close_handle (MonoDl *module, MonoError *error)
+{
+}
+
+void *
+mono_dl_lookup_symbol (MonoDl *module, const char *name)
+{
+	void *res = NULL;
+	if (module && module->handle == VITA_SELF)
+		res = mono_vita_lookup_static_symbol (name);
+	if (!res)
+		set_error ("symbol '%s' is not in the PS Vita static symbol table", name);
+	return res;
+}
+
+int
+mono_dl_convert_flags (int mono_flags, int native_flags)
+{
+	return native_flags;
+}
+
+char *
+mono_dl_current_error_string (void)
+{
+	return g_strdup (last_error [0] ? last_error : "no dynamic loader on the PS Vita");
+}
+
+#else
+
+#include <mono/utils/mono-compiler.h>
+MONO_EMPTY_SOURCE_FILE (mono_dl_vita);
+
+#endif /* HOST_VITA */
