+/*
+ * SHEPHERD-VITA: VFP argument copy of the armhf gsharedvt transition, indexed by SINGLE-precision register.
+ * ArgInfo.reg of a RegTypeFP argument is an s-register number (add_float in mini-arm.c), and a float can sit in an
+ * odd s-register (the second of two floats, or back-filled after a double). Upstream copies
+ * callee_fregs [reg / 2] = caller_fregs [reg / 2] and reads T-by-ref floats through a double*, so it moves the
+ * whole d-register: (float a, float b) <-> (T a, T b) hands the callee the wrong float, and a float that changes
+ * s-register clobbers its neighbour. Here every value is copied with its own size (4 or 8) at its own s-register,
+ * and a by-ref T points at its exact s-register slot. The areas hold d0-d7 (= s0-s15) as saved by the trampoline.
+ * A float that one signature passes in a VFP register and the other on the stack (more than 16 single-precision
+ * argument registers' worth) is copied to/from its stack slot(s) instead of hitting an assert.
+ */
+static void
+vita_gsharedvt_copy_fregs (GSharedVtCallInfo *info, gpointer *caller, gpointer *callee, float *caller_sregs, float *callee_sregs)
+{
+	CallInfo *caller_cinfo = info->caller_cinfo;
+	CallInfo *callee_cinfo = info->callee_cinfo;
+
+	for (int aindex = 0; aindex < caller_cinfo->nargs; ++aindex) {
+		ArgInfo *ainfo = &caller_cinfo->args [aindex];
+		ArgInfo *ainfo2 = &callee_cinfo->args [aindex];
+
+		if (ainfo->storage == RegTypeFP) {
+			float *src = &caller_sregs [ainfo->reg];
+
+			switch (ainfo2->storage) {
+			case RegTypeFP:
+				memcpy (&callee_sregs [ainfo2->reg], src, ainfo2->size);
+				break;
+			case RegTypeGSharedVtInReg:
+				/* gsharedvt T passed by address: point at the value inside the saved caller VFP area */
+				callee [ainfo2->reg] = src;
+				break;
+			case RegTypeGSharedVtOnStack:
+				callee [(ainfo2->offset / 4) + 4] = src;
+				break;
+			case RegTypeBase:
+				memcpy (&callee [(ainfo2->offset / 4) + 4], src, ainfo->size);
+				break;
+			default:
+				g_assert_not_reached ();
+				break;
+			}
