diff --git a/src/mono/mono/utils/mono-threads-vita.c b/src/mono/mono/utils/mono-threads-vita.c
new file mode 100644
index 000000000..ba4403ce3
--- /dev/null
+++ b/src/mono/mono/utils/mono-threads-vita.c
@@ -0,0 +1,336 @@
+/**
+ * \file
+ * SHEPHERD-VITA: low-level threading backend for the PS Vita (vitasdk: newlib + pthread-embedded on SceKernel threads).
+ *
+ * Cooperative suspend only. The Vita has no asynchronous signals (pthread_kill returns EINVAL), so a thread can
+ * never be stopped from outside: every runtime thread polls for suspend requests at safepoints and is considered
+ * suspended while it is in a GC-safe (blocking) region. Nothing here installs a signal or exception handler.
+ *
+ * Stacks: SceKernel threads get a kernel-allocated stack with no guard page; the size is fixed at creation.
+ * Stack bounds come from sceKernelGetThreadInfo. TLS goes through pthread keys (pthread-embedded keeps a
+ * per-thread key list; gcc is built with --disable-tls, so there is no __thread).
+ */
+
+#include <config.h>
+
+#include <mono/utils/mono-threads.h>
+#include <mono/utils/mono-compiler.h>
+
+#if defined (USE_VITA_BACKEND)
+
+#include <mono/utils/mono-threads-api.h>
+#include <mono/utils/mono-threads-coop.h>
+#include <mono/utils/mono-threads-debug.h>
+#include <mono/utils/mono-mmap.h>
+#include <mono/utils/mono-vita.h>
+#include <mono/metadata/gc-internals.h>
+
+#include <glib.h>
+#include <errno.h>
+#include <string.h>
+#include <pthread.h>
+
+#include <psp2/kernel/threadmgr.h>
+
+#define VITA_MIN_THREAD_STACK (64 * 1024)
+#define VITA_DEFAULT_THREAD_STACK (1024 * 1024)
+
+static size_t vita_default_stack_size = VITA_DEFAULT_THREAD_STACK;
+static SceUID vita_main_thread_uid = -1;
+
+void
+mono_vita_set_default_thread_stack_size (size_t size)
+{
+	if (size < VITA_MIN_THREAD_STACK)
+		size = VITA_MIN_THREAD_STACK;
+	vita_default_stack_size = (size + 4095) & ~(size_t)4095;
+}
+
+/* ---- suspend backend: coop only ---- */
+
+void
+mono_threads_suspend_init_signals (void)
+{
+	/* no signals on the Vita */
+}
+
+void
+mono_threads_suspend_init (void)
+{
+	if (!mono_threads_is_cooperative_suspension_enabled ())
+		g_error ("The PS Vita runtime supports cooperative suspend only (MONO_THREADS_SUSPEND=coop)");
+}
+
+void
+mono_threads_suspend_register (MonoThreadInfo *info)
+{
+	/* Runs on the attaching thread. Mono never cancels threads; with cancellation disabled pthread-embedded
+	 * waits block in sceKernelWaitSema directly instead of polling a cancel flag every 0.5 ms
+	 * (pte_cancellable_wait -> pte_osSemaphoreCancellablePend), which would cost thousands of wakeups per
+	 * second per idle thread on the Vita. */
+	int old;
+	pthread_setcancelstate (PTHREAD_CANCEL_DISABLE, &old);
+}
+
+void
+mono_threads_suspend_free (MonoThreadInfo *info)
+{
+}
+
+gboolean
+mono_threads_suspend_begin_async_suspend (MonoThreadInfo *info, gboolean interrupt_kernel)
+{
+	/* Only reachable with preemptive/hybrid suspend, which this backend refuses in suspend_init. */
+	g_error ("%s: asynchronous suspend is impossible on the PS Vita (no signals)", __func__);
+	return FALSE;
+}
+
+gboolean
+mono_threads_suspend_check_suspend_result (MonoThreadInfo *info)
+{
+	return TRUE;
+}
+
+gboolean
+mono_threads_suspend_begin_async_resume (MonoThreadInfo *info)
+{
+	/* Coop resume posts the thread's resume semaphore in mono-threads.c; nothing asynchronous to do. */
+	return TRUE;
+}
+
+void
+mono_threads_suspend_abort_syscall (MonoThreadInfo *info)
+{
+	/* No way to interrupt a blocking SceKernel call from another thread without signals. Blocking waits in
+	 * the runtime are GC-safe (so they never stall a stop-the-world) and interruptible waits go through
+	 * MonoOSEvent/semaphores that the interrupt path posts directly. */
+}
+
+gint
+mono_threads_suspend_search_alternative_signal (void)
+{
+	return -1;
+}
+
+gint
+mono_threads_suspend_get_suspend_signal (void)
+{
+	return -1;
+}
+
+gint
+mono_threads_suspend_get_restart_signal (void)
+{
+	return -1;
+}
+
+gint
+mono_threads_suspend_get_abort_signal (void)
+{
+	return -1;
+}
+
+/* ---- platform threads ---- */
+
+int
+mono_thread_info_get_system_max_stack_size (void)
+{
+	/* the kernel caps a thread stack well below this; let the create call fail if it is too big */
+	return 32 * 1024 * 1024;
+}
+
+gboolean
+mono_thread_platform_create_thread (MonoThreadStart thread_fn, gpointer thread_data, gsize* const stack_size, MonoNativeThreadId *tid)
+{
+	pthread_attr_t attr;
+	pthread_t thread;
+	gint res;
+	gsize set_stack_size = stack_size ? *stack_size : 0;
+
+	if (set_stack_size == 0)
+		set_stack_size = vita_default_stack_size;
+	if (set_stack_size < VITA_MIN_THREAD_STACK)
+		set_stack_size = VITA_MIN_THREAD_STACK;
+	set_stack_size = (set_stack_size + 4095) & ~(gsize)4095;
+
+	res = pthread_attr_init (&attr);
+	if (res != 0)
+		g_error ("%s: pthread_attr_init failed, error: \"%s\" (%d)", __func__, g_strerror (res), res);
+
+	/* pthread-embedded passes this to sceKernelCreateThread (stackaddr is ignored: the kernel allocates the stack) */
+	res = pthread_attr_setstacksize (&attr, set_stack_size);
+	if (res != 0)
+		g_error ("%s: pthread_attr_setstacksize failed, error: \"%s\" (%d)", __func__, g_strerror (res), res);
+
+	res = mono_gc_pthread_create (&thread, &attr, (gpointer (*)(gpointer)) thread_fn, thread_data);
+	pthread_attr_destroy (&attr);
+	if (res) {
+		g_warning ("%s: pthread_create (stack %u KiB) failed: %d", __func__, (unsigned)(set_stack_size / 1024), res);
+		return FALSE;
+	}
+
+	if (tid)
+		*tid = thread;
+	if (stack_size)
+		*stack_size = set_stack_size;
+	return TRUE;
+}
+
+void
+mono_threads_platform_get_stack_bounds (guint8 **staddr, size_t *stsize)
+{
+	SceKernelThreadInfo info;
+	int tmp;
+	int res;
+
+	memset (&info, 0, sizeof (info));
+	info.size = sizeof (info);
+	res = sceKernelGetThreadInfo (sceKernelGetThreadId (), &info);
+	if (G_UNLIKELY (res < 0))
+		g_error ("%s: sceKernelGetThreadInfo failed: 0x%08x", __func__, res);
+
+	*staddr = (guint8 *) info.stack;
+	*stsize = (size_t) info.stackSize;
+
+	/* SceKernelThreadInfo.stack is the low end of the stack block; the stack grows down from stack + stackSize.
+	 * Accept the other reading too (stack = top) rather than trusting undocumented layout blindly. */
+	guint8 *sp = (guint8 *)&tmp;
+	if (sp >= *staddr && sp < *staddr + *stsize)
+		return;
+	if (sp < *staddr && sp >= *staddr - *stsize) {
+		*staddr -= *stsize;
+		return;
+	}
+	g_error ("%s: thread 0x%x stack info [%p, +0x%x) does not contain sp %p", __func__,
+		 (unsigned) sceKernelGetThreadId (), (void *) info.stack, (unsigned) *stsize, (void*)sp);
+}
+
+gboolean
+mono_threads_platform_is_main_thread (void)
+{
+	return vita_main_thread_uid == sceKernelGetThreadId ();
+}
+
+void
+mono_threads_platform_init (void)
+{
+	/* the thread that initializes the runtime (the host runs Mono on a created thread with a big stack) */
+	vita_main_thread_uid = sceKernelGetThreadId ();
+}
+
+gboolean
+mono_threads_platform_in_critical_region (THREAD_INFO_TYPE *info)
+{
+	return FALSE;
+}
+
+gboolean
+mono_threads_platform_yield (void)
+{
+	/* pthread-embedded's sched_yield sleeps a full millisecond; a short delay is enough to let an
+	 * equal-priority thread on this core run. */
+	sceKernelDelayThread (100);
+	return TRUE;
+}
+
+void
+mono_threads_platform_exit (gsize exit_code)
+{
+	pthread_exit ((gpointer) exit_code);
+}
+
+gboolean
+mono_thread_platform_external_eventloop_keepalive_check (void)
+{
+	return FALSE;
+}
+
+MonoNativeThreadId
+mono_native_thread_id_get (void)
+{
+	return pthread_self ();
+}
+
+guint64
+mono_native_thread_os_id_get (void)
+{
+	return (guint64)(guint32) sceKernelGetThreadId ();
+}
+
+gboolean
+mono_native_thread_id_equals (MonoNativeThreadId id1, MonoNativeThreadId id2)
+{
+	return pthread_equal (id1, id2);
+}
+
+typedef struct {
+	void *(*func) (void *);
+	void *arg;
+} VitaNativeThreadStart;
+
+static void *
+vita_native_thread_start (void *data)
+{
+	VitaNativeThreadStart start = *(VitaNativeThreadStart *) data;
+	int old;
+
+	g_free (data);
+	/* Native helper threads (sgen thread-pool workers, the utility thread) never pass through
+	 * mono_threads_suspend_register: disable cancellation here too, so their idle condition waits block in
+	 * sceKernelWaitSema instead of polling pthread-embedded's cancel flag every 0.5 ms. */
+	pthread_setcancelstate (PTHREAD_CANCEL_DISABLE, &old);
+	return start.func (start.arg);
+}
+
+gboolean
+mono_native_thread_create (MonoNativeThreadId *tid, gpointer func, gpointer arg)
+{
+	pthread_attr_t attr;
+	int res;
+	VitaNativeThreadStart *start = g_new (VitaNativeThreadStart, 1);
+
+	start->func = (void *(*)(void *)) func;
+	start->arg = arg;
+	/* without an attr pthread-embedded uses _pthread_stack_default_user (or 32 KiB): be explicit */
+	pthread_attr_init (&attr);
+	pthread_attr_setstacksize (&attr, vita_default_stack_size);
+	res = pthread_create (tid, &attr, vita_native_thread_start, start);
+	pthread_attr_destroy (&attr);
+	if (res != 0)
+		g_free (start);
+	return res == 0;
+}
+
+size_t
+mono_native_thread_get_name (MonoNativeThreadId tid, char *name_out, size_t max_len)
+{
+	return 0;
+}
+
+void
+mono_native_thread_set_name (MonoNativeThreadId tid, const char *name)
+{
+	/* SceKernel thread names are fixed at creation ("pthread"); Mono keeps the managed name itself. */
+}
+
+gboolean
+mono_native_thread_join (MonoNativeThreadId tid)
+{
+	void *res;
+
+	return !pthread_join (tid, &res);
+}
+
+void
+mono_memory_barrier_process_wide (void)
+{
+	/* The Vita has no mprotect-induced IPI trick. A full barrier on this core plus a reschedule is the
+	 * closest equivalent; only FlushProcessWriteBuffers uses this (no JIT patching on the Vita). */
+	__sync_synchronize ();
+}
+
+#else
+
+MONO_EMPTY_SOURCE_FILE (mono_threads_vita);
+
+#endif /* USE_VITA_BACKEND */
