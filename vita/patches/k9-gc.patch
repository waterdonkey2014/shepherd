+static gint64
+vita_major_used_size (void)
+{
+	vita_used_stats.calls++;
+	if (sgen_vita_used_mode == 0) {
+		vita_used_stats.walks++;
+		return vita_used_stats.last_walk = sgen_major_collector.get_used_size ();
+	}
+	gboolean same = vita_cache_valid && vita_cache_collections == vita_collections && vita_cache_allocated == sgen_total_allocated_major;
+	/* the counter is the book of a COMPLETE sweep: while a sweep is still running (concurrent sweep) it falls back to the walk */
+	gboolean swept = sgen_major_collector.have_swept ();
+	gint64 counter = (sgen_vita_used_mode >= 2 && swept) ? (gint64) sgen_memgov_vita_major_in_use () : -1;
+	if (sgen_vita_used_mode == 1 && same) {
+		vita_used_stats.cache_hits++;
+		return vita_cache_major;
+	}
+	if (sgen_vita_used_mode == 2 && counter >= 0) {
+		vita_used_stats.cache_hits++;   /* (mode 2: "reused" = answered from the counter, no walk) */
+		vita_used_stats.last_counter = counter;
+		return counter;
+	}
+	/* mode 1 miss, or mode 3: walk */
+	gint64 walked = sgen_major_collector.get_used_size ();
+	vita_used_stats.walks++;
+	vita_used_stats.last_walk = walked;
+	if (sgen_vita_used_mode == 3) {
+		if (same) {
+			vita_used_stats.cache_checked++;
+			if (vita_cache_major != walked)
+				vita_used_stats.cache_mismatches++;
+		}
+		if (counter >= 0)
+			vita_used_stats.counter_checked++;
+		vita_used_stats.last_counter = counter;
+		if (counter >= 0 && counter != walked) {
+			gint64 d = counter > walked ? counter - walked : walked - counter;
+			vita_used_stats.counter_mismatches++;
+			if (d > vita_used_stats.worst_counter_diff)
+				vita_used_stats.worst_counter_diff = d;
+		}
+	}
+	/* the walk may have swept blocks; neither changes the two keys */
+	vita_cache_major = walked;
+	vita_cache_collections = vita_collections;
+	vita_cache_allocated = sgen_total_allocated_major;
+	vita_cache_valid = TRUE;
+	return walked;
