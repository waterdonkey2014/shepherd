+	guint32 batches, windows_failed, max_batch;
+	guint64 window_us, max_window_us, compile_us, code_bytes, ops, stencil_bytes, stub_bytes;
+	guint64 lock_runs, lock_mismatch, lock_sp_races, lock_first_races;
+	guint32 sp_guard, queue_full;
+	guint32 abort_hist [MINT_LASTOP];
+} sj_st;
+
+static mono_mutex_t sj_lock;         /* the queue, the list of traces and the learning cache (every lookup and insert) */
+static mono_mutex_t sj_dump_lock;    /* (review fix) one writer of the trace tables and the learning cache at a time */
+static MonoSemType sj_sem;
+#define SJ_QCAP 1024
+static SjTrace **sj_q;            /* (heap: allocated at init only when the tier is on -- no eboot space for a JIT that is off) */
+static guint32 sj_qhead, sj_qtail, sj_order;
+static SjTrace *sj_all;
+static volatile int sj_thread_started;
+static volatile int sj_thread_failed;   /* (review fix) pthread_create's error: the tier switched itself off (nothing compiles) */
+
+/* ------------------------------------------------------------------ Thumb-2 patching */
+static inline guint16 rd16 (const guint8 *p) { return (guint16) (p [0] | (p [1] << 8)); }
+static inline void wr16 (guint8 *p, guint16 v) { p [0] = (guint8) v; p [1] = (guint8) (v >> 8); }
+/* the 16-bit immediate of a T3 MOVW / MOVT (imm4:i:imm3:imm8), opcode and Rd kept */
+static void
+sj_put_imm16 (guint8 *p, guint32 v)
+{
+	guint16 h1 = rd16 (p), h2 = rd16 (p + 2);
+	h1 = (guint16) ((h1 & 0xfbf0) | ((v >> 12) & 0xf) | (((v >> 11) & 1) << 10));
+	h2 = (guint16) ((h2 & 0x8f00) | (((v >> 8) & 7) << 12) | (v & 0xff));
+	wr16 (p, h1); wr16 (p + 2, h2);
+}
+/* B.W (T4, +-16 MiB) or B<c>.W (T3, +-1 MiB) at code address pc to target */
+static gboolean
+sj_put_branch (guint8 *p, gsize pc, gsize target, int cond)
+{
+	gssize off = (gssize) target - (gssize) (pc + 4);
+	if (off & 1)
+		return FALSE;
+	guint16 h1 = rd16 (p), h2 = rd16 (p + 2);
+	if (!cond) {
+		if (off < -(1 << 24) || off >= (1 << 24))
+			return FALSE;
+		guint32 S = (off >> 24) & 1, I1 = (off >> 23) & 1, I2 = (off >> 22) & 1, J1 = (~I1 ^ S) & 1, J2 = (~I2 ^ S) & 1;
+		h1 = (guint16) (0xf000 | (S << 10) | ((off >> 12) & 0x3ff));
+		h2 = (guint16) (0x9000 | (J1 << 13) | (J2 << 11) | ((off >> 1) & 0x7ff));
+	} else {
+		if (off < -(1 << 20) || off >= (1 << 20))
+			return FALSE;
+		guint32 S = (off >> 20) & 1, J2 = (off >> 19) & 1, J1 = (off >> 18) & 1;
+		h1 = (guint16) ((h1 & 0xfbc0) | (S << 10) | ((off >> 12) & 0x3f));
+		h2 = (guint16) ((h2 & 0xd000) | (J1 << 13) | (J2 << 11) | ((off >> 1) & 0x7ff));
+	}
+	wr16 (p, h1); wr16 (p + 2, h2);
+	return TRUE;
+}
+
+/* ------------------------------------------------------------------ fn pointers */
+static ptrdiff_t
+sj_skip (InterpFrame *frame, unsigned char *locals, SjTrace *t)
+{
+	return 3 * sizeof (guint16);   /* not (yet) compiled: step over the entry opcode, go on interpreting */
+}
+static ptrdiff_t sj_monitor (InterpFrame *frame, unsigned char *locals, SjTrace *t);
+static ptrdiff_t sj_lockstep (InterpFrame *frame, unsigned char *locals, SjTrace *t);
+
+static inline SjFn sj_code_fn (SjTrace *t) { return (SjFn) ((gsize) t->code | 1); }
+
+static void
+sj_set_opcode (SjTrace *t, guint16 op)
+{
+	mono_memory_barrier ();
+	*(volatile guint16 *) t->ip = op;
+	mono_memory_barrier ();
+}
+
+/* ------------------------------------------------------------------ which opcodes compile */
+static gboolean
+sj_heap_store (int op)
+{
+	switch (op) {
+	case MINT_STFLD_I1: case MINT_STFLD_U1: case MINT_STFLD_I2: case MINT_STFLD_U2: case MINT_STFLD_I4: case MINT_STFLD_I8:
+	case MINT_STFLD_R4: case MINT_STFLD_R8: case MINT_STFLD_O: case MINT_STFLD_VT_NOREF:
+	case MINT_STSFLD_I1: case MINT_STSFLD_U1: case MINT_STSFLD_I2: case MINT_STSFLD_U2: case MINT_STSFLD_I4: case MINT_STSFLD_I8:
+	case MINT_STSFLD_R4: case MINT_STSFLD_R8:
+	case MINT_STELEM_I1: case MINT_STELEM_U1: case MINT_STELEM_I2: case MINT_STELEM_U2: case MINT_STELEM_I4: case MINT_STELEM_I8:
+	case MINT_STELEM_R4: case MINT_STELEM_R8: case MINT_STELEM_VT_NOREF:
+	case MINT_STIND_REF: case MINT_STIND_I1: case MINT_STIND_I2: case MINT_STIND_I4: case MINT_STIND_I8: case MINT_STIND_R4: case MINT_STIND_R8:
+	case MINT_STIND_OFFSET_I1: case MINT_STIND_OFFSET_I2: case MINT_STIND_OFFSET_I4: case MINT_STIND_OFFSET_I8:
+	case MINT_STIND_OFFSET_IMM_I1: case MINT_STIND_OFFSET_IMM_I2: case MINT_STIND_OFFSET_IMM_I4: case MINT_STIND_OFFSET_IMM_I8:
+	case MINT_STOBJ_VT_NOREF:
+		return TRUE;
+	}
+	return FALSE;
+}
+/* what lockstep mode leaves to the interpreter: every opcode that writes through a pointer operand (the heap stores above, and the block
+ * copies / fills, whose destination may be the heap) -- so restoring the frame between the trace and the walker really undoes everything
+ * the trace did (review fix: MINT_CPBLK / MINT_INITBLK were compiled in lockstep, their writes done twice) */
+static gboolean
+sj_lockstep_left_out (int op)
+{
+	return sj_heap_store (op) || op == MINT_CPBLK || op == MINT_INITBLK;
+}
+static inline gboolean
+sj_compiles (int op)
+{
+	return op >= 0 && op < MINT_LASTOP && sj_stencil_of [op] >= 0;
+}
+static inline gboolean
+sj_marker (int op)
+{
+	return op == MINT_SJ_ENTRY || op == MINT_SJ_ENTER || op == MINT_SJ_NOP;
+}
+
+/* ------------------------------------------------------------------ init */
+static void sj_learn_load (void);
+
+static int
+sj_env_int (const char *name, int def, int lo, int hi)
+{
+	char *v = g_getenv (name);
+	int r = def;
+	if (v && *v) {
+		char *end = NULL;
+		long x = strtol (v, &end, 10);
+		if (end && !*end && x >= lo && x <= hi)
+			r = (int) x;
+	}
+	g_free (v);
+	return r;
+}
+
+void
+mono_shepjit_init (void)
+{
+	char *v = g_getenv ("SHEPHERD_JIT");
+	mono_shepjit_mode = 0;
+	if (v && (!strcmp (v, "1") || !strcmp (v, "on")))
+		mono_shepjit_mode = 1;
+	else if (v && !strcmp (v, "lockstep"))
+		mono_shepjit_mode = 2;
+	sj_off_reason = !v ? "SHEPHERD_JIT unset" : mono_shepjit_mode ? NULL : (!strcmp (v, "0") || !strcmp (v, "off")) ? "SHEPHERD_JIT=0" : "SHEPHERD_JIT: unknown value (off)";
+	g_free (v);
+	for (int i = 0; i < MINT_LASTOP; i++)
+		sj_stencil_of [i] = -1;
+	for (int i = 0; i < SJ_STENCIL_COUNT; i++) {
+		const SjStencil *st = &sj_stencils [i];
+		gboolean taken = FALSE;
+		for (int h = 0; h < st->nholes; h++)
+			taken |= st->holes [h].kind == SJH_TAKEN;
+		MintOpArgType at = mono_interp_opargtype [st->opcode];
+		if (taken && at != MintOpShortBranch && at != MintOpShortAndShortBranch && at != MintOpBranch)
+			continue;   /* (a branch the trace compiler cannot follow: left to the interpreter) */
+		if (!(mono_shepjit_mode == 2 && sj_lockstep_left_out (st->opcode)))
+			sj_stencil_of [st->opcode] = (gint16) i;
+	}
+	mono_shepjit_threshold = sj_env_int ("SHEPHERD_JIT_THRESHOLD", 200, 1, 1 << 30);
+	sj_min_ops = sj_env_int ("SHEPHERD_JIT_MIN_OPS", 4, 1, 4096);
+	sj_max_ops = sj_env_int ("SHEPHERD_JIT_MAX_OPS", 256, 1, 512);
+	sj_batch_ms = sj_env_int ("SHEPHERD_JIT_BATCH_MS", 4, 0, 1000);
+	sj_monitor_runs = sj_env_int ("SHEPHERD_JIT_MONITOR", 32, 0, 1 << 20);
+	sj_min_slots = sj_env_int ("SHEPHERD_JIT_MIN_SLOTS", 12, 0, 1 << 20);
+	sj_kinds = sj_env_int ("SHEPHERD_JIT_KINDS", 7, 0, 7);
+	if (mono_shepjit_mode && !sj_block) {
+		mono_shepjit_mode = 0;
+		sj_off_reason = "no code block (the host allocates it: SHEPHERD_JIT_MB)";
+	}
+	if (!mono_shepjit_mode)
+		return;
+	mono_os_mutex_init (&sj_lock);
+	mono_os_mutex_init (&sj_dump_lock);
+	mono_os_sem_init (&sj_sem, 0);
+	sj_q = g_new0 (SjTrace *, SJ_QCAP);
+	char *lp = g_getenv ("SHEPHERD_JIT_LEARN");
+	if (!lp)
+		sj_learn_path = g_strdup ("ux0:data/shepherd/cache/jit-learn.tsv");
+	else if (strcmp (lp, "0") && *lp)
+		sj_learn_path = g_strdup (lp [0] == '/' ? lp + 1 : lp);
+	g_free (lp);
+	sj_learn_load ();
+}
+
+void
+mono_shepjit_set_block (int uid, void *base, guint32 size)
+{
+	sj_block_uid = uid;
+	sj_block = (guint8 *) base;
+	sj_block_size = size;
+}
+
+void
+mono_shepjit_set_pin (void (*pin) (const char *who))
+{
+	sj_pin = pin;
+}
+
+/* ------------------------------------------------------------------ the learning cache (JIT helpers: first-use order + 'not worth it')
+ * One line per entry point a previous session decided on: H = it was compiled and paid (it is compiled at its FIRST hit next time, so the
+ * hot list is compiled in the order this session first needs it), N = it did not pay (no entry point next time: no counting, no compile,
+ * no code space). Keyed by the method's full name (FNV-1a) and the entry point's IL offset; a cache made by another stencil table
+ * (SJ_TABLE_ID) is ignored. Only which traces are compiled -- and when -- changes: every trace runs the interpreter's own opcodes. */
+typedef struct { guint32 key; gint32 il; char verdict; guint32 order; } SjLearn;
+static GHashTable *sj_learn;            /* (key ^ il * 2654435761) -> SjLearn* */
+static gboolean sj_learn_dirty;
+
+static guint32
+sj_fnv (const char *s)
+{
+	guint32 h = 2166136261u;
+	for (; s && *s; s++)
+		h = (h ^ (guint8) *s) * 16777619u;
+	return h ? h : 1;
+}
+static guint
+sj_learn_hash (gconstpointer k)
+{
+	const SjLearn *l = (const SjLearn *) k;
+	return l->key ^ ((guint32) l->il * 2654435761u);
+}
+static gboolean
+sj_learn_eq (gconstpointer a, gconstpointer b)
+{
+	const SjLearn *x = (const SjLearn *) a, *y = (const SjLearn *) b;
+	return x->key == y->key && x->il == y->il;
+}
+/* the caller holds sj_lock (or is the only thread: sj_learn_load at init) -- the compiler thread and the interpreter threads insert verdicts
+ * (sj_learn_note) while transforms look entry points up, and an insert may rehash (eglib frees the old slot array) */
+static SjLearn *
+sj_learn_find (guint32 key, gint32 il)
+{
+	if (!sj_learn)
+		return NULL;
+	SjLearn q = { key, il, 0, 0 };
+	return (SjLearn *) g_hash_table_lookup (sj_learn, &q);
+}
+/* (review fix) a transform's lookup: under the lock, the verdict copied out (0 = none) */
+static char
+sj_learn_verdict (guint32 key, gint32 il)
+{
+	if (!sj_learn || !key)
+		return 0;
+	mono_os_mutex_lock (&sj_lock);
+	SjLearn *l = sj_learn_find (key, il);
+	char v = l ? l->verdict : 0;
+	mono_os_mutex_unlock (&sj_lock);
+	return v;
+}
+static void
+sj_learn_load (void)
+{
+	sj_learn = g_hash_table_new (sj_learn_hash, sj_learn_eq);
+	if (!sj_learn_path)
+		return;
+	FILE *f = fopen (sj_learn_path, "r");
+	if (!f)
+		return;
+	char line [256];
+	gboolean ok = fgets (line, sizeof (line), f) && strstr (line, "table " SJ_TABLE_ID);
+	while (ok && fgets (line, sizeof (line), f)) {
+		char v = 0; unsigned key = 0, order = 0; int il = 0;
+		if (sscanf (line, "%c\t%x\t%d\t%u", &v, &key, &il, &order) != 4 || (v != 'H' && v != 'N'))
+			continue;
+		SjLearn *l = g_new0 (SjLearn, 1);
+		l->key = key; l->il = il; l->verdict = v; l->order = order;
+		g_hash_table_replace (sj_learn, l, l);
+		sj_st.learn_loaded++;
+	}
+	fclose (f);
+}
+static void
+sj_learn_note (SjTrace *t, char verdict)
+{
+	if (!sj_learn || !t->key)
+		return;
+	mono_os_mutex_lock (&sj_lock);
+	SjLearn *l = sj_learn_find (t->key, t->il_offset);
+	if (!l) {
+		l = g_new0 (SjLearn, 1);
+		l->key = t->key; l->il = t->il_offset;
+		g_hash_table_replace (sj_learn, l, l);
+	}
+	if (l->verdict != verdict || l->order != t->order) {
+		l->verdict = verdict; l->order = t->order;
+		sj_learn_dirty = TRUE;
+	}
+	mono_os_mutex_unlock (&sj_lock);
+}
+static void
+sj_learn_save (void)
+{
+	if (!sj_learn_path || !sj_learn_dirty)
+		return;
+	/* the text is built under the lock, the card is written without it (an interpreter thread may want the lock meanwhile) */
+	GString *g = g_string_new ("# shepjit learning cache (vita/notes/kit8-jit.md): table " SJ_TABLE_ID "; H = compile at the first hit, N = no entry point\n");
+	mono_os_mutex_lock (&sj_lock);
+	GHashTableIter it;
+	gpointer k, v;
+	guint32 n = 0;
+	g_hash_table_iter_init (&it, sj_learn);
+	while (g_hash_table_iter_next (&it, &k, &v)) {
+		SjLearn *l = (SjLearn *) v;
+		g_string_append_printf (g, "%c\t%08x\t%d\t%u\n", l->verdict, l->key, l->il, l->order);
+		n++;
+	}
+	sj_learn_dirty = FALSE;
+	mono_os_mutex_unlock (&sj_lock);
+	char tmp [520];
+	g_snprintf (tmp, sizeof (tmp), "%s.tmp", sj_learn_path);
+	FILE *f = fopen (tmp, "w");
+	if (f) {
+		fwrite (g->str, 1, g->len, f);
+		fclose (f);
+		remove (sj_learn_path);
+		rename (tmp, sj_learn_path);
+		sj_st.learn_saved = n;
+	}
+	g_string_free (g, TRUE);
+}
+
+/* ------------------------------------------------------------------ entry points (transform.c, optimized methods, after the offsets) */
+InterpInst *mono_shepjit_insert_ins_bb (TransformData *td, InterpBasicBlock *bb, InterpInst *prev_ins, int opcode);
+
+static inline gboolean
+sj_transparent (int op)
+{
+	return op == MINT_NOP || op == MINT_IL_SEQ_POINT || op == MINT_DEF || op == MINT_DUMMY_USE || op == MINT_TIER_PATCHPOINT_DATA || sj_marker (op);
+}
+
+/* how many opcodes the tier would compile from `from` (the start of bb when NULL) on, in IL order (as the compacted code is laid out) */
+static int
+sj_scan (InterpBasicBlock *bb, InterpInst *from)
+{
+	int n = 0;
+	for (; bb; bb = bb->next_bb, from = NULL)
+		for (InterpInst *ins = from ? from : bb->first_ins; ins; ins = ins->next) {
+			int op = ins->opcode;
+			if (sj_transparent (op))
+				continue;
+			if (op == MINT_MOV_SRC_OFF || op == MINT_MOV_DST_OFF)
+				op = MINT_MOV_4;   /* (emitted as a MOV_*: a compiled one) */
+			if (!sj_compiles (op))
+				return n;
+			if (++n >= sj_min_ops)
+				return n;
+		}
+	return n;
+}
+
+/* one entry point before `before` (NULL = the start of bb) */
+static void
+sj_add_entry (InterpMethod *imethod, TransformData *td, InterpBasicBlock *bb, InterpInst *after, int kind, guint32 key, int il)
+{
+	char verdict = sj_learn_verdict (key, il);
+	if (verdict == 'N') {
+		sj_st.learned_off++;   /* a previous session found it does not pay: no entry point */
+		return;
+	}
+	SjTrace *t = g_new0 (SjTrace, 1);
+	t->fn = sj_skip;
+	t->kind = (guint16) kind;
+	t->il_offset = il;
+	t->key = key;
+	t->threshold = mono_shepjit_threshold;
+	if (verdict == 'H') {
+		t->threshold = 1;   /* hot last time: compiled at its first hit (first-use order) */
+		sj_st.learned_hot++;
+	}
+	InterpInst *ins = mono_shepjit_insert_ins_bb (td, bb, after, MINT_SJ_ENTRY);
+	guint32 p = (guint32) (gsize) t;
+	ins->data [0] = (guint16) p;
+	ins->data [1] = (guint16) (p >> 16);
+	mono_os_mutex_lock (&sj_lock);
+	t->next_all = sj_all;
+	sj_all = t;
+	mono_os_mutex_unlock (&sj_lock);
+	sj_st.entry_points [kind]++;
+}
+
+/* transform.c: compute_native_offset_estimates (the IR size in slots, as generate_compacted_code will allocate it) */
+int mono_shepjit_code_size_estimate (TransformData *td);
+
+/* the entry points of one method: with insert FALSE only counted (the same walk: an inserted MINT_SJ_ENTRY is transparent to it), with
+ * insert TRUE placed; returns how many */
+static int
+sj_place_entry_points (InterpMethod *imethod, TransformData *td, guint32 key, gboolean insert)
+{
+	gboolean after_call = FALSE;
+	int added = 0;
+	for (InterpBasicBlock *bb = td->entry_bb; bb; bb = bb->next_bb) {
+		int kind = -1;
+		if (bb == td->entry_bb && (sj_kinds & 1))
+			kind = SJ_K_ENTRY;
+		else if (bb->backwards_branch_target && (sj_kinds & 2))
+			kind = SJ_K_LOOP;
+		else if (after_call && (sj_kinds & 4))
+			kind = SJ_K_RESUME;
+		after_call = bb->contains_call_instruction;
+		if (!bb->first_ins)
+			continue;
+		if (kind >= 0 && sj_scan (bb, NULL) >= sj_min_ops) {
+			if (insert)
+				sj_add_entry (imethod, td, bb, NULL, kind, key, bb->il_offset);
+			added++;
+		}
+		/* right after each instruction the tier does not compile (a call, a type check ...), where a long enough run starts: the
+		 * interpreter runs that instruction, then the next trace takes over (the jiterpreter waits for the next basic block) */
+		if (sj_kinds & 4) {
+			for (InterpInst *ins = bb->first_ins; ins && ins->next; ins = ins->next) {
+				int op = ins->opcode;
+				if (sj_transparent (op) || op == MINT_MOV_SRC_OFF || op == MINT_MOV_DST_OFF || sj_compiles (op))
+					continue;
+				InterpInst *nx = ins->next;
+				while (nx && sj_transparent (nx->opcode))
+					nx = nx->next;
+				if (!nx || sj_scan (bb, nx) < sj_min_ops)
+					continue;
+				if (insert)
+					sj_add_entry (imethod, td, bb, ins, SJ_K_RESUME, key, nx->il_offset >= 0 ? nx->il_offset : bb->il_offset);
+				added++;
+			}
+		}
+	}
+	return added;
+}
+
+void
+mono_shepjit_insert_entry_points (InterpMethod *imethod, void *_td)
+{
+	TransformData *td = (TransformData *) _td;
+	if (!mono_shepjit_mode || imethod->method->dynamic)
+		return;
+	int planned = sj_place_entry_points (imethod, td, 0, FALSE);
+	if (!planned)
+		return;
+	/* (review fix) the superinstruction pass already chose the short-only safepoint branches (MINT_*_SP, *_IMM_SP: a 16-bit offset and
+	 * nothing else) from the IR size BEFORE these 3-slot entry points; generate_compacted_code would give an SP branch whose offset then
+	 * no longer fits 16 bits a 32-bit offset -- one slot too many in a fixed-length instruction, every later one misdecoded. Every branch offset
+	 * lies within the method's IR, so when the IR (estimated as generate_compacted_code allocates it, plus 3 slots per possible entry
+	 * point) stays within 32767 slots every offset fits; a larger method that contains an SP branch gets no entry points (counted on J2) */
+	int size = mono_shepjit_code_size_estimate (td);
+	if (size + 3 * planned > G_MAXINT16) {
+		for (InterpBasicBlock *bb = td->entry_bb; bb; bb = bb->next_bb)
+			for (InterpInst *ins = bb->first_ins; ins; ins = ins->next)
+				if (MINT_IS_SUPER_BRANCH (ins->opcode)) {
+					sj_st.sp_guard++;
+					return;
+				}
+	}
+	guint32 key = 0;
+	guint lsize = 0;
+	if (sj_learn) {
+		mono_os_mutex_lock (&sj_lock);
+		lsize = g_hash_table_size (sj_learn);
+		mono_os_mutex_unlock (&sj_lock);
+	}
+	if (lsize) {
+		char *name = mono_method_full_name (imethod->method, TRUE);
+		key = sj_fnv (name);
+		g_free (name);
+	}
+	if (sj_place_entry_points (imethod, td, key, TRUE))
+		sj_st.methods++;
+}
+
+/* ------------------------------------------------------------------ the queue (interpreter threads) */
+static void sj_thread_start (void);
+
+void
+mono_shepjit_queue (SjTrace *t)
+{
+	/* called by MINT_SJ_ENTRY when the hit count reaches the threshold; the handler stored ip / imethod first */
+	if (mono_atomic_cas_i32 (&t->state, SJ_S_QUEUED, SJ_S_COUNTING) != SJ_S_COUNTING)
+		return;
+	if (G_UNLIKELY (sj_thread_failed)) {
+		/* (review fix) no compiler thread: this entry point stops counting (nothing would ever compile it) */
+		t->state = SJ_S_OFF_NOTHREAD;
+		sj_set_opcode (t, MINT_SJ_NOP);
+		return;
+	}
+	if (!t->name)   /* (review fix: once -- a retry after a full queue used to build and leak it again on every hit) */
+		t->name = mono_method_full_name (t->imethod->method, TRUE);   /* (here, on the interpreter thread: the compiler never calls into the runtime) */
+	if (!t->key)
+		t->key = sj_fnv (t->name);
+	mono_os_mutex_lock (&sj_lock);
+	gboolean ok = sj_qtail - sj_qhead < SJ_QCAP;
+	if (ok) {
+		t->order = ++sj_order;
+		sj_q [sj_qtail++ % SJ_QCAP] = t;
+		sj_st.queued++;
+	} else
+		sj_st.queue_full++;
+	mono_os_mutex_unlock (&sj_lock);
+	if (!ok) {
+		/* the queue is full: count on, and try again only after another SHEPHERD_JIT_THRESHOLD hits (review fix: not on every hit) */
+		gint32 h = t->hits;
+		t->threshold = h < G_MAXINT32 - mono_shepjit_threshold ? h + mono_shepjit_threshold : G_MAXINT32;
+		mono_memory_barrier ();
+		t->state = SJ_S_COUNTING;
+		return;
+	}
+	if (!sj_thread_started)
+		sj_thread_start ();
+	mono_os_sem_post (&sj_sem);
+}
+
+/* ------------------------------------------------------------------ the compiler (the compiler thread only) */
+#define SJ_STAGE_CAP (128 * 1024)
+#define SJ_SCRATCH_CAP (48 * 1024)
+static guint8 *sj_stage, *sj_scratch;
+static guint32 sj_stage_used, sj_stage_base;   /* the staged bytes go to sj_block + sj_stage_base */
+#define SJ_BATCH_CAP 512
+static SjTrace **sj_batch;        /* (heap, with the compiler's work arrays: sj_thread_start) */
+static int sj_batch_n;
+
+typedef struct { guint32 off; guint8 kind; guint8 cond; guint16 op; const guint16 *target; } SjFix;
+typedef struct { const guint16 *ip; guint32 off; } SjMap;
+/* the compiler's work arrays (heap, sj_thread_start / the harness): one trace at a time */
+#define SJ_W_MAP 1024          /* compiled instructions + markers in one trace (>= sj_max_ops + markers) */
+#define SJ_W_FIX 4096          /* branch holes in one trace */
+static SjMap *sj_w_map, *sj_w_stubs;
+static guint32 *sj_w_op_off;
+static SjFix *sj_w_fix;
+static void
+sj_work_alloc (void)
+{
+	if (sj_w_map)
+		return;
+	sj_w_map = g_new0 (SjMap, SJ_W_MAP);
+	sj_w_stubs = g_new0 (SjMap, SJ_W_MAP);
+	sj_w_op_off = g_new0 (guint32, SJ_W_MAP);
+	sj_w_fix = g_new0 (SjFix, SJ_W_FIX);
+}
+
+static int
+sj_map_find (SjMap *map, int n, const guint16 *ip)
+{
+	int lo = 0, hi = n - 1;
+	while (lo <= hi) {
+		int mid = (lo + hi) / 2;
+		if (map [mid].ip == ip) return mid;
+		if (map [mid].ip < ip) lo = mid + 1; else hi = mid - 1;
+	}
+	return -1;
+}
+
+/* an exit stub: return (exit ip - entry ip) in bytes to MINT_SJ_ENTER */
+static int
+sj_emit_exit (guint8 *buf, int off, ptrdiff_t disp)
+{
+	guint32 d = (guint32) disp;
+	wr16 (buf + off, 0xf240); wr16 (buf + off + 2, 0x0000); sj_put_imm16 (buf + off, d & 0xffff); off += 4;          /* movw r0, #lo */
+	if (d >> 16) { wr16 (buf + off, 0xf2c0); wr16 (buf + off + 2, 0x0000); sj_put_imm16 (buf + off, d >> 16); off += 4; }   /* movt r0, #hi */
+	wr16 (buf + off, 0x4770); off += 2;                                                                                 /* bx lr */
+	return off;
+}
+
+/* compile t into buf (its code will live at final address addr); returns the size, 0 = not compiled (t->state says why) */
+static int
+sj_compile (SjTrace *t, guint8 *buf, int cap, gsize addr)
+{
+	SjMap *map = sj_w_map;
+	guint32 *op_off = sj_w_op_off;
+	SjFix *fix = sj_w_fix;
+	SjMap *stubs = sj_w_stubs;
+	InterpMethod *im = t->imethod;
+	const guint16 *code_end = (const guint16 *) ((guint8 *) im->jinfo->code_start + im->jinfo->code_size);
+	const guint16 *ip = t->ip + 3;
+	int nmap = 0, nfix = 0, nstub = 0, nops = 0, off = 0;
+	wr16 (buf, 0x4608); off = 2;                     /* mov r0, r1: the stencils take the locals in r0 (the interpreter passes frame, locals, trace) */
+	map [nmap].ip = t->ip; map [nmap++].off = 2;     /* the entry opcode itself (a loop's back branch lands on it): after the MOV */
+	const guint16 *abort_ip = NULL;
+	int abort_op = -1;
+	while (1) {
+		if (ip >= code_end) { abort_ip = ip; abort_op = MINT_LASTOP; break; }
+		int op = *ip;
+		if (sj_marker (op)) {   /* another entry point inside the trace: nothing to run, its ip maps to the next instruction */
+			map [nmap].ip = ip; map [nmap++].off = (guint32) off;
+			ip += 3;
+			continue;
+		}
+		if (!sj_compiles (op) || nops >= sj_max_ops || nmap >= SJ_W_MAP - 2 || nfix >= SJ_W_FIX - 16) { abort_ip = ip; abort_op = op; break; }
+		const SjStencil *st = &sj_stencils [sj_stencil_of [op]];
+		if (off + st->len + 4 + 16 > cap) { abort_ip = ip; abort_op = op; break; }
+		if (st->align4 && (off & 2)) { wr16 (buf + off, 0xbf00); off += 2; }   /* nop: its literal pool stays 4-aligned */
+		map [nmap].ip = ip; map [nmap++].off = (guint32) off;
+		op_off [nops] = (guint32) off;
+		memcpy (buf + off, st->code, st->len);
+		for (int h = 0; h < st->nholes; h++) {
+			const SjHole *ho = &st->holes [h];
+			guint8 *p = buf + off + ho->off;
+			switch (ho->kind) {
+			case SJH_A16: sj_put_imm16 (p, ip [ho->arg]); break;
+			case SJH_W32_LO: sj_put_imm16 (p, (guint32) READ32 (ip + ho->arg) & 0xffff); break;
+			case SJH_W32_HI: sj_put_imm16 (p, (guint32) READ32 (ip + ho->arg) >> 16); break;
+			case SJH_DATA_LO: sj_put_imm16 (p, (guint32) (gsize) im->data_items [ip [ho->arg]] & 0xffff); break;
+			case SJH_DATA_HI: sj_put_imm16 (p, (guint32) (gsize) im->data_items [ip [ho->arg]] >> 16); break;
+			case SJH_HELPER_LO: sj_put_imm16 (p, (guint32) (gsize) sj_helper_addr [ho->arg] & 0xffff); break;
+			case SJH_HELPER_HI: sj_put_imm16 (p, (guint32) (gsize) sj_helper_addr [ho->arg] >> 16); break;
+			case SJH_CONT: case SJH_TAKEN: case SJH_EXIT: {
+				SjFix *f = &fix [nfix++];
+				f->off = (guint32) (off + ho->off); f->kind = ho->kind; f->cond = ho->arg; f->op = (guint16) nops; f->target = NULL;
+				if (ho->kind == SJH_EXIT)
+					f->target = ip;
+				else if (ho->kind == SJH_TAKEN) {
+					int len = mono_interp_oplen [op];
+					MintOpArgType at = mono_interp_opargtype [op];
+					f->target = (at == MintOpShortBranch || at == MintOpShortAndShortBranch) ? ip + (gint16) ip [len - 1] : ip + (gint32) READ32 (ip + len - 2);
+				}
+				break;
+			}
+			}
+		}
+		off += st->len;
+		nops++;
+		ip += mono_interp_oplen [op];
+	}
+	t->abort_op = (guint16) abort_op;
+	if (abort_op >= 0 && abort_op < MINT_LASTOP)
+		sj_st.abort_hist [abort_op]++;
+	if (nops < sj_min_ops) {
+		t->state = SJ_S_OFF_SHORT;
+		return 0;
+	}
+	t->nops = (guint16) nops;
+	t->full_slots = (guint32) (abort_ip - t->ip);
+	guint32 stencil_bytes = (guint32) off;
+	/* the CONT of the last instruction goes to the abort exit, which comes right after it (a stripped CONT falls through into it) */
+	int abort_stub = off;
+	stubs [nstub].ip = abort_ip; stubs [nstub++].off = (guint32) off;
+	off = sj_emit_exit (buf, off, (abort_ip - t->ip) * (ptrdiff_t) sizeof (guint16));
+	/* resolve the branches */
+	for (int i = 0; i < nfix; i++) {
+		SjFix *f = &fix [i];
+		guint32 target_off;
+		if (f->kind == SJH_CONT) {
+			target_off = f->op + 1 < nops ? op_off [f->op + 1] : (guint32) abort_stub;
+		} else {
+			const guint16 *tip = f->target;
+			int k = (f->kind == SJH_TAKEN && tip >= t->ip && tip < abort_ip) ? sj_map_find (map, nmap, tip) : -1;
+			if (k >= 0)
+				target_off = map [k].off;
+			else {
+				int s;
+				for (s = 0; s < nstub; s++)
+					if (stubs [s].ip == tip) break;
+				if (s == nstub) {
+					if (nstub >= SJ_W_MAP || off + 12 > cap) { t->state = SJ_S_OFF_SHORT; return 0; }
+					if (off & 2) { wr16 (buf + off, 0xbf00); off += 2; }
+					stubs [nstub].ip = tip; stubs [nstub++].off = (guint32) off;
+					off = sj_emit_exit (buf, off, (tip - t->ip) * (ptrdiff_t) sizeof (guint16));
+				}
+				target_off = stubs [s].off;
+			}
+		}
+		if (!sj_put_branch (buf + f->off, addr + f->off, addr + target_off, f->cond)) {
+			t->state = SJ_S_OFF_SHORT;
+			return 0;
+		}
+	}
+	if (off & 2) { wr16 (buf + off, 0xbf00); off += 2; }
+	sj_st.ops += (guint64) nops;
+	sj_st.stencil_bytes += stencil_bytes;
+	sj_st.stub_bytes += (guint64) (off - stencil_bytes);
+	t->code_bytes = (guint16) MIN (off, 65535);
+	return off;
+}
+
+static gint64
+sj_now_us (void)
+{
+	return mono_100ns_ticks () / 10;
+}
+
+/* publish the staged batch: ONE Open / copy / Sync / Close window, then switch the entry points */
+static void
+sj_publish (void)
+{
+	if (!sj_batch_n)
+		return;
+	gint64 t0 = sj_now_us ();
+	int rc_open = SJ_OPEN ();
+	int ok = rc_open >= 0;
+	if (ok) {
+		memcpy (sj_block + sj_stage_base, sj_stage, sj_stage_used);
+		int rc_sync = SJ_SYNC (sj_block + sj_stage_base, sj_stage_used);
+		int rc_close = SJ_CLOSE ();
+		ok = rc_sync >= 0 && rc_close >= 0;
+	}
+	gint64 dt = sj_now_us () - t0;
+	sj_st.window_us += (guint64) dt;
+	if ((guint64) dt > sj_st.max_window_us)
+		sj_st.max_window_us = (guint64) dt;
+	sj_st.batches++;
+	if ((guint32) sj_batch_n > sj_st.max_batch)
+		sj_st.max_batch = (guint32) sj_batch_n;
+	for (int i = 0; i < sj_batch_n; i++) {
+		SjTrace *t = sj_batch [i];
+		if (!ok) {
+			t->state = SJ_S_OFF_FULL;
+			sj_set_opcode (t, MINT_SJ_NOP);
+			continue;
+		}
+		if (mono_shepjit_mode == 2) {
+			t->fn = sj_lockstep;
+			t->state = SJ_S_LIVE;
+			sj_st.live++;
+		} else if (sj_monitor_runs > 0) {
+			t->fn = sj_monitor;
+			t->state = SJ_S_MONITOR;
+		} else {
+			t->fn = sj_code_fn (t);
+			t->state = SJ_S_LIVE;
+			sj_st.live++;
+			sj_learn_note (t, 'H');
+		}
+		sj_set_opcode (t, MINT_SJ_ENTER);
+	}
+	if (!ok)
+		sj_st.windows_failed++;
+	sj_stage_base += sj_stage_used;
+	sj_stage_used = 0;
+	sj_batch_n = 0;
+}
+
+static void
+sj_compile_one (SjTrace *t)
+{
+	gint64 t0 = sj_now_us ();
+	guint32 used = sj_stage_base + sj_stage_used;   /* (= sj_block_used; review fix: the staged bytes were counted twice here) */
+	if (used + SJ_SCRATCH_CAP > sj_block_size) {
+		/* not enough room for a worst-case trace: compile into what is left, or give up */
+		if (used + 256 > sj_block_size) {
+			t->state = SJ_S_OFF_FULL;
+			sj_st.full_off++;
+			sj_set_opcode (t, MINT_SJ_NOP);
+			return;
+		}
+	}
+	if (sj_stage_used + SJ_SCRATCH_CAP > SJ_STAGE_CAP || sj_batch_n == SJ_BATCH_CAP)
+		sj_publish ();
+	guint32 room = MIN ((guint32) SJ_SCRATCH_CAP, sj_block_size - (sj_stage_base + sj_stage_used));
+	gsize addr = (gsize) sj_block + sj_stage_base + sj_stage_used;
+	int n = sj_compile (t, sj_scratch, (int) room, addr);
+	sj_st.compile_us += (guint64) (sj_now_us () - t0);
+	if (n <= 0) {
+		if (t->state == SJ_S_OFF_SHORT) {
+			sj_st.short_off++;
+			sj_learn_note (t, 'N');
+		}
+		sj_set_opcode (t, MINT_SJ_NOP);
+		return;
+	}
+	memcpy (sj_stage + sj_stage_used, sj_scratch, (size_t) n);
+	t->code = (gpointer) addr;
+	sj_stage_used += (guint32) n;
+	sj_block_used = sj_stage_base + sj_stage_used;
+	sj_st.code_bytes += (guint64) n;
+	sj_st.compiled++;
+	sj_batch [sj_batch_n++] = t;
+}
+
+static void sj_write_dump (void);
+
+static void *
+sj_thread (void *arg)
+{
+	if (sj_pin)
+		sj_pin ("jit-compiler");
+	gint64 last_dump = sj_now_us ();
+	for (;;) {
+		mono_os_sem_timedwait (&sj_sem, 10000, MONO_SEM_FLAGS_NONE);
+		if (sj_batch_ms > 0)
+			g_usleep ((gulong) sj_batch_ms * 1000);   /* gather a batch: the next requests of the same frame come in meanwhile */
+		for (;;) {
+			SjTrace *t = NULL;
+			mono_os_mutex_lock (&sj_lock);
+			if (sj_qhead != sj_qtail)
+				t = sj_q [sj_qhead++ % SJ_QCAP];
+			mono_os_mutex_unlock (&sj_lock);
+			if (!t)
+				break;
+			sj_compile_one (t);
+		}
+		sj_publish ();
+		if (sj_now_us () - last_dump > 60 * 1000 * 1000) {   /* (the tables and the learning cache, from this thread: never the main one) */
+			/* (review fix) one writer at a time: the end's dump (mono_shepjit_dump, the main thread) holds the lock -- skip this round */
+			if (mono_os_mutex_trylock (&sj_dump_lock) == 0) {
+				sj_write_dump ();
+				sj_learn_save ();
+				mono_os_mutex_unlock (&sj_dump_lock);
+			}
+			last_dump = sj_now_us ();
+		}
+	}
+	return NULL;
+}
+
+static void
+sj_thread_start (void)
+{
+	mono_os_mutex_lock (&sj_lock);
+	if (!sj_thread_started && !sj_thread_failed) {
+		/* (review fix) one try: the buffers are allocated once, and a failed pthread_create switches the tier off (J2 says so) instead
+		 * of allocating them again -- 178 KiB each time -- at every later queue */
+		if (!sj_stage) {
+			sj_stage = (guint8 *) g_malloc (SJ_STAGE_CAP);
+			sj_scratch = (guint8 *) g_malloc (SJ_SCRATCH_CAP);
+			sj_batch = g_new0 (SjTrace *, SJ_BATCH_CAP);
+			sj_work_alloc ();
+		}
+		pthread_t th;
+		pthread_attr_t a;
+		pthread_attr_init (&a);
+		pthread_attr_setstacksize (&a, 64 * 1024);
+		pthread_attr_setdetachstate (&a, PTHREAD_CREATE_DETACHED);
+		int rc = pthread_create (&th, &a, sj_thread, NULL);
+		if (rc == 0)
+			sj_thread_started = 1;
+		else
+			sj_thread_failed = rc > 0 ? rc : -1;
+		pthread_attr_destroy (&a);
+	}
+	mono_os_mutex_unlock (&sj_lock);
+}
+
+/* ------------------------------------------------------------------ monitoring: compile only the loops that pay off */
+static ptrdiff_t
+sj_monitor (InterpFrame *frame, unsigned char *locals, SjTrace *t)
+{
+	ptrdiff_t r = sj_code_fn (t) (frame, locals, t);
+	/* (review fix) a run that leaves backwards (a loop's back edge out of the trace: a negative result, which used to become ~4e9 slots
+	 * and keep any trace live) or forward beyond the trace counts as reaching the trace's end -- at most full_slots per run */
+	ptrdiff_t s = r / (ptrdiff_t) sizeof (guint16);
+	guint32 slots = (s < 0 || s > (ptrdiff_t) t->full_slots) ? t->full_slots : (guint32) s;
+	t->mon_slots += slots > 3 ? slots - 3 : 0;
+	if (++t->mon_runs == (guint32) sj_monitor_runs) {
+		guint64 avg = t->mon_slots / t->mon_runs;
+		if ((int) avg < sj_min_slots) {
+			t->state = SJ_S_OFF_PENALTY;
+			t->fn = sj_skip;
+			sj_set_opcode (t, MINT_SJ_NOP);
+			sj_st.penalty_off++;
+			sj_learn_note (t, 'N');
+		} else {
+			t->fn = sj_code_fn (t);
+			t->state = SJ_S_LIVE;
+			sj_st.live++;
+			sj_learn_note (t, 'H');
+		}
+	}
+	return r;
+}
+
+/* ------------------------------------------------------------------ lockstep: the interpreter's walker (the interpreter's primitives) */
+#define SJ_IP(n) ip [n]
+#define SJ_IP32(n) READ32 (ip + n)
+#define SJ_IP64(n) READ64 (ip + n)
+#define SJ_DATA(n) frame->imethod->data_items [ip [n]]
+#define SJ_NEXT(len) ip += len
+#define SJ_BRANCH(off) ip += off
+#define SJ_THROW_DIVIDE_BY_ZERO() return ip
+#define SJ_THROW_OVERFLOW() return ip
+#define SJ_THROW_INDEX_OUT_OF_RANGE() return ip
+#define SJ_THROW_ARGUMENT_OUT_OF_RANGE_LENGTH() return ip
+#define SJ_THROW_NULL_REFERENCE() return ip
+#define NULL_CHECK(o) do { if (G_UNLIKELY (!(o))) return ip; } while (0)
+#define INIT_VTABLE(vtable) do { if (G_UNLIKELY (!(vtable)->initialized)) return ip; } while (0)
+#define SAFEPOINT do { if (G_UNLIKELY (mono_polling_required)) return ip; } while (0)
+#define BACK_BRANCH_PROFILE(offset)
+#define LOCAL_VAR(offset,type) (*(type*)(locals + (offset)))
+#include "shepjit-ops.h"
+
+/* runs the interpreter's bodies from ip while ip stays in [lo, hi) -- the instructions the trace compiled; returns where it stopped (the
+ * trace stops at the same place: an instruction it did not compile, a branch out, or a check that would throw / poll) */
+static const guint16 *
+sj_walk (InterpFrame *frame, unsigned char *locals, const guint16 *ip, const guint16 *lo, const guint16 *hi)
+{
+	for (;;) {
+		if (ip < lo || ip >= hi)
+			return ip;
+		switch (*ip) {
+		case MINT_SJ_ENTRY: case MINT_SJ_ENTER: case MINT_SJ_NOP:
+			ip += 3;
+			break;
+#define SJ_WALK_CASE(op) case op: { SJOP_##op; } break;
+		SJ_OPS (SJ_WALK_CASE)
+		default:
+			return ip;
+		}
+	}
+}
+
+
+static ptrdiff_t
+sj_lockstep (InterpFrame *frame, unsigned char *locals, SjTrace *t)
+{
+	/* both on the REAL frame, one after the other (a pointer into the frame, and anything computed from it, is then the same in both;
+	 * lockstep traces compile nothing that writes through a pointer -- no heap store, no block copy / fill -- so restoring the frame
+	 * undoes everything a trace did): the trace first, its frame saved, the frame restored, then the interpreter's walker -- whose result
+	 * the program keeps. Another thread may change shared memory (a concurrent queue's counter) or ask for a safepoint between the two
+	 * runs: a disagreement is therefore run again (frame restored, trace, frame restored, walker) up to twice; one that agrees on a repeat
+	 * is counted as such a race, one that never agrees is a MISMATCH (logged; the trace is switched off). (review fix) Every race is
+	 * logged too (the first 64), with the trace's run number: a race on a trace's FIRST run is what stale code or a publishing fault
+	 * would look like (wrong once, right when repeated), so those are counted on their own ("on a first run", J2). */
+	guint32 sz = t->imethod->alloca_size;
+	guint8 *before = (guint8 *) g_malloc (2 * (gsize) sz + 16);   /* (a test mode: one allocation per run) */
+	guint8 *after = before + sz + 8;
+	memcpy (before, locals, sz);
+	const guint16 *end = t->ip + t->full_slots;
+	ptrdiff_t r_trace = 0, r_interp = 0, r_trace0 = 0, r_interp0 = 0;
+	const guint16 *wip = NULL;
+	int diff_at = -1, diff_at0 = -1, attempt;
+	guint32 run = ++t->mon_runs;   /* (racy: a report only) */
+	sj_st.lock_runs++;
+	for (attempt = 0; attempt < 3; attempt++) {
+		if (attempt)
+			memcpy (locals, before, sz);
+		r_trace = sj_code_fn (t) (frame, locals, t);
+		memcpy (after, locals, sz);
+		memcpy (locals, before, sz);
+		wip = sj_walk (frame, locals, t->ip, t->ip, end);
+		r_interp = (wip - t->ip) * (ptrdiff_t) sizeof (guint16);
+		diff_at = -1;
+		for (guint32 i = 0; i < sz && diff_at < 0; i++)
+			if (after [i] != locals [i])
+				diff_at = (int) (i & ~3u);
+		if (r_trace == r_interp && diff_at < 0)
+			break;
+		if (!attempt) {
+			r_trace0 = r_trace; r_interp0 = r_interp; diff_at0 = diff_at;
+		}
+	}
+	if (attempt > 0 && attempt < 3) {
+		guint64 nr = ++sj_st.lock_sp_races;   /* agreed when repeated: another thread raced the pair (shared memory or a safepoint request) */
+		if (run == 1)
+			sj_st.lock_first_races++;
+		if (nr <= 64)
+			g_print ("[shepjit] LOCKSTEP RACE %llu: %s entry +%d (kind %d, %d ops), run %u of this trace%s: try 1 trace exit +%d, interpreter exit +%d, frame byte %d; agreed on try %d\n",
+				 (unsigned long long) nr, t->name ? t->name : "?", (int) (t->ip - (guint16 *) t->imethod->jinfo->code_start), t->kind, t->nops, run,
+				 run == 1 ? " (ITS FIRST RUN)" : "", (int) (r_trace0 / 2), (int) (r_interp0 / 2), diff_at0, attempt + 1);
+	} else if (attempt == 3) {
+		sj_st.lock_mismatch++;
+		g_print ("[shepjit] LOCKSTEP MISMATCH %s entry +%d (kind %d, %d ops): trace exit +%d, interpreter exit +%d, frame byte %d: trace %08x interpreter %08x (3 tries)\n",
+			 t->name ? t->name : "?", (int) (t->ip - (guint16 *) t->imethod->jinfo->code_start), t->kind, t->nops,
+			 (int) (r_trace / 2), (int) (r_interp / 2), diff_at, diff_at >= 0 ? *(guint32 *) (after + diff_at) : 0, diff_at >= 0 ? *(guint32 *) (locals + diff_at) : 0);
+		t->state = SJ_S_OFF_LOCKSTEP;
+		t->fn = sj_skip;
+		sj_set_opcode (t, MINT_SJ_NOP);
+		sj_st.lockstep_off++;
+	}
+	g_free (before);
+	return r_interp;   /* the program goes on with the interpreter's result */
+}
+
+/* ------------------------------------------------------------------ reports */
+static const char *
+sj_kind_name (int k)
+{
+	return k == SJ_K_ENTRY ? "entry" : k == SJ_K_LOOP ? "loop" : "resume";
+}
+
+int
+mono_shepjit_report (char *buf, int len)
+{
+	if (!mono_shepjit_mode)
+		return g_snprintf (buf, (gulong) len, "off (%s)", sj_off_reason ? sj_off_reason : "?");
+	int n = g_snprintf (buf, (gulong) len,
+		"%s: entry points %u in %u methods (entry %u, loop %u, resume %u), queued %u, compiled %u (%llu ops: %llu B of stencils + %llu B of exits), live %u, "
+		"off: short %u, not worth it %u, block full %u, lockstep %u; learning cache: %u read, %u hot entry points compiled at the first hit, %u skipped, %u saved; "
+		"block %u of %u KiB; %u windows (max %u traces; %llu us in all, max %llu us; %u failed), compile %llu us",
+		mono_shepjit_mode == 2 ? "lockstep" : "on",
+		sj_st.entry_points [0] + sj_st.entry_points [1] + sj_st.entry_points [2], sj_st.methods, sj_st.entry_points [0], sj_st.entry_points [1], sj_st.entry_points [2],
+		sj_st.queued, sj_st.compiled, (unsigned long long) sj_st.ops, (unsigned long long) sj_st.stencil_bytes, (unsigned long long) sj_st.stub_bytes, sj_st.live,
+		sj_st.short_off, sj_st.penalty_off, sj_st.full_off, sj_st.lockstep_off, sj_st.learn_loaded, sj_st.learned_hot, sj_st.learned_off, sj_st.learn_saved,
+		sj_block_used / 1024, sj_block_size / 1024,
+		sj_st.batches, sj_st.max_batch, (unsigned long long) sj_st.window_us, (unsigned long long) sj_st.max_window_us, sj_st.windows_failed, (unsigned long long) sj_st.compile_us);
+	/* (review fix) the guards: methods left without entry points by the SP-branch guard, queue-full retries, a compiler thread that
+	 * could not be created */
+	if (n > 0 && n < len)
+		n += g_snprintf (buf + n, (gulong) (len - n), "; guards: SP-branch methods skipped %u, queue full %u%s", sj_st.sp_guard, sj_st.queue_full,
+			sj_thread_failed ? ", COMPILER THREAD NOT CREATED (nothing compiled)" : "");
+	if (mono_shepjit_mode == 2 && n > 0 && n < len)
+		n += g_snprintf (buf + n, (gulong) (len - n), "; lockstep runs %llu, MISMATCHES %llu (disagreed 3 times), races %llu (disagreed once, agreed when repeated: another thread or a safepoint request between the two runs), on a first run %llu (stale-code signature: must be 0)",
+			(unsigned long long) sj_st.lock_runs, (unsigned long long) sj_st.lock_mismatch, (unsigned long long) sj_st.lock_sp_races, (unsigned long long) sj_st.lock_first_races);
+	return n;
+}
+
+static void
+sj_write_dump (void)
+{
+	char path [512];
+	char *d = g_getenv ("SHEPHERD_LOG_DIR");
+	const char *dir = d ? (d [0] == '/' ? d + 1 : d) : "ux0:data/shepherd/runtime/logs";
+	char line [1024];
+	mono_shepjit_report (line, sizeof (line));
+	GString *g = g_string_new (NULL);
+	g_string_append_printf (g, "# %s\n", line);
+	g_string_append (g, "#order\tstate\tkind\thits\tops\tbytes\tfull_slots\tmon_runs\tmon_avg_slots\tabort\tentry\til\tmethod\n");
+	/* the text is built under the lock, the card is written without it */
+	mono_os_mutex_lock (&sj_lock);
+	for (SjTrace *t = sj_all; t; t = t->next_all) {
+		if (t->state == SJ_S_COUNTING)
+			continue;
+		g_string_append_printf (g, "%u\t%d\t%s\t%d\t%u\t%u\t%u\t%u\t%llu\t%s\t%d\t%d\t%s\n", t->order, t->state, sj_kind_name (t->kind), t->hits, t->nops, t->code_bytes,
+			 t->full_slots, t->mon_runs, t->mon_runs ? (unsigned long long) (t->mon_slots / t->mon_runs) : 0ull,
+			 t->abort_op < MINT_LASTOP ? mono_interp_opname (t->abort_op) : "end",
+			 t->imethod && t->imethod->jinfo ? (int) (t->ip - (guint16 *) t->imethod->jinfo->code_start) : -1, t->il_offset, t->name ? t->name : "?");
+	}
+	mono_os_mutex_unlock (&sj_lock);
+	g_snprintf (path, sizeof (path), "%s/shepjit-traces.tsv", dir);
+	FILE *f = fopen (path, "w");
+	if (f) {
+		fwrite (g->str, 1, g->len, f);
+		fclose (f);
+	}
+	g_string_truncate (g, 0);
+	g_string_append (g, "# the opcode that ended each compiled or rejected trace (the next stencils to add)\n");
+	for (int i = 0; i < MINT_LASTOP; i++)
+		if (sj_st.abort_hist [i])
+			g_string_append_printf (g, "%u\t%s\n", sj_st.abort_hist [i], mono_interp_opname (i));
+	g_snprintf (path, sizeof (path), "%s/shepjit-aborts.tsv", dir);
+	f = fopen (path, "w");
+	if (f) {
+		fwrite (g->str, 1, g->len, f);
+		fclose (f);
+	}
+	g_string_free (g, TRUE);
+	g_free (d);
+}
+
+void
+mono_shepjit_dump (void)
+{
+	if (mono_shepjit_mode) {
+		mono_os_mutex_lock (&sj_dump_lock);   /* (review fix) waits for a periodic dump of the compiler thread to finish */
+		sj_write_dump ();
+		sj_learn_save ();
+		mono_os_mutex_unlock (&sj_dump_lock);
+	}
+}
diff --git a/src/mono/mono/mini/interp/shepjit.h b/src/mono/mono/mini/interp/shepjit.h
new file mode 100644
index 0000000..abfb533
--- /dev/null
+++ b/src/mono/mono/mini/interp/shepjit.h
@@ -0,0 +1,68 @@
+/*
+ * shepjit.h: SHEPHERD-VITA device kit #8 (vita/notes/kit8-jit.md) -- the baseline JIT tier of the Mono interpreter.
+ *
+ * A copy-and-patch trace compiler UNDER the interpreter: transform.c puts trace entry points (MINT_SJ_ENTRY) at method entries, loop heads
+ * and after calls of optimized methods; an entry point that runs often enough is compiled on a background thread from the interpreter's
+ * own opcode bodies (shepjit-ops.h -> shepjit-stencils.inc) into the ForVM code block, published in batches, and from then on the entry
+ * point (MINT_SJ_ENTER) runs it. A trace works on the interpreter's frame (the same locals, the same slots), never throws (every check
+ * that would throw leaves the trace AT that instruction and the interpreter runs it), and returns how far it got, so the interpreter
+ * continues exactly where the trace stopped. SHEPHERD_JIT (environment, read once at init): unset / 0 / off = no entry points at all (the
+ * kit #7 interpreter + AOT path: the same IR, the same instructions); 1 / on = the tier; lockstep = the tier checked against the
+ * interpreter on every trace run (the interpreter's result is kept).
+ */
+#ifndef __MONO_MINI_SHEPJIT_H__
+#define __MONO_MINI_SHEPJIT_H__
+
+#include "interp-internals.h"
+
+typedef struct SjTrace SjTrace;
+typedef ptrdiff_t (*SjFn) (InterpFrame *frame, unsigned char *locals, SjTrace *t);
+
+enum {
+	SJ_S_COUNTING = 0,   /* MINT_SJ_ENTRY counts hits */
+	SJ_S_QUEUED,         /* waiting for the compiler */
+	SJ_S_MONITOR,        /* compiled and published: the first runs are measured (how far each run gets) */
+	SJ_S_LIVE,           /* runs at full speed */
+	SJ_S_OFF_SHORT,      /* not compiled: too few opcodes before the first one the tier does not compile */
+	SJ_S_OFF_PENALTY,    /* switched off after monitoring: its runs left too early to pay (the 'not worth it' list) */
+	SJ_S_OFF_FULL,       /* not compiled: the code block is full */
+	SJ_S_OFF_LOCKSTEP,   /* lockstep mode: a run differed from the interpreter (logged) */
+	SJ_S_OFF_LEARNED,    /* the learning cache says: not worth it (a previous session's verdict) */
+	SJ_S_OFF_NOTHREAD,   /* (review fix) not compiled: the compiler thread could not be created (the tier switched itself off) */
+};
+
+enum { SJ_K_ENTRY = 0, SJ_K_LOOP, SJ_K_RESUME };
+
+struct SjTrace {
+	SjFn fn;                     /* what MINT_SJ_ENTER calls: sj_skip (go on interpreting) -> the monitor -> the code */
+	InterpMethod *imethod;
+	guint16 *ip;                 /* the entry point opcode in imethod->code */
+	volatile gint32 hits;        /* counted by MINT_SJ_ENTRY (racy: a heat estimate, never exact) */
+	volatile gint32 state;
+	guint16 kind, nops, abort_op, code_bytes;
+	guint32 order;               /* first-use order: the queue position */
+	guint32 full_slots;          /* IR slots from the entry point to the trace's last instruction (a run that gets there 'pays in full') */
+	gpointer code;               /* in the ForVM block (Thumb: fn = code | 1) */
+	char *name;                  /* the method, taken when queued (interpreter thread) */
+	guint32 mon_runs;            /* monitored runs (lockstep mode: the lockstep runs of this trace) */
+	guint64 mon_slots;           /* IR slots advanced by the monitored runs (each run counted at most full_slots) */
+	gint32 threshold;            /* hits before it is queued: SHEPHERD_JIT_THRESHOLD, or 1 for a trace the learning cache says is hot */
+	guint32 key;                 /* the learning cache's key: FNV-1a of the method's full name (0 = not computed) */
+	gint32 il_offset;            /* the entry point's basic block (IL offset: stable across runtime builds, unlike IR offsets) */
+	SjTrace *next_all;
+};
+
+/* SHEPHERD_JIT mode: 0 off, 1 on, 2 lockstep */
+extern int mono_shepjit_mode;
+extern gint32 mono_shepjit_threshold;
+
+void mono_shepjit_init (void);
+void mono_shepjit_insert_entry_points (InterpMethod *imethod, void *td);
+void mono_shepjit_queue (SjTrace *t);
+/* the host: the ForVM block it allocated before the arena (vita/shepherd/host.c), and the call that pins a latency-tolerant worker */
+MONO_API void mono_shepjit_set_block (int uid, void *base, guint32 size);
+MONO_API void mono_shepjit_set_pin (void (*pin) (const char *who));
+MONO_API int mono_shepjit_report (char *buf, int len);
+MONO_API void mono_shepjit_dump (void);
+
+#endif
