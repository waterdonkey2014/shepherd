diff --git a/src/mono/mono/mini/interp/shepjit-stencils.c b/src/mono/mono/mini/interp/shepjit-stencils.c
new file mode 100644
index 0000000..8d8b191
--- /dev/null
+++ b/src/mono/mono/mini/interp/shepjit-stencils.c
@@ -0,0 +1,67 @@
+/*
+ * shepjit-stencils.c: SHEPHERD-VITA device kit #8 (vita/notes/kit8-jit.md) -- the copy-and-patch STENCILS of the baseline JIT tier.
+ *
+ * NOT part of the runtime library. vita/toolchain/build-runtime-k8.sh compiles this file with interp.c's own compiler and flags (the
+ * same arm-vita-eabi-gcc 15.2, -O3 -ffp-contract=off -fwrapv -fno-strict-aliasing: the arithmetic is the interpreter's by construction)
+ * plus -mlong-calls -ffunction-sections -fno-unwind-tables, and vita/jit/stencils/gen-stencils.py turns the object into
+ * shepjit-stencils.inc (bytes + holes), which shepjit.c includes; the build fails if the regenerated file differs from the committed one.
+ *
+ * One stencil per opcode of SJ_OPS: the opcode's body from shepjit-ops.h -- the very text interp.c's main loop runs -- with the
+ * primitives below:
+ *   - operands are HOLES: a MOVW (16-bit slot) or MOVW+MOVT (32-bit / pointer) whose immediate the trace compiler fills in;
+ *   - SJ_NEXT is nothing: the stencil falls through (or tail-branches) to the next instruction's code;
+ *   - a taken branch tail-branches to the target's code (or to an exit stub when the target is outside the trace);
+ *   - every check that would THROW (null, range, divide, overflow, a class not yet initialised) and a pending SAFEPOINT leave the trace
+ *     AT this instruction, before it changed anything: the interpreter then runs the instruction itself -- and throws, initialises the
+ *     class or polls exactly as it would have.
+ * Calls to runtime functions (write barriers, memcpy / memmove / memset, fmod, the EABI division helpers) are long calls (MOVW/MOVT +
+ * BLX): the same functions the interpreter calls, at any distance from the code block (the console's probe: a direct BL was 38 MiB out of
+ * reach).
+ */
+#include "config.h"
+#include <string.h>
+#include <math.h>
+#include <glib.h>
+#include <mono/utils/mono-math.h>
+#include <mono/utils/mono-threads-coop.h>
+#include <mono/metadata/object-internals.h>
+#include <mono/metadata/gc-internals.h>
+#include "interp-internals.h"
+#include "mintops.h"
+
+/* A stencil takes the frame's locals only (r0, live from stencil to stencil through the tail calls): the opcode bodies need nothing else
+ * (no frame, no context), which leaves r1-r3 and ip free for them -- fewer spills. A trace starts with one MOV r0, r1 (the interpreter
+ * calls it as fn (frame, locals, trace)); its exits return how far it got, in r0. */
+typedef ptrdiff_t SjSt (unsigned char *locals);
+/* the three continuation holes: direct B.W (short calls), never long calls */
+extern SjSt _sj_continue __attribute__((short_call));
+extern SjSt _sj_taken __attribute__((short_call));
+extern SjSt _sj_exit __attribute__((short_call));
+#define SJ_MUSTTAIL __attribute__((musttail))
+#define SJ_EXIT() do { SJ_MUSTTAIL return _sj_exit (locals); } while (0)
+
+/* operand holes: the trace compiler patches the MOVW / MOVT immediates (vita/jit/stencils/gen-stencils.py names them by slot) */
+#define SJ_IP(n) ((guint16) __extension__ ({ guint32 _v; __asm__ ("movw %0, #:lower16:_sj_a" #n : "=r" (_v)); if (_v > 0xffff) __builtin_unreachable (); _v; }))
+#define SJ_IP32(n) ((int) __extension__ ({ guint32 _v; __asm__ ("movw %0, #:lower16:_sj_w" #n "\n\tmovt %0, #:upper16:_sj_w" #n : "=r" (_v)); _v; }))
+#define SJ_IP64(n) SJ_IP64_##n
+#define SJ_IP64_2 ((guint64) (guint32) SJ_IP32 (2) | ((guint64) (guint32) SJ_IP32 (4) << 32))   /* READ64 (ip + 2) = slots 2..5 */
+#define SJ_DATA(n) ((gpointer) __extension__ ({ guint32 _v; __asm__ ("movw %0, #:lower16:_sj_d" #n "\n\tmovt %0, #:upper16:_sj_d" #n : "=r" (_v)); _v; }))
+#define SJ_NEXT(len) do { } while (0)
+#define SJ_BRANCH(off) do { (void) (off); SJ_MUSTTAIL return _sj_taken (locals); } while (0)
+#define SJ_THROW_DIVIDE_BY_ZERO() SJ_EXIT ()
+#define SJ_THROW_OVERFLOW() SJ_EXIT ()
+#define SJ_THROW_INDEX_OUT_OF_RANGE() SJ_EXIT ()
+#define SJ_THROW_ARGUMENT_OUT_OF_RANGE_LENGTH() SJ_EXIT ()
+#define SJ_THROW_NULL_REFERENCE() SJ_EXIT ()
+#define NULL_CHECK(o) do { if (G_UNLIKELY (!(o))) SJ_EXIT (); } while (0)
+#define INIT_VTABLE(vtable) do { if (G_UNLIKELY (!(vtable)->initialized)) SJ_EXIT (); } while (0)
+#define SAFEPOINT do { if (G_UNLIKELY (mono_polling_required)) SJ_EXIT (); } while (0)
+#define BACK_BRANCH_PROFILE(offset)
+#define LOCAL_VAR(offset,type) (*(type*)(locals + (offset)))
+
+#include "shepjit-ops.h"
+
+#define SJ_STENCIL(op) \
+	SjSt sj_st_##op; \
+	ptrdiff_t sj_st_##op (unsigned char *locals) { SJOP_##op; SJ_MUSTTAIL return _sj_continue (locals); }
+SJ_OPS (SJ_STENCIL)
