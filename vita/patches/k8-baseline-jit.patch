+
+/* ------------------------------------------------------------------ the stencil table (generated) */
+typedef struct { guint16 off; guint8 kind; guint8 arg; } SjHole;
+enum { SJH_A16, SJH_W32_LO, SJH_W32_HI, SJH_DATA_LO, SJH_DATA_HI, SJH_CONT, SJH_TAKEN, SJH_EXIT, SJH_HELPER_LO, SJH_HELPER_HI };
+typedef struct { guint16 opcode; const guint8 *code; const SjHole *holes; guint16 len; guint16 nholes; guint8 falls; guint8 align4; } SjStencil;
+#include "shepjit-stencils.inc"
+
+/* the helpers the stencils call (long calls: their addresses go into MOVW/MOVT holes) -- every name gen-stencils.py found must be known
+ * here, or this file does not compile */
+extern void __aeabi_idiv (void);
+extern void __aeabi_uidiv (void);
+extern void __aeabi_idivmod (void);
+extern void __aeabi_uidivmod (void);
+extern void __aeabi_ldivmod (void);
+extern void __aeabi_uldivmod (void);
+extern void __aeabi_f2lz (void);
+extern void __aeabi_d2lz (void);
+extern void __aeabi_l2f (void);
+extern void __aeabi_l2d (void);
+extern void __aeabi_f2ulz (void);
+extern void __aeabi_d2ulz (void);
+#define SJ_HELPER_ADDR(name) (gpointer) &name,
+static gpointer const sj_helper_addr [SJ_HELPER_COUNT] = { SJ_HELPERS (SJ_HELPER_ADDR) };
+
+/* ------------------------------------------------------------------ the console's code memory (HENkaku ForVM) */
+#ifdef HOST_VITA
+extern int sceKernelOpenVMDomain (void);
+extern int sceKernelCloseVMDomain (void);
+extern int sceKernelSyncVMDomain (int uid, void *data, unsigned int size);
+#define SJ_OPEN() sceKernelOpenVMDomain ()
+#define SJ_CLOSE() sceKernelCloseVMDomain ()
+#define SJ_SYNC(p, n) sceKernelSyncVMDomain (sj_block_uid, (p), (n))
+#else
+#define SJ_OPEN() 0
+#define SJ_CLOSE() 0
+#define SJ_SYNC(p, n) (__builtin___clear_cache ((char *) (p), (char *) (p) + (n)), 0)
+#endif
+
+/* ------------------------------------------------------------------ configuration (environment, read once at init) */
+int mono_shepjit_mode;                       /* 0 off, 1 on, 2 lockstep */
+gint32 mono_shepjit_threshold = 200;         /* SHEPHERD_JIT_THRESHOLD: entry-point hits before a trace is queued */
+static int sj_min_ops = 4;                   /* SHEPHERD_JIT_MIN_OPS: shorter traces are not worth an entry point */
+static int sj_max_ops = 256;                 /* SHEPHERD_JIT_MAX_OPS */
+static int sj_batch_ms = 4;                  /* SHEPHERD_JIT_BATCH_MS: how long the compiler gathers requests before a window */
+static int sj_monitor_runs = 32;             /* SHEPHERD_JIT_MONITOR: runs measured before the keep / switch-off verdict (0 = none) */
+static int sj_min_slots = 12;                /* SHEPHERD_JIT_MIN_SLOTS: average IR slots a run must advance to stay on */
+static int sj_kinds = 7;                     /* SHEPHERD_JIT_KINDS: bit 0 method entry, 1 loop heads, 2 after calls */
+static const char *sj_off_reason = "SHEPHERD_JIT unset";
+static char *sj_learn_path;                  /* SHEPHERD_JIT_LEARN: the learning cache (default ux0:data/shepherd/cache/jit-learn.tsv; 0 = none) */
+
+static int sj_block_uid;
+static guint8 *sj_block;
+static guint32 sj_block_size, sj_block_used;  /* bump allocation (compiler thread) */
