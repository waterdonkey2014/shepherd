+ * bytes and interface ids are process-global, so every generic instance of the game pays for all the interfaces before it, whether or not any
+ * cast ever looks at it: 14 MiB of the load context's mempool on the walk, for ~33,000 classes of which ~10,000 ever get a vtable. With the row on
+ * (mono_vita_k14_set, MONO_VITA_K14_BITMAPS; default off here: the host turns it on) class setup keeps interfaces_packed + offsets as ever and
+ * leaves interface_bitmap NULL; a vtable's creation makes it (AOT code reads it through the vtable, or through the element class of an array
+ * object: object.c), and so does the first C read through this accessor. The bits are the same: one for each interface of interfaces_packed. */
+#define MONO_VITA_K14_BITMAPS 1u        /* bitmaps on first read */
+#define MONO_VITA_K14_INLHDR 4u         /* an inlined method's header freed at the end of the transform */
+#define MONO_VITA_K14_SEQNULL 8u        /* no seq_points table entry for a method without a table */
+#define MONO_VITA_K14_SORTED 16u        /* an AOT image's address -> method table without the addresses, as long as its compiled methods */
+#define MONO_VITA_K14_MEMPOOL 32u       /* a mempool request over 1 KiB that does not fit gets its own block (the chunk's tail stays in use) */
+#define MONO_VITA_K14_SLOTS 64u         /* eglib's hash table entries from slabs (no malloc header) */
+#define MONO_VITA_K14_SITES 128u        /* tier-up patch sites from slabs */
+#define MONO_VITA_K14_CARDS 2048u       /* sgen's card table only for [0x40000000, 0xC0000000): sgen/sgen-cardtable.c */
+#define MONO_VITA_K14_ISTACK 4096u      /* interpreter stacks: 1 MiB for the first thread, 256 KiB for the others */
+#define MONO_VITA_K14_BITMAP_AUDIT 256u /* test: every deferred bitmap also computed at class setup, kept aside and compared when it is made */
+#define MONO_VITA_K14_BITMAP_AUDIT_FAKE 512u /* test: the audit's negative control: one bit of each kept copy flipped */
+extern unsigned mono_vita_k14_flags;
+void mono_vita_k14_set (unsigned flags);
+guint8 *mono_vita_class_interface_bitmap_slow (MonoClass *klass);
+static inline guint8 *
+mono_vita_class_interface_bitmap (MonoClass *klass)
+{
