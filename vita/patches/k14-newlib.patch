+#ifdef HOST_VITA
+/* SHEPHERD-VITA device kit #14, track newlib (vita/notes/kit14-newlib.md): a table entry is 12 bytes in a 16-byte newlib chunk. The entries are private to
+ * this file: with the row on (MONO_VITA_K14_SLOTS: monoeg_k14_slots set before the runtime starts) they come from 64-KiB slabs at 12 bytes, a freed
+ * one waits for the next insert, and a slab never goes back. Off: g_new / g_free, as kit #13. An entry made before the row went on may end
+ * on the free list: it is a valid piece of memory, just never returned to malloc. */
+#include <pthread.h>
+int monoeg_k14_slots;
+static pthread_mutex_t k14_slot_lock = PTHREAD_MUTEX_INITIALIZER;
+static Slot *k14_slot_freed, *k14_slot_next, *k14_slot_end;
+#define K14_SLAB_SLOTS (65520 / sizeof (Slot))
+static Slot *
+k14_slot_new (void)
+{
+	Slot *s;
+	if (!monoeg_k14_slots)
+		return g_new (Slot, 1);
+	pthread_mutex_lock (&k14_slot_lock);
+	s = k14_slot_freed;
+	if (s) {
+		k14_slot_freed = s->next;
+	} else {
+		if (k14_slot_next == k14_slot_end) {
+			k14_slot_next = g_new (Slot, K14_SLAB_SLOTS);
+			k14_slot_end = k14_slot_next + K14_SLAB_SLOTS;
+		}
+		s = k14_slot_next++;
+	}
+	pthread_mutex_unlock (&k14_slot_lock);
+	return s;
+}
+static void
+k14_slot_free (Slot *s)
+{
+	if (!monoeg_k14_slots) {
+		g_free (s);
+		return;
+	}
+	pthread_mutex_lock (&k14_slot_lock);
+	s->next = k14_slot_freed;
+	k14_slot_freed = s;
+	pthread_mutex_unlock (&k14_slot_lock);
+}
+#else
+#define k14_slot_new() g_new (Slot, 1)
+#define k14_slot_free(s) g_free (s)
+#endif
