+/* ---- the hot callers' inline limit and the census (method-to-ir.c asks) ---- */
+static char *
+k10_mangle (MonoMethod *method)
+{
+	/* get_debug_sym's mangling, without its duplicate suffix */
+	char *n1 = mono_method_full_name (method, TRUE);
+	size_t len = strlen (n1), j = 0;
+	char *n2 = (char *) g_malloc (len + 16);
+	for (size_t i = 0; i < len; ++i) {
+		if (i == 0 && n1 [0] >= '0' && n1 [0] <= '9')
+			n2 [j++] = '_';
+		else if (isalnum (n1 [i]))
+			n2 [j++] = n1 [i];
+		else if (n1 [i] == ' ' && n1 [i + 1] == '(' && n1 [i + 2] == ')')
+			i += 2;
+		else if (n1 [i] == ',' && n1 [i + 1] == ' ') {
+			n2 [j++] = '_';
+			i++;
+		} else if (n1 [i] == '(' || n1 [i] == ')' || n1 [i] == '>') {
+		} else
+			n2 [j++] = '_';
+	}
+	n2 [j] = 0;
+	g_free (n1);
+	return n2;
+}
+
+/* for the method being compiled (cfg->method): 0 = not a hot method (or no list); > 0 = the inline limit of its direct callees;
+ * -1 = a hot method, the limit unchanged (SHEPHERD_AOT_HOT_INLINE_LIMIT=0: the census alone) */
+int
+mono_shepherd_k10_hot_inline_limit (MonoCompile *cfg)
+{
+	static MonoCompile *last_cfg;
+	static MonoMethod *last_method;
+	static int last_hot;
+	if (!k10_hotinl_read) {
+		k10_hotinl_read = 1;
+		const char *f = g_getenv ("SHEPHERD_AOT_HOT_INLINE");
+		if (f && *f) {
+			k10_hotinl = k9_read_lines (f, FALSE);
+			const char *l = g_getenv ("SHEPHERD_AOT_HOT_INLINE_LIMIT");
+			if (l && *l)
+				k10_hotinl_limit = atoi (l);
+			const char *c = g_getenv ("SHEPHERD_AOT_INLINE_CENSUS");
+			if (c && *c) {
+				k10_census = fopen (c, "a");
+				if (!k10_census) {
+					fprintf (stderr, "SHEPHERD kit #10: cannot write %s\n", c);
+					exit (1);
+				}
+			}
+		}
+	}
+	if (!k10_hotinl || !cfg || !cfg->compile_aot)
+		return 0;
+	if (cfg != last_cfg || cfg->method != last_method) {
+		last_cfg = cfg;
+		last_method = cfg->method;
+		char *m = k10_mangle (cfg->method);
+		last_hot = g_hash_table_lookup (k10_hotinl, m) != NULL;
+		if (!last_hot && llvm_acfg && llvm_acfg->assembly_name_sym) {
+			char *pm = g_strdup_printf ("%s_%s", llvm_acfg->assembly_name_sym, m);
+			last_hot = g_hash_table_lookup (k10_hotinl, pm) != NULL;
+			g_free (pm);
+		}
+		g_free (m);
+		if (last_hot)
+			k10_hotinl_hits++;
+	}
+	if (!last_hot)
+		return 0;
+	return k10_hotinl_limit > 0 ? k10_hotinl_limit : -1;
+}
+
+void
+mono_shepherd_k10_inline_census (MonoCompile *cfg, MonoMethod *callee, gboolean verdict, int limit)
+{
+	if (!k10_census || !cfg || cfg->inline_depth)
+		return;
+	MonoMethodHeaderSummary h;
+	gboolean hs = mono_method_get_header_summary (callee, &h);
+	MonoImage *ri = m_class_get_image (cfg->method->klass), *ci = m_class_get_image (callee->klass);
+	char *rn = mono_method_full_name (cfg->method, TRUE), *cn = mono_method_full_name (callee, TRUE);
+	fprintf (k10_census, "%s\t%s\t%s\t%s\t%d\t%d\t%d\t%d\t%d\t%d\t%s\n", ri && ri->assembly_name ? ri->assembly_name : "?", rn, ci && ci->assembly_name ? ci->assembly_name : "?",
+		 cn, hs ? (int) h.code_size : -1, hs ? (int) h.has_clauses : -1, limit, (callee->iflags & METHOD_IMPL_ATTRIBUTE_AGGRESSIVE_INLINING) ? 1 : 0,
+		 m_class_has_cctor (callee->klass) ? 1 : 0, (callee->iflags & METHOD_IMPL_ATTRIBUTE_NOINLINING) ? 1 : 0, verdict ? "inlined" : "refused");
+	g_free (rn);
+	g_free (cn);
+}
