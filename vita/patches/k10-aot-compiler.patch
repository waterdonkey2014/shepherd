+
+/*
+ * SHEPHERD-VITA device kit #10, track aot (vita/patches/k10-aot-compiler.patch, vita/notes/kit10-aot.md). Every addition is off unless
+ * its environment variable is set (the compiler's output is then the kit #9 compiler's, byte for byte -- vita/toolchain/check-cross-k9.sh):
+ *
+ * AOT THAT LEARNS FROM PLAY -- SHEPHERD_AOT_LEARNED=<file>[:<file>...]: the record of AOT misses (the runtime's aot-learn.tsv lines,
+ *   vita/patches/k10-aot-learn.patch, merged by vita/tools/k10_learn.py). A listed method of THIS image that the build would have left to
+ *   the interpreter is compiled: past the CoreLib keep list (SHEPHERD_AOT_KEEP) and into a profile-only image (the game-AOT app's owner
+ *   modules). A listed generic instance is compiled into the image that defines its generic definition, or -- an instance of a BCL
+ *   definition the defining image cannot name (its type arguments live in the game's assemblies) -- into SHEPHERD_AOT_LEARNED_IMAGE
+ *   (the runtime searches every image for an instance its defining image lacks: aot-runtime.c find_aot_method). Each instance is decoded
+ *   from the record's tokens and type arguments; one this compile cannot load is skipped and counted. Same IL, compiled: exact.
+ *
+ * HOT CODE FOR SPEED, COLD CODE FOR SIZE -- SHEPHERD_AOT_COLD=<file>: lines "<image><TAB><method token>" = the methods that RAN (the
+ *   first-call traces, the learning record); an LLVM-compiled method whose definition is not listed is cold and gets LLVM's optsize
+ *   attribute (SHEPHERD_AOT_COLD_MODE=minsize: optsize + minsize): smaller code, the same results (codegen choices only -- strict float,
+ *   no fast-math, as everywhere). Wrappers and methods without a token keep the speed level. SHEPHERD_AOT_COLD_HOT=1 = the other arm
+ *   of the A/B: EVERY method at the size level (hot ones too) -- each hot method built both ways. SHEPHERD_AOT_COLD_INLINE=<bytes of IL>:
+ *   a cold method's callees are inlined by Mono's IR inliner only below that size ([AggressiveInlining] included: CoreLib's Span / Vector
+ *   helpers are most of its text) -- every backend; inlining never changes what the code computes.
+ *
+ * WHOLE-PROGRAM INLINING, the nearest exact form (Mono's LLVM AOT cannot optimise images together -- per-image GOT and lazy per-method
+ *   GOT initialisation, cross-image calls only through the PLT: vita/notes/kit10-aot.md) -- SHEPHERD_AOT_HOT_INLINE=<file>: symbol names
+ *   of the profile's hot methods (the R5 order list); a listed method inlines its direct callees -- in any image, as Mono's IR inliner
+ *   already does across assemblies -- up to SHEPHERD_AOT_HOT_INLINE_LIMIT bytes of IL (default 60; Mono's own limit is 30 under LLVM,
+ *   20 otherwise); every other rule of the inliner stays (no clauses, no cctor to trigger, ...). SHEPHERD_AOT_INLINE_CENSUS=<file>: one
+ *   line per inlining decision made while compiling a hot method (root, callee, the callee's image, its IL size, the verdict) -- no
+ *   codegen change.
+ */
+#include <mono/metadata/class-init.h>
+static GHashTable *k10_learned;         /* desc -> 1 */
+static int k10_learned_read, k10_learned_added, k10_learned_kept, k10_learned_failed, k10_learned_profiled;
+static GHashTable *k10_cold_hot;        /* "image\ttoken" -> 1 (the methods that ran) */
+static int k10_cold_read, k10_cold_mode, k10_cold_all;   /* mode 0 off, 1 optsize, 2 minsize */
+static int k10_cold_n, k10_cold_hot_n, k10_cold_inl_n;
+static GHashTable *k10_hotinl;          /* symbol -> 1 */
+static int k10_hotinl_read, k10_hotinl_limit = 60, k10_hotinl_hits;
+static FILE *k10_census;
+
+/* the runtime's record encoding of a type (vita/patches/k10-aot-learn.patch k10_learn_type) */
+static void
+k10_enc_type (GString *s, MonoType *t, int depth)
+{
+	if (!t || depth > 12 || m_type_is_byref (t)) {
+		g_string_append_c (s, '?');
+		return;
+	}
+	switch (t->type) {
+	case MONO_TYPE_BOOLEAN: case MONO_TYPE_CHAR: case MONO_TYPE_I1: case MONO_TYPE_U1: case MONO_TYPE_I2: case MONO_TYPE_U2:
+	case MONO_TYPE_I4: case MONO_TYPE_U4: case MONO_TYPE_I8: case MONO_TYPE_U8: case MONO_TYPE_R4: case MONO_TYPE_R8:
+	case MONO_TYPE_STRING: case MONO_TYPE_OBJECT: case MONO_TYPE_I: case MONO_TYPE_U: case MONO_TYPE_TYPEDBYREF:
+		g_string_append_printf (s, "P%02x", t->type);
+		return;
+	case MONO_TYPE_CLASS: case MONO_TYPE_VALUETYPE: {
+		MonoClass *k = t->data.klass;
+		MonoImage *im = k ? m_class_get_image (k) : NULL;
+		if (!im || !im->assembly_name || mono_class_is_ginst (k) || mono_class_is_gtd (k)) {
+			g_string_append_c (s, '?');
+			return;
+		}
+		g_string_append_printf (s, "T%s!%08x", im->assembly_name, m_class_get_type_token (k));
+		return;
+	}
+	case MONO_TYPE_GENERICINST: {
+		MonoGenericClass *gc = t->data.generic_class;
+		MonoClass *def = gc ? gc->container_class : NULL;
+		MonoImage *im = def ? m_class_get_image (def) : NULL;
+		MonoGenericInst *gi = gc ? gc->context.class_inst : NULL;
+		if (!im || !im->assembly_name || !gi) {
+			g_string_append_c (s, '?');
+			return;
+		}
+		g_string_append_printf (s, "G%s!%08x<", im->assembly_name, m_class_get_type_token (def));
+		for (guint i = 0; i < gi->type_argc; i++) {
+			if (i)
+				g_string_append_c (s, ',');
+			k10_enc_type (s, gi->type_argv [i], depth + 1);
+		}
+		g_string_append_c (s, '>');
+		return;
+	}
+	case MONO_TYPE_SZARRAY:
+		g_string_append_c (s, 'Z');
+		k10_enc_type (s, m_class_get_byval_arg (t->data.klass), depth + 1);
+		return;
+	case MONO_TYPE_ARRAY:
+		g_string_append_printf (s, "A%d:", (int) t->data.array->rank);
+		k10_enc_type (s, m_class_get_byval_arg (t->data.array->eklass), depth + 1);
+		return;
+	case MONO_TYPE_PTR:
+		g_string_append_c (s, 'R');
+		k10_enc_type (s, t->data.type, depth + 1);
+		return;
+	default:
+		g_string_append_c (s, '?');
+		return;
+	}
+}
+
+static char *
+k10_method_desc (MonoMethod *method)
+{
+	MonoImage *im = m_class_get_image (method->klass);
+	if (!im || !im->assembly_name)
+		return NULL;
+	GString *s = g_string_new (NULL);
+	g_string_append_printf (s, "%s!%08x", im->assembly_name, mono_method_get_token (method));
+	if (method->is_inflated) {
+		MonoGenericContext *ctx = mono_method_get_context (method);
+		for (int k = 0; ctx && k < 2; ++k) {
+			MonoGenericInst *gi = k == 0 ? ctx->class_inst : ctx->method_inst;
+			if (!gi)
+				continue;
+			g_string_append_printf (s, "|%c<", k == 0 ? 'C' : 'M');
+			for (guint i = 0; i < gi->type_argc; i++) {
+				if (i)
+					g_string_append_c (s, ',');
+				k10_enc_type (s, gi->type_argv [i], 0);
+			}
+			g_string_append_c (s, '>');
+		}
+	}
+	return g_string_free (s, FALSE);
+}
+
+static void
+k10_learned_load (void)
+{
+	if (k10_learned_read)
+		return;
+	k10_learned_read = 1;
+	const char *f = g_getenv ("SHEPHERD_AOT_LEARNED");
+	if (!f || !*f)
+		return;
+	k10_learned = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, NULL);
+	char **fs = g_strsplit (f, ":", 0);
+	for (char **p = fs; *p; ++p) {
+		FILE *fp = fopen (*p, "r");
+		if (!fp) {
+			fprintf (stderr, "SHEPHERD kit #10: cannot read %s\n", *p);
+			exit (1);
+		}
+		char line [16384];
+		while (fgets (line, sizeof (line), fp)) {
+			if (line [0] == '#' || line [0] == '\n')
+				continue;
+			char **col = g_strsplit (line, "\t", 6);
+			if (col [0] && col [1] && col [2] && col [3] && !strchr (col [3], '?'))
+				g_hash_table_insert (k10_learned, g_strdup (col [3]), GINT_TO_POINTER (1));
+			g_strfreev (col);
+		}
+		fclose (fp);
+	}
+	g_strfreev (fs);
+}
+
+/* is this method (exactly: its definition token + generic arguments) in the learned list? */
+static gboolean
+k10_learned_method (MonoAotCompile *acfg, MonoMethod *method)
+{
+	k10_learned_load ();
+	if (!k10_learned || method->wrapper_type != MONO_WRAPPER_NONE || !mono_method_get_token (method))
+		return FALSE;
+	char *d = k10_method_desc (method);
+	gboolean r = d && g_hash_table_lookup (k10_learned, d) != NULL;
+	g_free (d);
+	return r;
+}
+
+/* ---- decoding a record back into a method of this compile ---- */
+static MonoImage *
+k10_image (const char *name)
+{
+	static GHashTable *cache;
+	if (!cache)
+		cache = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, NULL);
+	gpointer v;
+	if (g_hash_table_lookup_extended (cache, name, NULL, &v))
+		return (MonoImage *) v;
+	MonoImage *res = NULL;
+	MonoImageOpenStatus st = MONO_IMAGE_OK;
+	MonoAssembly *a = mono_assembly_load_with_partial_name_internal (name, mono_alc_get_default (), &st);   /* (MONO_PATH: the build's folders) */
+	if (a)
+		res = mono_assembly_get_image_internal (a);
+	g_hash_table_insert (cache, g_strdup (name), res);
+	return res;
+}
+
+static MonoType *k10_dec_type (const char **pp, int depth);
+
+static MonoClass *
+k10_dec_class (const char **pp)
+{
+	const char *p = *pp, *bang = strchr (p, '!');
+	if (!bang || strlen (bang + 1) < 8)
+		return NULL;
+	char *asmname = g_strndup (p, bang - p);
+	char tok [9];
+	memcpy (tok, bang + 1, 8);
+	tok [8] = 0;
+	*pp = bang + 9;
+	MonoImage *im = k10_image (asmname);
+	g_free (asmname);
+	if (!im)
+		return NULL;
+	ERROR_DECL (error);
+	MonoClass *k = mono_class_get_checked (im, (guint32) strtoul (tok, NULL, 16), error);
+	mono_error_cleanup (error);
+	return k;
+}
+
+static MonoGenericInst *
+k10_dec_inst (const char **pp, int depth)
+{
+	/* at '<': types up to the matching '>' */
+	if (**pp != '<')
+		return NULL;
+	(*pp)++;
+	MonoType *args [64];
+	int n = 0;
+	while (**pp && **pp != '>') {
+		if (n == 64)
+			return NULL;
+		MonoType *t = k10_dec_type (pp, depth + 1);
+		if (!t)
+			return NULL;
+		args [n++] = t;
+		if (**pp == ',')
+			(*pp)++;
+	}
+	if (**pp != '>' || !n)
+		return NULL;
+	(*pp)++;
+	return mono_metadata_get_generic_inst (n, args);
+}
+
+static MonoType *
+k10_dec_type (const char **pp, int depth)
+{
+	if (depth > 12)
+		return NULL;
+	const char *p = *pp;
+	switch (*p) {
+	case 'P': {
+		char h [3] = { p [1], p [1] ? p [2] : 0, 0 };
+		*pp = p + 3;
+		MonoClass *k = NULL;
+		switch (strtoul (h, NULL, 16)) {
+		case MONO_TYPE_BOOLEAN: k = mono_defaults.boolean_class; break;
+		case MONO_TYPE_CHAR: k = mono_defaults.char_class; break;
+		case MONO_TYPE_I1: k = mono_defaults.sbyte_class; break;
+		case MONO_TYPE_U1: k = mono_defaults.byte_class; break;
+		case MONO_TYPE_I2: k = mono_defaults.int16_class; break;
+		case MONO_TYPE_U2: k = mono_defaults.uint16_class; break;
+		case MONO_TYPE_I4: k = mono_defaults.int32_class; break;
+		case MONO_TYPE_U4: k = mono_defaults.uint32_class; break;
+		case MONO_TYPE_I8: k = mono_defaults.int64_class; break;
+		case MONO_TYPE_U8: k = mono_defaults.uint64_class; break;
+		case MONO_TYPE_R4: k = mono_defaults.single_class; break;
+		case MONO_TYPE_R8: k = mono_defaults.double_class; break;
+		case MONO_TYPE_STRING: k = mono_defaults.string_class; break;
+		case MONO_TYPE_OBJECT: k = mono_defaults.object_class; break;
+		case MONO_TYPE_I: k = mono_defaults.int_class; break;
+		case MONO_TYPE_U: k = mono_defaults.uint_class; break;
+		case MONO_TYPE_TYPEDBYREF: k = mono_defaults.typed_reference_class; break;
+		}
+		return k ? m_class_get_byval_arg (k) : NULL;
+	}
+	case 'T': {
+		*pp = p + 1;
+		MonoClass *k = k10_dec_class (pp);
+		return k ? m_class_get_byval_arg (k) : NULL;
+	}
+	case 'G': {
+		*pp = p + 1;
+		MonoClass *gtd = k10_dec_class (pp);
+		MonoGenericInst *gi = k10_dec_inst (pp, depth);
+		if (!gtd || !gi || !mono_class_is_gtd (gtd))
+			return NULL;
+		MonoGenericClass *gc = mono_metadata_lookup_generic_class (gtd, gi, FALSE);
+		MonoClass *k = gc ? mono_class_create_generic_inst (gc) : NULL;
+		return k ? m_class_get_byval_arg (k) : NULL;
+	}
+	case 'Z': {
+		*pp = p + 1;
+		MonoType *e = k10_dec_type (pp, depth + 1);
+		return e ? m_class_get_byval_arg (mono_class_create_array (mono_class_from_mono_type_internal (e), 1)) : NULL;
+	}
+	case 'A': {
+		char *colon = strchr (p, ':');
+		if (!colon)
+			return NULL;
+		int rank = atoi (p + 1);
+		*pp = colon + 1;
+		MonoType *e = k10_dec_type (pp, depth + 1);
+		return e && rank > 0 ? m_class_get_byval_arg (mono_class_create_bounded_array (mono_class_from_mono_type_internal (e), rank, TRUE)) : NULL;
+	}
+	case 'R': {
+		*pp = p + 1;
+		MonoType *e = k10_dec_type (pp, depth + 1);
+		return e ? m_class_get_byval_arg (mono_class_create_ptr (e)) : NULL;
+	}
+	default:
+		return NULL;
+	}
+}
+
+static MonoMethod *
+k10_dec_method (const char *desc)
+{
+	const char *p = desc, *bang = strchr (p, '!');
+	if (!bang || strlen (bang + 1) < 8)
+		return NULL;
+	char *asmname = g_strndup (p, bang - p);
+	char tok [9];
+	memcpy (tok, bang + 1, 8);
+	tok [8] = 0;
+	p = bang + 9;
+	MonoImage *im = k10_image (asmname);
+	g_free (asmname);
+	if (!im)
+		return NULL;
+	ERROR_DECL (error);
+	MonoMethod *def = mono_get_method_checked (im, (guint32) strtoul (tok, NULL, 16), NULL, NULL, error);
+	if (!def) {
+		mono_error_cleanup (error);
+		return NULL;
+	}
+	MonoGenericContext ctx = { NULL, NULL };
+	while (*p == '|') {
+		char which = p [1];
+		p += 2;
+		MonoGenericInst *gi = k10_dec_inst (&p, 0);
+		if (!gi)
+			return NULL;
+		if (which == 'C')
+			ctx.class_inst = gi;
+		else if (which == 'M')
+			ctx.method_inst = gi;
+		else
+			return NULL;
+	}
+	if (*p)
+		return NULL;
+	if (!ctx.class_inst && !ctx.method_inst)
+		return def;
+	MonoMethod *m = mono_class_inflate_generic_method_checked (def, &ctx, error);
+	if (!is_ok (error)) {
+		mono_error_cleanup (error);
+		return NULL;
+	}
+	return m;
 }
 
+static gboolean
+k10_bcl_image (const char *n)
+{
+	return !strcmp (n, "System.Private.CoreLib") || !strcmp (n, "System") || !strcmp (n, "mscorlib") || !strcmp (n, "netstandard") ||
+		g_str_has_prefix (n, "System.") || g_str_has_prefix (n, "Microsoft.");
+}
+
+/* after the profile's instances: the learned generic instances this image compiles (its own definitions; BCL definitions into the
+ * designated image) and the learned methods of a profile-only image put into its profile */
 static void
+k10_add_learned (MonoAotCompile *acfg)
+{
+	k10_learned_load ();
+	if (!k10_learned)
+		return;
+	const char *self = acfg->image->assembly_name;
+	const char *designated = g_getenv ("SHEPHERD_AOT_LEARNED_IMAGE");
+	gboolean is_designated = designated && !strcmp (designated, self);
+	size_t sl = strlen (self);
+	GHashTableIter it;
+	gpointer key, val;
+	g_hash_table_iter_init (&it, k10_learned);
+	while (g_hash_table_iter_next (&it, &key, &val)) {
+		const char *d = (const char *) key;
+		const char *bang = strchr (d, '!');
+		if (!bang)
+			continue;
+		gboolean mine = (size_t) (bang - d) == sl && !strncmp (d, self, sl);
+		gboolean inflated = strchr (d, '|') != NULL;
+		if (!inflated) {
+			if (mine && acfg->aot_opts.profile_only) {   /* a profile-only image's method: into its profile (compile_method keeps it) */
+				MonoMethod *m = k10_dec_method (d);
+				if (m) {
+					g_hash_table_insert (acfg->profile_methods, m, m);
+					k10_learned_profiled++;
+				} else
+					k10_learned_failed++;
+			}
+			continue;
+		}
+		char *defimg = g_strndup (d, bang - d);
+		gboolean take = mine || (is_designated && k10_bcl_image (defimg));
+		g_free (defimg);
+		if (!take)
+			continue;
+		MonoMethod *m = k10_dec_method (d);
+		if (!m || mono_class_is_open_constructed_type (m_class_get_byval_arg (m->klass)) || (m->is_generic && !m->is_inflated)) {
+			if (mine)
+				k10_learned_failed++;   /* (an instance of a BCL definition the defining image cannot name is the designated image's) */
+			continue;
+		}
+		gboolean sharable = mono_method_is_generic_sharable_full (m, TRUE, FALSE, FALSE);
+		if (sharable && !mine)
+			continue;   /* (a shared instance is looked up in its defining image only: no use in the designated image) */
+		if (acfg->aot_opts.profile_only)
+			g_hash_table_insert (acfg->profile_methods, m, m);
+		/* what the runtime looks up (aot-runtime.c mono_aot_get_method): an instance over reference types is looked up ONLY as its shared
+		 * (System.__Canon) form, in the defining image -- compile that (add_extra_method_full puts it in the profile too); a value-type
+		 * instance is looked up concretely first (find_aot_method, every image) -- compile the concrete one, not its gsharedvt form */
+		if (sharable)
+			add_extra_method_full (acfg, m, TRUE, 0);
+		else
+			add_extra_method_full (acfg, m, FALSE, 0);
+		k10_learned_added++;
+	}
+}
+
+/* ---- cold code for size (mini-llvm.c asks per method) ---- */
+int
+mono_shepherd_k10_cold_mode (void)
+{
+	if (!k10_cold_read) {
+		k10_cold_read = 1;
+		const char *f = g_getenv ("SHEPHERD_AOT_COLD");
+		if (f && *f) {
+			k10_cold_hot = k9_read_lines (f, FALSE);
+			const char *m = g_getenv ("SHEPHERD_AOT_COLD_MODE");
+			k10_cold_mode = m && !strcmp (m, "minsize") ? 2 : 1;
+			k10_cold_all = g_getenv ("SHEPHERD_AOT_COLD_HOT") && !strcmp (g_getenv ("SHEPHERD_AOT_COLD_HOT"), "1");
+		}
+	}
+	return k10_cold_mode;
+}
+
+gboolean
+mono_shepherd_k10_is_cold (MonoMethod *method)
+{
+	if (!mono_shepherd_k10_cold_mode () || !method || method->wrapper_type != MONO_WRAPPER_NONE || !mono_method_get_token (method))
+		return FALSE;
+	MonoImage *im = m_class_get_image (method->klass);
+	if (!im || !im->assembly_name)
+		return FALSE;
+	char key [600];
+	snprintf (key, sizeof (key), "%s\t%08x", im->assembly_name, mono_method_get_token (method));
+	gboolean hot = g_hash_table_lookup (k10_cold_hot, key) != NULL;
+	if (hot)
+		k10_cold_hot_n++;
+	if (hot && !k10_cold_all)
+		return FALSE;
+	k10_cold_n++;
+	return TRUE;
+}
+
+/* the cold check without counting (the inliner asks for every callee) */
+static gboolean
+k10_cold_check (MonoMethod *method)
+{
+	if (!mono_shepherd_k10_cold_mode () || !method || method->wrapper_type != MONO_WRAPPER_NONE || !mono_method_get_token (method))
+		return FALSE;
+	MonoImage *im = m_class_get_image (method->klass);
+	if (!im || !im->assembly_name)
+		return FALSE;
+	if (k10_cold_all)
+		return TRUE;
+	char key [600];
+	snprintf (key, sizeof (key), "%s\t%08x", im->assembly_name, mono_method_get_token (method));
+	return g_hash_table_lookup (k10_cold_hot, key) == NULL;
+}
+
+/* SHEPHERD_AOT_COLD_INLINE=<bytes of IL>: a cold method's callees are inlined only below that size ([AggressiveInlining] ones too);
+ * -1 = no cap (unset, or not a cold method). Inlining never changes what code computes: this only keeps cold code small. */
+int
+mono_shepherd_k10_cold_inline_limit (MonoCompile *cfg)
+{
+	static MonoCompile *last_cfg;
+	static MonoMethod *last_method;
+	static int last_limit = -1, cap = -2;
+	if (cap == -2) {
+		const char *c = g_getenv ("SHEPHERD_AOT_COLD_INLINE");
+		cap = c && *c ? atoi (c) : -1;
+	}
+	if (cap < 0 || !cfg || !cfg->compile_aot || !mono_shepherd_k10_cold_mode ())
+		return -1;
+	if (cfg != last_cfg || cfg->method != last_method) {
+		last_cfg = cfg;
+		last_method = cfg->method;
+		last_limit = k10_cold_check (cfg->method) ? cap : -1;
+		if (last_limit >= 0)
+			k10_cold_inl_n++;
+	}
+	return last_limit;
+}
