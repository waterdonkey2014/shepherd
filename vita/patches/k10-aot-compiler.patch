+void
+mono_shepherd_k10_cold_note (void)
+{
+	if (k10_cold_mode)
+		printf ("SHEPHERD kit #10 cold: %d LLVM methods at the size level (%s%s), %d of the methods that ran met; %d cold methods compiled with the inline cap SHEPHERD_AOT_COLD_INLINE (SHEPHERD_AOT_COLD, %d entries)\n", k10_cold_n,
+			k10_cold_mode == 2 ? "optsize + minsize" : "optsize", k10_cold_all ? "; SHEPHERD_AOT_COLD_HOT=1: the hot ones too" : "", k10_cold_hot_n, k10_cold_inl_n,
+			k10_cold_hot ? (int) g_hash_table_size (k10_cold_hot) : 0);
+}
