+// Shepherd P1: the body rule of a pair. Stock: b2Body::ShouldCollide (at least one dynamic body; joints' collideConnected).
+// With b2_unityKinematicTriggers a pair with a sensor needs one non-static body instead (Unity's kinematic triggers); joints'
+// collideConnected is kept. Solid pairs keep the stock rule either way.
+bool b2ContactManager::UnityShouldCollide(b2Fixture* fixtureA, b2Fixture* fixtureB)
+{
+	b2Body* bodyA = fixtureA->GetBody();
+	b2Body* bodyB = fixtureB->GetBody();
+	if (b2_unityKinematicTriggers && (fixtureA->IsSensor() || fixtureB->IsSensor()))
+	{
+		if (bodyA->GetType() == b2_staticBody && bodyB->GetType() == b2_staticBody)
+		{
+			return false;
+		}
+		for (b2JointEdge* jn = bodyB->GetJointList(); jn; jn = jn->next)
+		{
+			if (jn->other == bodyA && jn->joint->GetCollideConnected() == false)
+			{
+				return false;
+			}
+		}
+		return true;
+	}
+	return bodyB->ShouldCollide(bodyA);
+}
