+// Shepherd P1: the final trigger pass (Unity's TriggerContactsFinalUpdate), called by b2World::Step after Solve / SolveTOI when
+// b2_unityTriggerPhase is set: after SynchronizeFixtures, so it sees post-step poses and the contacts FindNewContacts created at the end
+// of this step's solve. The same awake rule as Collide (a pair is updated when one body is awake and not static).
+void b2ContactManager::UpdateTriggers()
+{
+	for (b2Contact* c = m_contactList; c; c = c->GetNext())
+	{
+		b2Fixture* fixtureA = c->GetFixtureA();
+		b2Fixture* fixtureB = c->GetFixtureB();
+		if (fixtureA->IsSensor() == false && fixtureB->IsSensor() == false)
+		{
+			continue;
+		}
+		b2Body* bodyA = fixtureA->GetBody();
+		b2Body* bodyB = fixtureB->GetBody();
+		bool activeA = bodyA->IsAwake() && bodyA->GetType() != b2_staticBody;
+		bool activeB = bodyB->IsAwake() && bodyB->GetType() != b2_staticBody;
+		if (activeA == false && activeB == false)
+		{
+			continue;
+		}
+		c->UpdateSensor(m_contactListener);
+	}
+}
