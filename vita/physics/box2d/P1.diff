+// Shepherd P1: the sensor half of b2Contact::Update, run by b2ContactManager::UpdateTriggers on post-solve transforms (Unity's
+// TriggerContactsFinalUpdate). The same overlap test and the same Begin / End rule as the stock sensor branch above.
+void b2Contact::UpdateSensor(b2ContactListener* listener)
+{
+	m_flags |= e_enabledFlag;
+	bool wasTouching = (m_flags & e_touchingFlag) == e_touchingFlag;
+	b2Body* bodyA = m_fixtureA->GetBody();
+	b2Body* bodyB = m_fixtureB->GetBody();
+	bool touching = b2TestOverlap(m_fixtureA->GetShape(), m_indexA, m_fixtureB->GetShape(), m_indexB, bodyA->GetTransform(), bodyB->GetTransform());
+	m_manifold.pointCount = 0;
+	if (touching)
+	{
+		m_flags |= e_touchingFlag;
+	}
+	else
+	{
+		m_flags &= ~e_touchingFlag;
+	}
+	if (wasTouching == false && touching == true && listener)
+	{
+		listener->BeginContact(this);
+	}
+	if (wasTouching == true && touching == false && listener)
+	{
+		listener->EndContact(this);
+	}
+}
