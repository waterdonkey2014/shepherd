diff -ruN a/engine/Shepherd.Engine/Diag/BootPhase.cs b/engine/Shepherd.Engine/Diag/BootPhase.cs
--- a/engine/Shepherd.Engine/Diag/BootPhase.cs
+++ b/engine/Shepherd.Engine/Diag/BootPhase.cs
@@ -0,0 +1,63 @@
+using System.Runtime.CompilerServices;
+using System.Runtime.InteropServices;
+namespace Shepherd.Engine.Diag;
+
+/// <summary>DIAG-ONLY (vita/shepherd/diag/engine-diag.patch: compiled only into "Shepherd Menu Diag", SHPD00016; never in a normal
+/// build). Boot-phase markers: each phase is marked BEFORE it starts, three ways, so a hang or crash anywhere names the phase:
+/// (1) the text goes into a host-owned buffer (SHEPHERD_DIAG_PHASE_BUF=&lt;hex address&gt;:&lt;capacity&gt;; plain stores, no native call), which
+/// the host's heartbeat thread reads every second; (2) a P/Invoke (int argument only, no marshalling) makes the host log it at once;
+/// (3) once engine.log is open, a "[phase]" line there. The frame counter goes into the same buffer every frame (stores only).</summary>
+public static unsafe class BootPhase
+{
+    static readonly byte* Buf;   // [0] int seq, [4] int frame, [8] int text length, [12..] text (ASCII, NUL-terminated)
+    static readonly int Cap;
+    static readonly bool Host = Environment.GetEnvironmentVariable("SHEPHERD_VITA_HOST") == "1";
+    static int _seq;
+
+    static BootPhase()
+    {
+        var b = Environment.GetEnvironmentVariable("SHEPHERD_DIAG_PHASE_BUF");
+        if (b == null) return;
+        int colon = b.IndexOf(':');
+        if (colon <= 0) return;
+        ulong a = 0;
+        for (int i = 0; i < colon; i++)
+        {
+            int c = b[i], d = c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : c >= 'A' && c <= 'F' ? c - 'A' + 10 : -1;
+            if (d < 0) return;
+            a = a * 16 + (ulong)d;
+        }
+        if (!int.TryParse(b.AsSpan(colon + 1), out int cap) || cap < 64) return;
+        Buf = (byte*)(nuint)a; Cap = cap;
+    }
+
+    /// <summary>Marks the start of a phase (call it BEFORE the phase's first statement).</summary>
+    [MethodImpl(MethodImplOptions.NoInlining)]
+    public static void Mark(string name)
+    {
+        int seq = ++_seq;
+        if (Buf != null)
+        {
+            int n = Math.Min(name.Length, Cap - 13);
+            for (int i = 0; i < n; i++) { char ch = name[i]; Buf[12 + i] = (byte)(ch >= 32 && ch < 127 ? ch : '?'); }
+            Buf[12 + n] = 0;
+            *(int*)(Buf + 8) = n;
+            Volatile.Write(ref *(int*)Buf, seq);
+        }
+        if (Host) HostPhase(seq);
+        if (Log.IsOpen) Log.Info($"[phase] #{seq} {name}");
+    }
+
+    /// <summary>Every frame: the frame number into the host buffer (no call); a phase line at frames 1-3, 5, 10, 25, 50 and every 100th.</summary>
+    public static void Frame(int f)
+    {
+        if (Buf != null) Volatile.Write(ref *(int*)(Buf + 4), f);
+        if (f is 1 or 2 or 3 or 5 or 10 or 25 or 50 || f % 100 == 0) Mark("frame " + f);
+    }
+
+    [MethodImpl(MethodImplOptions.NoInlining)]
+    static void HostPhase(int seq) => shepherd_vita_diag_phase(seq);
+
+    [DllImport("__Internal")]
+    static extern void shepherd_vita_diag_phase(int seq);
+}
