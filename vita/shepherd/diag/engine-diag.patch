@@ -3,15 +3,23 @@
 public static class Log
 {
     static readonly object Gate = new();
-    static StreamWriter _file;
+    static string _path;   // DIAG (engine-diag.patch): no long-lived writer; every line is opened, appended and closed
     public static int Errors, Warnings, Exceptions;
     public static bool Echo = true;
     static readonly Dictionary<string, int> Seen = new();
-    public static void Open(string path) { Directory.CreateDirectory(Path.GetDirectoryName(path)); _file = new StreamWriter(path, false) { AutoFlush = true }; }
+    public static bool IsOpen => _path != null;
+    public static void Open(string path) { Directory.CreateDirectory(Path.GetDirectoryName(path)); File.WriteAllText(path, ""); _path = path; }
+    /// <summary>DIAG: open + append + close per line, so a hang, a crash or a killed app keeps every line already written.</summary>
+    static void AppendLine(string line)
+    {
+        var bytes = System.Text.Encoding.UTF8.GetBytes(line + "\n");
+        using var fs = new FileStream(_path, FileMode.Append, FileAccess.Write, FileShare.ReadWrite, 1, FileOptions.None);
+        fs.Write(bytes, 0, bytes.Length);
+    }
     public static void Write(string tag, string msg)
     {
         var line = $"[{Runtime.Time.FrameCount,5}] {tag} {msg}";
-        lock (Gate) { _file?.WriteLine(line); if (Echo) Console.WriteLine(line.Length > 400 ? line[..400] + "…" : line); }
+        lock (Gate) { if (_path != null) AppendLine(line); if (Echo) Console.WriteLine(line.Length > 400 ? line[..400] + "…" : line); }
     }
     public static void Info(string m) => Write("   ", m);
     public static void Warn(string m) { Warnings++; Write("WRN", m); }
