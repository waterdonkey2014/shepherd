 #ifndef DISABLE_JIT
+
+/*
+ * SHEPHERD-VITA kit #5 review fix A (vita/llvm/fork-eh-vfp.patch): the saved d0-d15 sit right above the WHOLE param area, at
+ * sp + param_size. Stock code passes sp + 8, which is right only when the param area is 8 bytes (corlib / resume_unwind); the
+ * managed throw / rethrow trampolines pad it to 16 bytes (cfa_offset + 12 aligned to 8), so ctx->fregs [i] read d(i-1) and
+ * restore_context handed the catching frame shifted d-registers. Only LLVM code keeps values in the callee-saved d8-d15 across
+ * calls (Mono's ARM backend never does), so only LLVM frames saw it. In a full-AOT build these trampolines are emitted by the AOT
+ * compiler into CoreLib's image (the runtime is DISABLE_JIT): CoreLib must be recompiled. SHEPHERD_EH_VFP_FIX=0 in the compiler's
+ * environment = the stock offset (the kit #4 compiler's output).
+ */
+static int shp_eh_vfp_fix_mode = -1;
+
+static int
+shp_eh_vfp_fp_regs_offset (int param_size)
+{
+	if (shp_eh_vfp_fix_mode < 0) {
+		char *v = g_getenv ("SHEPHERD_EH_VFP_FIX");
+		shp_eh_vfp_fix_mode = (v && !strcmp (v, "0")) ? 0 : 1;
+		g_free (v);
+	}
+	return shp_eh_vfp_fix_mode ? param_size : 8;
+}
 
