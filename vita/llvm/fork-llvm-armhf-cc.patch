+static int
+shp_armhf_callconv (EmitContext *ctx, MonoMethodSignature *sig, LLVMCallInfo *linfo, gboolean has_extra_arg, const char *what, MonoMethod *callee, gboolean *swifterror)
+{
+	*swifterror = FALSE;
+	if (shp_armhf_cc_mode < 0) {
+		char *v = g_getenv ("SHEPHERD_LLVM_ARMHF_CC");
+		char *l = g_getenv ("SHEPHERD_LLVM_ARMHF_CC_LOG");
+		shp_armhf_cc_mode = (v && !strcmp (v, "0")) ? 0 : 1;
+		shp_armhf_cc_log = (l && strcmp (l, "0")) ? 1 : 0;
+		g_free (v);
+		g_free (l);
+	}
+	if (!shp_armhf_cc_mode)
+		return LLVMMono1CallConv;
+
+	const char *why = NULL;
+	gboolean has_fp = FALSE;
+	guint fpr = 0;
+	gint spare = -1;
+	for (int i = sig->hasthis; i < sig->hasthis + sig->param_count; ++i) {
+		LLVMArgInfo *ainfo = &linfo->args [i];
+		if (ainfo->storage == LLVMArgAsFpArgs) {
+			has_fp = TRUE;
+			why = "armhf: HFA argument (kit5 float-argument ABI)";
+			break;
+		}
+		if (ainfo->storage != LLVMArgNormal || !ainfo->type || m_type_is_byref (ainfo->type))
+			continue;
+		MonoType *t = mini_get_underlying_type (ainfo->type);
+		if (t->type != MONO_TYPE_R4 && t->type != MONO_TYPE_R8)
+			continue;
+		has_fp = TRUE;
+		/* mini-arm.c add_float, register part */
+		if (t->type == MONO_TYPE_R8) {
+			if (fpr >= 16) {
+				why = "armhf: double argument on the stack (kit5 float-argument ABI)";
+				break;
+			}
+			if (fpr % 2) {
+				spare = fpr;
+				fpr ++;
+			}
+			if (fpr + 2 > 16) {
+				why = "armhf: double argument past d7 (kit5 float-argument ABI)";
+				break;
+			}
+			fpr += 2;
+		} else if (spare >= 0) {
+			spare = -1;
+		} else if (fpr < 16) {
+			fpr ++;
+		} else {
+			why = "armhf: float argument on the stack (kit5 float-argument ABI)";
+			break;
+		}
+	}
+	if (!has_fp)
+		return LLVMMono1CallConv;
