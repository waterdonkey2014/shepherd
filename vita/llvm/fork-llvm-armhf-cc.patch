+		if (!sig->pinvoke)
+			*swifterror = TRUE;
+		else if (has_extra_arg)
+			why = "armhf: pinvoke-flagged float-argument definition with an rgctx (kit5 float-argument ABI)";
+	}
+	if (shp_armhf_cc_log) {
+		char *m = mono_method_full_name (ctx->cfg->method, TRUE);
+		char *c = callee ? mono_method_full_name (callee, TRUE) : mono_signature_get_desc (sig, FALSE);
+		fprintf (stderr, "SHP-ARMHF-CC %s %s | %s | %s%s%s\n", why ? "refuse" : *swifterror ? (has_extra_arg ? "c-r8" : "c-se") : "c", what, m, c, why ? " | " : "", why ? why : "");
+		g_free (m);
+		g_free (c);
+	}
+	return why ? -1 : LLVMCCallConv;
 }
