+static LLVMTypeRef
+shp_add_trailing_ptr (EmitContext *ctx, LLVMTypeRef ftype)
+{
+	int n = LLVMCountParamTypes (ftype);
+	LLVMTypeRef *p = g_newa (LLVMTypeRef, n + 1);
+	LLVMGetParamTypes (ftype, p);
